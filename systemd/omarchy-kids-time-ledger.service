[Unit]
Description=Omarchy Kids Mode screen-time ledger tick (R-TIME-1)
Documentation=https://github.com/markcuda/omarchy-kids-mode/blob/main/docs/time.md

[Service]
Type=oneshot
ExecStart=/usr/bin/omarchy-kids-time-ledger tick
# Talks to systemd-logind over D-Bus (loginctl) and writes the ledger
# under /var/lib/omarchy-kids and the status file under
# /run/omarchy-kids (R-BAR-3) -- everything else is locked down the
# same way omarchy-kids-authd.service is. ProtectHome=yes is
# deliberately NOT set (same reasoning as omarchy-kids-ask-collect.
# service): tick also reads every kid's own $XDG_RUNTIME_DIR
# (/run/user/<uid>/omarchy-kids/launches.log, lib/data.sh's
# data_fold_launches) and systemd's own docs say ProtectHome=yes hides
# /run/user/* from the unit too, which silently drops every launch.
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/omarchy-kids /run/omarchy-kids
