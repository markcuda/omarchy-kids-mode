[Unit]
Description=Collect and apply queued Omarchy Kids Mode "ask a parent" requests every minute (SPEC.md R-ASK-1)
Documentation=https://github.com/markcuda/omarchy-kids-mode/blob/main/docs/ask.md

[Timer]
OnBootSec=1min
OnUnitActiveSec=1min
Unit=omarchy-kids-ask-collect.service
AccuracySec=5s

[Install]
WantedBy=timers.target
