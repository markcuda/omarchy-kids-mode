[Unit]
Description=Remove the per-boot Kids Mode SDDM autologin drop-in (R-BOOT-3)
Documentation=https://github.com/markcuda/omarchy-kids-mode/blob/main/docs/boot.md
After=display-manager.service

[Service]
Type=oneshot
# SDDM reads conf.d once, when this boot's greeter starts, a few seconds after
# display-manager.service; the drop-in must outlive that read and nothing else,
# so a later logout (which restarts the greeter) never re-autologs anyone.
# 20 s is margin over the slowest boot-to-greeter seen in the QEMU VM.
ExecStartPre=/bin/sleep 20
ExecStart=-/usr/bin/omarchy-kids-boot-login --cleanup

[Install]
WantedBy=multi-user.target
