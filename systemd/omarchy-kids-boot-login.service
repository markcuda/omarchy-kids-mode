[Unit]
Description=Select the per-boot Kids Mode SDDM login when disk mode recorded a slot
Documentation=https://github.com/markcuda/omarchy-kids-mode/blob/main/docs/boot.md
After=local-fs.target
Before=display-manager.service
# The command owns fail-safe input handling. Its failure must never hold SDDM.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=-/usr/bin/omarchy-kids-boot-login

[Install]
WantedBy=multi-user.target
