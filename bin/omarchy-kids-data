#!/bin/bash
# omarchy:summary=Show or prune what Kids Mode has recorded about a kid
# omarchy:args=<launches|sites|summary|mine|retention> <kid> [args]
# Recorded data and transparency: launches, sites, summary, mine, retention (SPEC.md R-DATA-1..5, I-2, I-6).
# Read-only except retention, which prunes. See docs/data.md for what's recorded, where, and for how long.
set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
LIB="$DIR/lib"
[[ -f "$LIB/time.sh" ]] || LIB=/usr/lib/omarchy-kids
# shellcheck source=lib/kids.sh
source "$LIB/kids.sh"
CONF_BIN="$(kids_bin conf "$DIR")"
# shellcheck source=lib/time.sh
source "$LIB/time.sh"
# shellcheck source=lib/data.sh
source "$LIB/data.sh"

ETC="${OMARCHY_KIDS_ETC:-/etc/omarchy-kids}"
KIDS_DIR="$ETC/kids"
TIME_SYSROOT="$DATA_SYSROOT"
TIME_VARLIB="$DATA_VARLIB"

die() {
  echo "omarchy-kids-data: $1" >&2
  exit "${2:-2}"
}

usage() {
  cat <<'EOF'
Usage: omarchy-kids-data <command> [args]

  launches <kid> [--since DAYS]  App launches recorded for <kid> (Level 1
                                  tiles only), most recent first.
  sites <kid> [--since DAYS]     Sites visited, read from <kid>'s own
                                  Chromium profile. Needs root, unless run
                                  as <kid> themselves. Prints nothing (and
                                  says so) if history_visible=no.
  summary <kid> [--week]         Minutes, top apps, top sites for today,
                                  or the last 7 days with --week.
  mine                           "What my grown-ups can see" (K5), run as
                                  the kid the data belongs to.
  retention [--apply]            Prune everything past SPEC.md R-DATA-1's
                                  retention (usage 1 year, launches and
                                  requests 90 days; browsing history is
                                  never pruned here — the browser's own).
                                  DRY_RUN by default: prints what it would
                                  remove.

  -h, --help  Show this help and exit.
EOF
}

# --- small helpers ---------------------------------------------------------

# require_root_or_self KID — 0 if this process may read what has been
# recorded about KID: it's root, or it *is* KID (a kid reading their own
# record needs no elevation — only reaching into another account's does).
# The account comes from `id -un`, never from the environment: this is an
# authorization decision (review §3.7).
require_root_or_self() {
  local kid="$1"
  is_root && return 0
  [[ "$(id -un)" == "$kid" ]] && return 0
  return 1
}

# copy_chromium_history KID — copies KID's Chromium History db (and its
# -wal/-shm sidecars, if present) to a fresh temp file and prints its
# path; returns 1 with nothing printed if there's no History db yet (a
# kid who hasn't browsed is not an error). Caller removes the copy when
# done (rm_chromium_copy).
copy_chromium_history() {
  local kid="$1" src dst
  src="$(data_chromium_history "$kid")"
  [[ -r "$src" ]] || return 1
  dst="$(mktemp)" || return 1
  cp -f "$src" "$dst" 2>/dev/null || return 1
  [[ -r "$src-wal" ]] && cp -f "$src-wal" "$dst-wal" 2>/dev/null
  [[ -r "$src-shm" ]] && cp -f "$src-shm" "$dst-shm" 2>/dev/null
  printf '%s\n' "$dst"
}

rm_chromium_copy() { rm -f "$1" "$1-wal" "$1-shm" 2>/dev/null || true; }

plural() { [[ "$1" == 1 ]] && printf '' || printf 's'; } # N -> "" or "s"

# --- launches ---------------------------------------------------------------

cmd_launches() {
  local kid="$1"
  shift
  require_root_or_self "$kid" ||
    die "launches: '$kid' is not you, and this is not root (R-DATA-1)" 1
  local since=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since)
        since="${2:-}"
        shift 2
        ;;
      *) die "launches: unknown argument '$1'" ;;
    esac
  done

  local log rows
  log="$(data_launches_file "$kid")"
  if [[ -n "$since" ]]; then
    [[ "$since" =~ ^[0-9]+$ ]] || die "launches: --since needs a whole number of days"
    local cutoff
    cutoff="$(data_py since-cutoff "$since" "$(time_now)")"
    rows="$(data_py filter-log "$log" "$cutoff")"
  else
    rows="$(cat "$log" 2>/dev/null || true)"
  fi

  if [[ -z "$rows" ]]; then
    echo "No app launches recorded yet for $kid."
    return 0
  fi
  echo "$kid: app launches${since:+ (last $since day$(plural "$since"))}"
  printf '%s\n' "$rows" | sort -r | while read -r t id; do
    printf '  %s  %s\n' "$t" "$id"
  done
}

# --- sites --------------------------------------------------------------------

cmd_sites() {
  local kid="$1"
  shift
  local since=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since)
        since="${2:-}"
        shift 2
        ;;
      *) die "sites: unknown argument '$1'" ;;
    esac
  done

  local hv
  hv="$(data_history_visible "$kid" "$CONF_BIN")"
  if [[ "$hv" != yes ]]; then
    echo "History is not visible to $kid's grown-ups right now (history_visible=no)."
    return 0
  fi
  require_root_or_self "$kid" ||
    die "reading another account's browsing history needs root: sudo omarchy-kids-data sites $kid" 1

  local copy
  copy="$(copy_chromium_history "$kid")" || {
    echo "No browsing history recorded yet for $kid."
    return 0
  }

  local -a since_args=()
  if [[ -n "$since" ]]; then
    [[ "$since" =~ ^[0-9]+$ ]] || {
      rm_chromium_copy "$copy"
      die "sites: --since needs a whole number of days"
    }
    since_args=(--since "$(data_py since-cutoff "$since" "$(time_now)")")
  fi
  local rows
  rows="$(data_py chromium-visits "$copy" "${since_args[@]+"${since_args[@]}"}")"
  rm_chromium_copy "$copy"

  if [[ -z "$rows" ]]; then
    echo "No browsing history recorded yet for $kid."
    return 0
  fi
  echo "$kid: sites visited${since:+ (last $since day$(plural "$since"))}"
  printf '%s\n' "$rows" | while IFS=$'\t' read -r t host title visits; do
    printf '  %s  %s — %s (%s visit%s)\n' "$t" "$host" "${title:-(no title)}" "$visits" "$(plural "$visits")"
  done
}

# --- summary ------------------------------------------------------------------

cmd_summary() {
  local kid="$1"
  shift
  local week=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --week)
        week=1
        shift
        ;;
      *) die "summary: unknown argument '$1'" ;;
    esac
  done

  local now day weekend
  now="$(time_now)"
  IFS=$'\t' read -r day weekend <<<"$(time_logical_day "$now")" || die "could not compute today's logical day"

  # cutoff — the launches/sites window, expressed as the exact same
  # 04:00 logical-day boundary "minutes used" is already measured
  # against (Appendix F), so a kid's "today" numbers always agree
  # across every figure on this screen instead of one being a rolling
  # 24h/7d window and the other a calendar day.
  local cutoff
  if ((week)); then
    echo "$kid: minutes per day (last 7 days)"
    local total=0 d used i week_start
    for i in 6 5 4 3 2 1 0; do
      d="$(data_py since-cutoff "$i" "$now")"
      d="${d:0:10}"
      [[ -z "${week_start:-}" ]] && week_start="$d"
      used="$(time_used_minutes "$kid" "$d")"
      total=$((total + used))
      printf '  %s: %s min\n' "$d" "$used"
    done
    echo "total: $total min"
    cutoff="${week_start}T04:00:00"
  else
    local used budget remaining
    used="$(time_used_minutes "$kid" "$day")"
    budget="$(time_budget_minutes "$kid" "$weekend")"
    remaining="$(time_remaining_minutes "$kid" "$day" "$weekend")"
    echo "$kid: today ($day)"
    echo "minutes used: $used (budget $budget, $remaining left)"
    cutoff="${day}T04:00:00"
  fi

  local launches_rows nlaunches=0
  launches_rows="$(data_py filter-log "$(data_launches_file "$kid")" "$cutoff")"
  [[ -n "$launches_rows" ]] && nlaunches="$(printf '%s\n' "$launches_rows" | grep -c '.')"
  echo "launches: $nlaunches"
  if ((nlaunches > 0)); then
    echo "top apps:"
    printf '%s\n' "$launches_rows" | awk '{print $2}' | sort | uniq -c | sort -rn | head -5 |
      while read -r count id; do printf '  %s: %s\n' "$id" "$count"; done
  fi

  local hv
  hv="$(data_history_visible "$kid" "$CONF_BIN")"
  if [[ "$hv" != yes ]]; then
    echo "top sites: history is not visible to $kid's grown-ups (history_visible=no)"
  elif ! require_root_or_self "$kid"; then
    echo "top sites: (run as root, or as $kid, to see this)"
  else
    local copy
    if copy="$(copy_chromium_history "$kid")"; then
      local site_rows
      site_rows="$(data_py chromium-top-sites "$copy" --since "$cutoff" --limit 5)"
      rm_chromium_copy "$copy"
      if [[ -n "$site_rows" ]]; then
        echo "top sites:"
        printf '%s\n' "$site_rows" | while IFS=$'\t' read -r host visits _last; do
          printf '  %s: %s visit%s\n' "$host" "$visits" "$(plural "$visits")"
        done
      else
        echo "top sites: none recorded yet"
      fi
    else
      echo "top sites: none recorded yet"
    fi
  fi
}

# --- mine (K5, "What my grown-ups can see") ------------------------------------

cmd_mine() {
  local kid
  kid="$(id -un)"
  local hv
  hv="$(data_history_visible "$kid" "$CONF_BIN")"

  echo "What my grown-ups can see"
  echo
  echo "Hi! Here's what this computer remembers about how you use it:"
  echo
  echo "  - How many minutes you use it each day. Kept for 1 year."
  echo "  - Which apps you open from your launcher. Kept for 90 days."
  if [[ "$hv" == yes ]]; then
    echo "  - The websites you visit. Kept as long as the web browser itself keeps it."
  else
    echo "  - Your grown-ups have turned OFF website history for you — they cannot see"
    echo "    which sites you visit."
  fi
  echo
  echo "Nothing you type, no pictures of your screen, and nothing you write in a"
  echo "message is ever recorded. Only your grown-ups can see any of this — it never"
  echo "leaves this computer."
  echo

  local usage_dir earliest last_day
  usage_dir="$(data_usage_dir "$kid")"
  if [[ -d "$usage_dir" ]]; then
    earliest="$(find_usage_days "$usage_dir" | sort | head -1)"
    last_day="$(find_usage_days "$usage_dir" | sort | tail -1)"
  fi
  echo "Since: ${earliest:-today}"
  echo
  if [[ -n "${last_day:-}" ]]; then
    echo "Your last day's summary ($last_day):"
    printf '  minutes used: %s\n' "$(time_used_minutes "$kid" "$last_day")"
  else
    echo "Your last day's summary: (no days recorded yet)"
  fi
}

# find_usage_days DIR — every "YYYY-MM-DD" ledger filename in DIR (no
# ".grant" siblings), one per line.
find_usage_days() {
  local dir="$1" f base
  for f in "$dir"/*; do
    [[ -e "$f" ]] || continue
    base="$(basename "$f")"
    [[ "$base" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] && printf '%s\n' "$base"
  done
}

# --- retention ------------------------------------------------------------

prune_usage() { # KID CUTOFF_DATE APPLY
  local kid="$1" cutoff="$2" apply="$3" dir f base date
  dir="$(data_usage_dir "$kid")"
  [[ -d "$dir" ]] || return 0
  for f in "$dir"/*; do
    [[ -e "$f" ]] || continue
    base="$(basename "$f")"
    date="${base%.grant}"
    [[ "$date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || continue
    if [[ "$date" < "$cutoff" ]]; then
      if ((apply)); then rm -f "$f"; else echo "[dry-run] rm $f"; fi
    fi
  done
}

prune_launches() { # KID CUTOFF APPLY
  local kid="$1" cutoff="$2" apply="$3" file kept tmp
  file="$(data_launches_file "$kid")"
  [[ -f "$file" ]] || return 0
  kept="$(data_py filter-log "$file" "$cutoff")"
  if ((apply)); then
    tmp="$(mktemp "${file}.XXXXXX")"
    if [[ -n "$kept" ]]; then printf '%s\n' "$kept" >"$tmp"; else : >"$tmp"; fi
    chmod 0644 "$tmp"
    mv "$tmp" "$file"
  else
    echo "[dry-run] rewrite $file, keeping entries since $cutoff"
  fi
}

prune_queue() { # CUTOFF_EPOCH APPLY
  local cutoff="$1" apply="$2" dir f base ts
  dir="$DATA_VARLIB/queue"
  [[ -d "$dir" ]] || return 0
  for f in "$dir"/*.json; do
    [[ -e "$f" ]] || continue
    base="$(basename "$f")"
    ts="${base%%-*}"
    [[ "$ts" =~ ^[0-9]+$ ]] || continue
    if ((ts < cutoff)); then
      if ((apply)); then rm -f "$f"; else echo "[dry-run] rm $f"; fi
    fi
  done
}

cmd_retention() {
  local apply=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --apply)
        apply=1
        shift
        ;;
      *) die "retention: unknown argument '$1'" ;;
    esac
  done
  if ! is_root; then
    die "retention must run as root (a daily timer, or a parent via sudo)" 1
  fi

  local now usage_cutoff launches_cutoff queue_cutoff
  now="$(time_now)"
  usage_cutoff="$(data_py since-cutoff 365 "$now")"
  usage_cutoff="${usage_cutoff:0:10}"
  launches_cutoff="$(data_py since-cutoff 90 "$now")"
  queue_cutoff="$(data_py since-epoch 90 "$now")"

  local kid
  while IFS= read -r kid; do
    [[ -n "$kid" ]] || continue
    prune_usage "$kid" "$usage_cutoff" "$apply"
    prune_launches "$kid" "$launches_cutoff" "$apply"
  done < <(kids_list "$KIDS_DIR")
  prune_queue "$queue_cutoff" "$apply"
}

# --- main --------------------------------------------------------------------

[[ $# -ge 1 ]] || {
  usage >&2
  exit 2
}
case "$1" in
  -h | --help)
    usage
    exit 0
    ;;
  launches)
    shift
    [[ $# -ge 1 ]] || die "launches: needs a kid account"
    cmd_launches "$@"
    ;;
  sites)
    shift
    [[ $# -ge 1 ]] || die "sites: needs a kid account"
    cmd_sites "$@"
    ;;
  summary)
    shift
    [[ $# -ge 1 ]] || die "summary: needs a kid account"
    cmd_summary "$@"
    ;;
  mine)
    shift
    cmd_mine "$@"
    ;;
  retention)
    shift
    cmd_retention "$@"
    ;;
  *) die "unknown command '$1' (see --help)" ;;
esac
