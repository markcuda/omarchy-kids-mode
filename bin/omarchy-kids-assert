#!/bin/bash
# omarchy:summary=Re-assert every Kids Mode lock, fixing whatever has drifted
# omarchy:args=[--quiet] [--dry-run]
# Re-asserts the selected mode's Kids Mode locks idempotently (SPEC.md I-4, R-TRUST-5, R-BOOTMODE-6, R-BOOTMODE-11).
# Applies fixes for real by default -- --dry-run opts into preview only.
# See docs/assert.md for the full lock list, when each caller runs it, and every exit code.
set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
LIB="$DIR/lib"
[[ -f "$LIB/conf.sh" ]] || LIB=/usr/lib/omarchy-kids
# shellcheck source=lib/conf.sh
source "$LIB/conf.sh"
# shellcheck source=lib/posture.sh
source "$LIB/posture.sh"
# theme_current_name/theme_apply_for for the "theme:<account>" lock (issue #53).
# shellcheck source=lib/theme.sh
source "$LIB/theme.sh"
# shellcheck source=lib/kids.sh
source "$LIB/kids.sh"
# shellcheck source=lib/boot-mode.sh
source "$LIB/boot-mode.sh"
# shellcheck source=lib/launcher-map.sh
source "$LIB/launcher-map.sh"
# shellcheck source=lib/session-manifest.sh
source "$LIB/session-manifest.sh"

CONF_BIN="$(kids_bin conf "$DIR")"

ETC="${OMARCHY_KIDS_ETC:-/etc/omarchy-kids}"
SHARE="${OMARCHY_KIDS_SHARE:-/usr/share/omarchy-kids}"
KIDS_DIR="$ETC/kids"
MACHINE_CONF="$ETC/machine.conf"

QUIET=0
DRY_RUN=0
ANY_FAIL=0
ANY_WARN=0

usage() {
  cat <<'EOF'
Usage: omarchy-kids-assert [--quiet] [--dry-run]

Re-asserts every Kids Mode lock for every provisioned kid, and every
machine-level lock, idempotently (SPEC.md I-4, R-TRUST-5): fstab bind
lines and noexec mounts, pam_namespace lines, the AccountsService pin,
the passwd GECOS fallback, the SDDM face icon, group membership, each
kid's own current Omarchy theme (issue #53), the polkit admin/deny rules,
the SDDM portal theme selection and its theme.conf.user parent/avatar data
(R-LOGIN, issue #39), pam_namespace on sddm and systemd-user, masked
getty@tty2..6, the /etc/omarchy-kids/hyprland/*.lua copies, per-band
Chromium policy file permissions, the session manifest for every kid and,
in disk mode, the boot hook and Limine locks (R-BOOT-5). With provisioned
kids, portal mode reports those boot locks as skipped and never inspects
their files or tools. With no kids, only units runs; no boot-lock status is
printed. See docs/assert.md for the full lock list and exit codes.

Applies fixes for real by default -- this is the command the pacman hook
and the boot unit call with no other flags, so it must self-heal without
needing --apply.

  --quiet     Print only "fixed"/"FAIL" lines and an unavailable boot-lock
              skip (no "ok" lines, no no-kids notice).
  --dry-run   Report what would change; write nothing.
  -h, --help  Show this help and exit.

Exit codes: 0 everything selected is (or now is) fine; 1 the trusted boot
mode is invalid or a selected lock cannot be fixed. A busy boot-mode lock
skips boot work after a bounded wait and does not fail non-boot repair.
EOF
}

for arg in "$@"; do
  case "$arg" in
    --quiet) QUIET=1 ;;
    --dry-run) DRY_RUN=1 ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "omarchy-kids-assert: unknown argument '$arg'" >&2
      usage >&2
      exit 2
      ;;
  esac
done

# report STATUS LOCK — "ok" suppressed under --quiet; sets ANY_FAIL on FAIL.
report() {
  local status="$1" lock="$2"
  [[ "$status" == "FAIL" ]] && ANY_FAIL=1
  [[ "$QUIET" -eq 1 && ("$status" == "ok" || ("$status" == "skip" && "$lock" != "boot-locks:unavailable")) ]] && return 0
  printf '%-8s %s\n' "$status" "$lock"
  return 0
}

# assert_one LOCK CHECK FIX [ARGS...] — *_ok is three-way (review S11):
# 0 ok, 2 warn ("could not look"), else fix/FAIL. docs/assert.md.
assert_one() {
  local lock="$1" check="$2" fix="$3" rc
  shift 3
  "$check" "$@" && rc=0 || rc=$?
  if [[ "$rc" -eq 0 ]]; then
    report ok "$lock"
    return 0
  fi
  if [[ "$rc" -eq 2 ]]; then
    report warn "$lock"
    ANY_WARN=1
    return 0
  fi
  if [[ "$DRY_RUN" -eq 1 ]]; then
    report would-fix "$lock"
    return 0
  fi
  if "$fix" "$@"; then
    report fixed "$lock"
  else
    report FAIL "$lock"
  fi
  return 0
}

# --- thin dispatch: one lib/assert-<area>.sh per lock group ----------------

# shellcheck source=lib/assert-locks.sh
source "$LIB/assert-locks.sh"
# shellcheck source=lib/assert-limine.sh
source "$LIB/assert-limine.sh"

main() {
  local boot_mode kids=() k
  if ! boot_mode="$(boot_mode_get)"; then
    echo "omarchy-kids-assert: cannot read trusted boot mode; no locks changed" >&2
    exit 1
  fi

  while IFS= read -r k; do
    [[ -n "$k" ]] && kids+=("$k")
  done < <(kids_list "$KIDS_DIR")

  if [[ ${#kids[@]} -eq 0 ]]; then
    # units is machine-level, not per-kid (R-BOOT-3): needed even with
    # no kid yet so the next wizard run's A2 works (issue #46, docs/assert.md).
    assert_one "units" units_ok units_fix
    # devices is machine-level too (R-NOTIFY-3): absent is fine, wrong is not.
    assert_one "devices" devices_ok devices_fix
    # queue (R-NOTIFY-7): the request queue is 0750 root:omarchy-parents, records 0640.
    assert_one "queue" queue_ok queue_fix
    # relay-away (R-NOTIFY-11.1): the away drop-in, if the parent consents to one.
    assert_one "relay-away" relay_away_ok relay_away_fix
    # The two secret-holding files (R-NOTIFY-11.4): modes only.
    assert_one "relay-tls" relay_tls_ok relay_tls_fix
    assert_one "courier-conf" courier_conf_ok courier_conf_fix
    [[ "$QUIET" -eq 1 ]] || echo "omarchy-kids-assert: no kids provisioned; nothing else to assert"
    [[ "$ANY_FAIL" -eq 0 ]] || exit 1
    exit 0
  fi

  local account band avatar name
  for account in "${kids[@]}"; do
    band="$(profile_field "$account" band)"
    avatar="$(profile_field "$account" avatar)"
    name="$(profile_field "$account" name)"
    assert_one "fstab:$account" fstab_ok fstab_fix "$account"
    assert_one "mount:$account" mount_ok mount_fix "$account"
    assert_one "namespace:$account" namespace_ok namespace_fix "$account"
    assert_one "accountsservice:$account" accountsservice_ok accountsservice_fix "$account" "$avatar"
    assert_one "gecos:$account" gecos_ok gecos_fix "$account" "$name"
    assert_one "face:$account" face_ok face_fix "$account" "$avatar"
    assert_one "groups:$account" groups_ok groups_fix "$account" "$band"
    # decisions (R-NOTIFY-6): the kid's own copies of their decided requests.
    assert_one "decisions:$account" decisions_ok decisions_fix "$account"
    assert_one "theme:$account" theme_ok theme_fix "$account"
    assert_one "launcher-map:$account" launcher_lock_ok launcher_lock_fix "$account"
    assert_one "session-manifest:$account" session_manifest_lock_ok session_manifest_lock_fix "$account"
  done

  assert_one "polkit-admin" polkit_admin_ok polkit_admin_fix
  assert_one "polkit-deny" polkit_deny_ok polkit_deny_fix
  assert_one "sddm-theme" sddm_theme_ok sddm_theme_fix
  assert_one "portal-conf" portal_conf_ok portal_conf_fix
  assert_one "pam:sddm" pam_ok pam_fix sddm
  assert_one "pam:systemd-user" pam_ok pam_fix systemd-user
  assert_one "pam:sddm-autologin" pam_ok pam_fix sddm-autologin

  local lock_stack
  lock_stack="$(posture_parent_unlock_lock_stack)"
  assert_one "parent-unlock:sddm" parent_unlock_ok parent_unlock_fix sddm
  assert_one "parent-unlock:$lock_stack" parent_unlock_ok parent_unlock_fix "$lock_stack"

  local n
  for n in 2 3 4 5 6; do
    assert_one "getty:tty$n" getty_ok getty_fix "$n"
  done

  assert_one "units" units_ok units_fix
  # devices (R-NOTIFY-3): the paired-device registry stays root-owned.
  assert_one "devices" devices_ok devices_fix
  # queue (R-NOTIFY-7): the request queue is 0750 root:omarchy-parents, records 0640.
  assert_one "queue" queue_ok queue_fix
  # relay-away (R-NOTIFY-11.1): the away drop-in, if the parent consents to one.
  assert_one "relay-away" relay_away_ok relay_away_fix
  # The two secret-holding files (R-NOTIFY-11.4): modes only.
  assert_one "relay-tls" relay_tls_ok relay_tls_fix
  assert_one "courier-conf" courier_conf_ok courier_conf_fix
  assert_one "parent-group" parent_group_ok parent_group_fix

  assert_one "hyprland-configs" hyprland_ok hyprland_fix

  local dir f band_token
  dir="$(chromium_dir)"
  if [[ -d "$dir" ]]; then
    for f in "$dir"/omarchy-kids-*.json; do
      [[ -e "$f" ]] || continue
      band_token="$(basename "$f")"
      band_token="${band_token#omarchy-kids-}"
      band_token="${band_token%.json}"
      assert_one "chromium-policy:$band_token" chromium_ok chromium_fix "$f" "$band_token"
    done
  fi

  if ! boot_mode_lock_acquire 5; then
    report skip "boot-locks:unavailable"
  elif ! boot_mode="$(boot_mode_get)"; then
    boot_mode_lock_release
    echo "omarchy-kids-assert: cannot read trusted boot mode under the transition lock; boot locks not changed" >&2
    exit 1
  elif [[ "$boot_mode" == disk ]]; then
    trap boot_mode_lock_release EXIT
    if [[ -f "$HOOK_FILE" ]]; then
      assert_one "boot-hook" boot_hook_ok boot_hook_fix
    fi

    # Machine-level, never nested under the boot hook (review S5, docs/assert.md).
    assert_one "limine-editor" limine_editor_ok limine_editor_fix
    assert_one "limine-snapshots" limine_snapshots_ok limine_snapshots_fix
  else
    trap boot_mode_lock_release EXIT
    report skip "boot-locks:portal"
  fi

  if [[ "$ANY_WARN" -eq 1 ]]; then
    echo "omarchy-kids-assert: one or more locks could not be verified on this machine (warn above)" >&2
  fi
  [[ "$ANY_FAIL" -eq 0 ]] || exit 1
  # A warn never fails the pacman hook/boot unit; docs/check.md turns
  # the same signal into its own non-zero verdict.
  exit 0
}

# Sourced by omarchy-kids-check for the *_ok functions only; run main only
# when executed directly, else sourcing would trigger assert_one's writes.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main
fi
