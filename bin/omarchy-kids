#!/bin/bash
# omarchy:summary=Open Kids Mode: the parent wizard first, the panel after
# omarchy:args=[wizard|remove-kids-mode] [--requests] [--dry-run] [--apply]
# The app entry point (R-FND-1, R-WIZ-1..9): the parent wizard with no
# kid provisioned yet, else the panel; `wizard` always opens the wizard,
# `remove-kids-mode` dispatches to omarchy-kids-remove (R-TRUST-4).
# See docs/panel.md for --requests and every other flag.
set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
LIB="$DIR/lib"
[[ -f "$LIB/kids.sh" ]] || LIB=/usr/lib/omarchy-kids
# shellcheck source=lib/kids.sh
source "$LIB/kids.sh"
WIZARD_BIN="$(kids_bin wizard "$DIR")"
REMOVE_BIN="$(kids_bin remove "$DIR")"
PANEL_BIN="$(kids_bin panel "$DIR")"
ASK_BIN="$(kids_bin ask "$DIR")"

ETC="${OMARCHY_KIDS_ETC:-/etc/omarchy-kids}"
KIDS_DIR="$ETC/kids"

if [[ "${1:-}" == "remove-kids-mode" ]]; then
  shift
  exec "$REMOVE_BIN" "$@"
fi

usage() {
  cat <<EOF
Usage: omarchy-kids [wizard] [--requests] [--dry-run] [--apply] [--help]
       omarchy-kids remove-kids-mode [--yes] [--dry-run] [--delete-homes]

Opens Kids Mode. With no kid provisioned yet, this is the parent wizard
(SPEC.md R-WIZ). Once a kid exists, this opens the panel (R-WIZ-7/8) and
'omarchy-kids wizard' always opens the wizard, to add another kid.

  wizard            Always open the parent wizard, even if kids already exist.
  --requests        Print open "ask a parent" requests (R-ASK-2) with
                    omarchy-kids-ask list (root or a member of
                    omarchy-parents, R-NOTIFY-7), instead of opening the
                    panel -- a quick look without the full screen.
  remove-kids-mode  Remove Kids Mode (R-TRUST-4); see
                    omarchy-kids-remove --help for its own flags.
  --dry-run         Passed through to the wizard's or panel's own --dry-run.
  --apply           Passed through to the wizard's or panel's own --apply.

Opened by a human -- from a terminal, or from the Kids Mode app entry --
the wizard and the panel are real; --dry-run is there for review.
  -h, --help        Show this help and exit.
EOF
}

any_kid_provisioned() {
  local f
  for f in "$KIDS_DIR"/*.conf; do
    [[ -e "$f" ]] && return 0
  done
  return 1
}

args=()
open_wizard=0
show_requests=0
for arg in "$@"; do
  case "$arg" in
    wizard) open_wizard=1 ;;
    --requests) show_requests=1 ;;
    -h | --help)
      usage
      exit 0
      ;;
    *) args+=("$arg") ;;
  esac
done

if ((open_wizard)); then
  exec "$WIZARD_BIN" "${args[@]+"${args[@]}"}"
fi

if ! any_kid_provisioned; then
  exec "$WIZARD_BIN" "${args[@]+"${args[@]}"}"
fi

if ((show_requests)); then
  "$ASK_BIN" list
  exit 0
fi

exec "$PANEL_BIN" "${args[@]+"${args[@]}"}"
