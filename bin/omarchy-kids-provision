#!/bin/bash
# omarchy:summary=Add or remove a kid's Unix account and every lock it needs
# omarchy:args=<add <display-name> --band <band>|remove <account>|list>
# Adds and removes a kid account: the Unix account, profile, and every
# lock provisioning needs (SPEC.md R-FND-2..6, R-SEC-3..5, R-LOGIN-3,
# Appendix B). DRY_RUN=1 by default; --apply/DRY_RUN=0 makes it real.
# See docs/provision.md for the exact order, every env var, and what
# each step touches.
set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
LIB="$DIR/lib"
[[ -f "$LIB/conf.sh" ]] || LIB=/usr/lib/omarchy-kids
# shellcheck source=lib/conf.sh
source "$LIB/conf.sh"
# shellcheck source=lib/posture.sh
source "$LIB/posture.sh"
# shellcheck source=lib/kids.sh
source "$LIB/kids.sh"
# shellcheck source=lib/boot-mode.sh
source "$LIB/boot-mode.sh"
# shellcheck source=lib/launcher-map.sh
source "$LIB/launcher-map.sh"
# shellcheck source=lib/session-manifest.sh
source "$LIB/session-manifest.sh"

# Device selection is an explicit option or local detection, never ambient state.
unset OMARCHY_KIDS_LUKS_DEVICE

DRY_RUN="${DRY_RUN:-1}"

ETC="${OMARCHY_KIDS_ETC:-/etc/omarchy-kids}"
SHARE="${OMARCHY_KIDS_SHARE:-/usr/share/omarchy-kids}"
KIDS_DIR="$ETC/kids"
SLOTS_FILE="$ETC/luks-slots"
MACHINE_CONF="$ETC/machine.conf"

CONF_BIN="$(kids_bin conf "$DIR")"

die() {
  echo "omarchy-kids-provision: $1" >&2
  exit "${2:-2}"
}

usage() {
  cat <<'EOF'
Usage: omarchy-kids-provision add <display-name> --band <band>
           [--avatar ID] [--password-stdin | --no-password]
           [--parent-password-stdin] [--parent-password-fd N]
           [--luks-device DEV] [--apply]
       omarchy-kids-provision remove <account> [--keep-home]
           [--luks-device DEV] [--apply]
       omarchy-kids-provision list
       omarchy-kids-provision --help

add     Creates the Unix account, the profile, the polkit/pam/fstab
        posture, an AccountsService pin, the SDDM portal theme selection
        (R-LOGIN), a LUKS key slot if a password and an encrypted root
        device are both in play, and either runs omarchy-provision-user
        or marks Omarchy's per-user migrations done -- so the new
        desktop never shows "Pending Omarchy Migrations". Also matches
        the kid's own desktop theme to the parent's current one
        (docs/theming.md). Bands: 3-5, 6-8, 9-12, 13+.

        The kid's password is read from stdin (never argv), one line,
        with --password-stdin. --no-password locks the account instead,
        and is only accepted for band 3-5 (R-SEC-3). When a LUKS slot is
        also being added in disk mode, the parent's own passphrase (needed to
        authorize the add) is the *second* line of the same stdin with
        --parent-password-stdin, or comes from an already-open file
        descriptor with --parent-password-fd N. Those options and
        --luks-device are rejected in portal mode.

remove  Reverses everything "add" did for that account: LUKS slot,
        luks-slots rewrite, pam_namespace lines, AccountsService file,
        fstab line and mount, then the account itself. The home moves to
        "<parent home>/Kids Mode/<name>/" unless --keep-home; the profile
        stays until those steps finish so a retry can resume.
        Machine-level pieces (groups, console masks, the polkit rules)
        are left for Remove Kids Mode. --luks-device is disk-mode only;
        portal mode refuses an account that still has a recorded slot.

list    One line per provisioned kid: account, name, band.

DRY_RUN=1 is the default everywhere (see AGENTS.md rule 8): every command
above only prints what it would do. Pass --apply, or set DRY_RUN=0, to
make it real.
EOF
}

# ensure_parent_unlock_soft STACK — a missing PAM stack is a warning here,
# never a reason to fail the add; omarchy-kids-assert re-asserts it later
# once the stack exists. docs/provision.md.
ensure_parent_unlock_soft() {
  local stack="$1"
  if ! run posture_ensure_parent_unlock_line "$stack"; then
    echo "warning: could not add the parent-unlock line to pam.d/$stack (see stderr above)" >&2
  fi
}

# valid_display_name NAME — see cmd_add's own note (review S10).
valid_display_name() {
  local name="$1"
  [[ ${#name} -ge 1 && ${#name} -le 64 ]] || return 1
  [[ "$name" != *$'\t'* && "$name" != *$'\n'* ]] || return 1
  return 0
}

# band_field BAND KEY — lib/kids.sh's kids_band_field, with this
# command's own error message (docs/conf.md).
band_field() {
  kids_band_field "$CONF_BIN" "$@" || die "could not read band '$1' defaults from $CONF_BIN"
}

read_boot_mode() {
  local mode
  mode="$(boot_mode_get 2>/dev/null)" || die "invalid or missing boot mode in machine.conf; set boot=disk or boot=portal" 1
  printf '%s\n' "$mode"
}

# read_parent — the "parent=" account name from $MACHINE_CONF, via
# lib/conf.sh's conf_get (the format's one shared reader).
read_parent() { conf_get "$MACHINE_CONF" parent 2>/dev/null || true; }

# luks-slots parsing/writing (luks_slots_parent_line, luks_slots_kid_entries,
# luks_slot_for_account, posture_write_luks_slots) lives in lib/kids.sh now --
# it used to be duplicated here and in bin/omarchy-kids-remove. See
# docs/boot.md for the "slot=account[:session]" format.

# --- theme.conf.user (R-LOGIN, issue #39) -----------------------------------

unique_account() {
  local base="$1" n=2
  local account="$base"
  while [[ -e "$KIDS_DIR/$account.conf" ]] ||
    { command -v getent >/dev/null 2>&1 && getent passwd "$account" >/dev/null 2>&1; }; do
    account="${base}-${n}"
    n=$((n + 1))
  done
  printf '%s\n' "$account"
}

# --- Omarchy per-user migrations (issue #10 finding b) ---------------------

# mark_migrations_done ACCOUNT — best-effort stand-in for
# omarchy-provision-user when it doesn't exist -- guessed marker format,
# TODO(#10). docs/provision.md "Known gap".
mark_migrations_done() {
  local account="$1" home migrations_src state_dir f stage
  home="$(home_dir_for "$account")"
  migrations_src="${OMARCHY_MIGRATIONS_DIR:-/usr/share/omarchy/migrations}"
  state_dir="$home/.local/state/omarchy"
  install -d -m 0700 "$state_dir"
  # Staged and renamed like the app configs: a plain redirect would follow a
  # symlink a kid could have planted at this exact path.
  stage="$(mktemp "$state_dir/.migrations.log.XXXXXX")"
  {
    if [[ -d "$migrations_src" ]]; then
      for f in "$migrations_src"/*; do
        [[ -e "$f" ]] || continue
        printf '%s %s\n' "$(basename "$f")" "$(date -u +%FT%TZ)"
      done
    fi
  } >"$stage"
  # 0600 like the directory it sits in (root-owned 0700), and staged so the write
  # cannot follow a link a kid planted at this exact path.
  chmod 0600 "$stage"
  mv -f "$stage" "$state_dir/migrations.log"
  chown "$account:$account" "$state_dir" 2>/dev/null || true
}

# symlinked_kid_path PATH... -- prints the first PATH that is a symlink and fails.
# Rule 9: root must never write through (or chown through) a path a kid could
# have replaced, and `-L` is true for a dangling link, which a bare `-e` misses.
# Every writer below runs at `add` time, when a kid's home may be one an earlier
# account left behind (`remove --keep-home`) after that kid had a shell in it.
symlinked_kid_path() {
  local p
  for p in "$@"; do
    if [[ -L "$p" ]]; then
      printf '%s\n' "$p"
      return 1
    fi
  done
  return 0
}

# kid_home_writable_paths HOME -- every path under a kid's home that `add`
# writes into. The list is the one table for this rule; a writer that starts
# writing somewhere new adds its path here, and the refusal below is what keeps
# root from following a kid-planted link on any of them.
kid_home_writable_paths() {
  local home="$1"
  printf '%s\n' \
    "$home/.config" \
    "$home/.config/chromium-flags.conf" \
    "$home/.config/gcompris" \
    "$home/.config/omarchy" \
    "$home/.config/omarchy/extensions" \
    "$home/.config/omarchy/extensions/omarchy-menu.jsonc" \
    "$home/.local" \
    "$home/.local/state" \
    "$home/.local/state/omarchy" \
    "$home/.local/state/omarchy/migrations.log"
}

# --- Chromium launch flags override (issue #44) -----------------------

# install_kids_chromium_flags ACCOUNT — overwrites Omarchy's own
# chromium-flags.conf, whose --load-extension flags the kids policy
# refuses (docs/web.md). Root:root 0644 so a kid can't put the flag back.
install_kids_chromium_flags() {
  local account="$1" home config_dir dest stage
  home="$(home_dir_for "$account")"
  config_dir="$home/.config"
  dest="$config_dir/chromium-flags.conf"
  install -d -m 0755 "$config_dir"
  stage="$(mktemp "$config_dir/.chromium-flags.conf.XXXXXX")"
  cp -f "$SHARE/policy/chromium-flags.conf" "$stage"
  chmod 0644 "$stage"
  mv -f "$stage" "$dest"
  # The file stays root:root deliberately (a kid must not put the flag back),
  # but the directory is the kid's: root-owned, a kid's own apps could not save
  # any config at all.
  chown "$account:$account" "$config_dir" >/dev/null 2>&1 || true
  if ! chown root:root "$dest" >/dev/null 2>&1; then
    echo "  (could not chown $dest to root:root -- fine outside a real root run)" >&2
  fi
}

# --- omarchy-menu trim (R-DESK-4) --------------------------------------

# install_kids_menu_trim ACCOUNT — writes the omarchy-menu user extension into
# the kid's own ~/.config/omarchy/extensions/ when their profile says
# menu=trimmed (the band default now). The extension hides
# the parent-only rows (install, remove, update, setup) by re-stating each id
# with when: "false" — the real merge shape, verified against Omarchy 4.0.2's
# menu plugin (docs/levels.md). It is the kid's own file, so it is
# presentation, never a lock: their account still denies every action behind
# those rows. Kid-owned so their shell can rewrite it like any user config.
install_kids_menu_trim() {
  local account="$1" home ext_dir dest mode src
  mode="$("$CONF_BIN" get "$account" menu 2>/dev/null || true)"
  [[ "$mode" == "trimmed" ]] || return 0
  src="$SHARE/menu/omarchy-kids-trimmed.jsonc"
  if [[ ! -f "$src" ]]; then
    # Presentation only, so a package without the file must not fail a
    # provision; say so rather than installing nothing silently (I-6).
    echo "warning: $src is missing; skipping the omarchy-menu trim for $account" >&2
    return 0
  fi
  home="$(home_dir_for "$account")"
  ext_dir="$home/.config/omarchy/extensions"
  install -d -m 0755 "$ext_dir"
  dest="$ext_dir/omarchy-menu.jsonc"
  install -m 0644 "$src" "$dest"
  chown "$account:$account" "$dest" 2>/dev/null ||
    echo "  (could not chown $dest to $account -- fine outside a real root run)" >&2
}

# install_kids_data_entry ACCOUNT — a Desktop-mode way to the data screen
# (R-DATA-3). The App grid's tile (lib/launcher-map.sh) is the Grid's only, so a
# 9-12/13+ kid on the Desktop mode (their default) would not reach "What my
# grown-ups can see"; this installs the same entry as a kid-owned .desktop so
# Omarchy's own menu finds it. Band-gated exactly as the tile is. Presentation,
# not a lock: the command behind it is read-only and kid-side.
install_kids_data_entry() {
  local account="$1" band home dir dest src
  band="$("$CONF_BIN" get "$account" band 2>/dev/null || true)"
  [[ "$band" == "9-12" || "$band" == "13+" ]] || return 0
  src="$SHARE/applications/omarchy-kids-data.desktop"
  if [[ ! -f "$src" ]]; then
    echo "warning: $src is missing; skipping the data entry for $account" >&2
    return 0
  fi
  home="$(home_dir_for "$account")"
  dir="$home/.local/share/applications"
  install -d -m 0755 "$dir"
  dest="$dir/omarchy-kids-data.desktop"
  install -m 0644 "$src" "$dest"
  chown "$account:$account" "$dest" 2>/dev/null ||
    echo "  (could not chown $dest to $account -- fine outside a real root run)" >&2
}

# gcompris_version_number — the number GCompris itself writes into
# lastGCVersionRan (major*10000 + minor*100 + patch). Verified 2026-09-22
# against the value the app wrote on first run: gcompris-qt 26.1 -> 260100.
# Prints nothing when the installed version cannot be read, and the caller then
# seeds without the marker rather than guessing.
gcompris_version_number() {
  command -v pacman >/dev/null 2>&1 || return 0
  local raw major minor patch
  raw="$(pacman -Q gcompris-qt 2>/dev/null)" || return 0
  raw="${raw##* }" # "gcompris-qt 26.1-1" -> "26.1-1"
  raw="${raw%%-*}" # "26.1-1" -> "26.1"
  IFS=. read -r major minor patch <<<"$raw"
  [[ "$major" =~ ^[0-9]+$ && "$minor" =~ ^[0-9]+$ ]] || return 0
  [[ "${patch:-0}" =~ ^[0-9]+$ ]] || patch=0
  # 10# forces decimal: bash reads a leading zero as octal, so "26.08" would be
  # an arithmetic error that takes the whole provision down with it.
  printf '%s\n' "$((10#$major * 10000 + 10#$minor * 100 + 10#${patch:-0}))"
}

# install_kids_gcompris_config ACCOUNT — pre-seed GCompris's own config before
# the app has run once (docs/apps.md; the proposal is
# docs/research/2026-09-21-gcompris-first-run-and-config-proposal.md, approved
# 2026-09-21 and VM-checked 2026-09-22). Configuration, not a lock: kiosk=true
# hides the app's own quit, configuration and menu buttons (the kid still closes
# it with Super+Q, our bind) and fullscreen=true matches every kid level. The
# app shows its "first time" welcome when it has no config at all, and its
# "has been updated" changelog plus a dataset prompt when it has one without the
# [Internal] version marker: seeding the file removes the first, the marker the
# second -- all verified live, all one-time, all keyboard-dismissible. The app
# owns the file from its first run on, so an existing one is never rewritten.
install_kids_gcompris_config() {
  local account="$1" home config_dir dest stage version
  home="$(home_dir_for "$account")"
  config_dir="$home/.config/gcompris"
  dest="$config_dir/gcompris-qt.conf"

  # cmd_add's own preflight refuses a kid-planted link on every path this
  # command writes (kid_home_writable_paths); staging then renaming keeps this
  # writer safe on its own too, since rename(2) replaces a link at the
  # destination instead of following it.
  if [[ -e "$dest" ]]; then
    if [[ ! -f "$dest" ]]; then
      echo "warning: refusing to seed GCompris for $account: $dest is not a regular file" >&2
      return 0
    fi
    echo "  ($account already has $dest -- left as the app wrote it)"
    return 0
  fi

  version="$(gcompris_version_number)"
  install -d -m 0755 "$config_dir"
  stage="$(mktemp "$config_dir/.gcompris-qt.conf.XXXXXX")"
  {
    printf '[%%General]\nfullscreen=true\nkiosk=true\n'
    if [[ -n "$version" ]]; then
      printf '\n[Internal]\nlastGCVersionRan=%s\n' "$version"
    fi
  } >"$stage"
  chmod 0644 "$stage"
  mv -f "$stage" "$dest"
  # The directories as well as the file: a root-owned ~/.config would stop the
  # kid's own apps from saving anything, and Qt's QSettings needs to write its
  # lock and temp file beside this one. Handing over a directory the kid already
  # owns is a no-op, and chown is not recursive, so nothing inside changes owner.
  if ! chown "$account:$account" "$home/.config" "$config_dir" "$dest" >/dev/null 2>&1; then
    echo "  (could not chown $home/.config, $config_dir and $dest to $account -- fine outside a real root run)" >&2
  fi
  if [[ -z "$version" ]]; then
    echo "warning: could not read the installed gcompris-qt version; $account will see GCompris's \"has been updated\" changelog and a dataset prompt once" >&2
  fi
}

# --- thin dispatch: one lib/provision-<verb>.sh per subcommand -------------

# shellcheck source=lib/provision-add.sh
source "$LIB/provision-add.sh"
# shellcheck source=lib/provision-remove.sh
source "$LIB/provision-remove.sh"

# --- list ------------------------------------------------------------------

cmd_list() {
  if [[ ! -d "$KIDS_DIR" ]]; then
    echo "no kids provisioned yet"
    return 0
  fi
  local f any=0 account name band
  for f in "$KIDS_DIR"/*.conf; do
    [[ -e "$f" ]] || continue
    any=1
    account="$(basename "$f" .conf)"
    name="$(conf_get "$f" name 2>/dev/null || echo '?')"
    band="$(conf_get "$f" band 2>/dev/null || echo '?')"
    printf '%s\t%s\t%s\n' "$account" "$name" "$band"
  done
  [[ $any == 1 ]] || echo "no kids provisioned yet"
}

# --- main --------------------------------------------------------------

main() {
  [[ $# -ge 1 ]] || {
    usage >&2
    exit 2
  }
  local cmd="$1"
  shift
  case "$cmd" in
    -h | --help)
      usage
      exit 0
      ;;
  esac

  local -a rest=()
  local arg
  for arg in "$@"; do
    if [[ "$arg" == "--apply" ]]; then
      DRY_RUN=0
    else
      rest+=("$arg")
    fi
  done

  case "$cmd" in
    add) cmd_add "${rest[@]+"${rest[@]}"}" ;;
    remove) cmd_remove "${rest[@]+"${rest[@]}"}" ;;
    list) cmd_list "${rest[@]+"${rest[@]}"}" ;;
    *) die "unknown command: '$cmd' (see --help)" ;;
  esac
}

main "$@"
