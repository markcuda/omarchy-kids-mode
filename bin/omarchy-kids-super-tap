#!/bin/bash
# omarchy:summary=Watch for three Super taps within 1.5s and open the exit modal
# omarchy:hidden=true
# The "Super pressed three times within 1.5s" half of SPEC.md R-EXIT-1.
# Meant for a Hyprland `bindr` (release) bind -- docs/exit.md.
set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
LIB="$DIR/lib"
[[ -f "$LIB/kids.sh" ]] || LIB=/usr/lib/omarchy-kids
# shellcheck source=lib/kids.sh
source "$LIB/kids.sh"

RUN="/run/user/$(id -u)/omarchy-kids"
FILE="$RUN/super-taps"
WINDOW_MS="${OMARCHY_KIDS_SUPER_TAP_WINDOW_MS:-1500}"
EXIT_BIN="$(kids_bin exit "$DIR")"

usage() {
  cat <<EOF
Usage: omarchy-kids-super-tap

Run once per bare Super release -- every Kids Mode level
(share/hyprland/L1.lua, L2.lua, L3.lua) binds it with { release = true }.
Three releases within \${OMARCHY_KIDS_SUPER_TAP_WINDOW_MS:-1500}ms run
omarchy-kids-exit (resolved beside this script, else
/usr/bin/omarchy-kids-exit -- never from the environment).

Env:
  OMARCHY_KIDS_SUPER_TAP_WINDOW_MS  default 1500
  OMARCHY_KIDS_SUPER_TAP_NOW_MS  test hook: use this instead of the real
                                 clock for "now", so tests never need to
                                 sleep for real time to pass

  -h, --help  Show this help and exit.
EOF
}

for arg in "$@"; do
  case "$arg" in
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "omarchy-kids-super-tap: unknown argument '$arg' (see --help)" >&2
      exit 2
      ;;
  esac
done

# now_ms — milliseconds since the epoch, GNU-date-only %s%N with a
# whole-second BSD-date fallback. docs/exit.md.
now_ms() {
  if [[ -n "${OMARCHY_KIDS_SUPER_TAP_NOW_MS:-}" ]]; then
    printf '%s\n' "$OMARCHY_KIDS_SUPER_TAP_NOW_MS"
    return 0
  fi
  local raw
  raw="$(date +%s%N 2>/dev/null || true)"
  if [[ "$raw" =~ ^[0-9]+$ && ${#raw} -gt 10 ]]; then
    printf '%s\n' $((raw / 1000000))
  else
    printf '%s000\n' "$(date +%s)"
  fi
}

mkdir -p "$RUN"

now="$(now_ms)"
kept=()
if [[ -f "$FILE" ]]; then
  while IFS= read -r ts || [[ -n "$ts" ]]; do
    [[ "$ts" =~ ^[0-9]+$ ]] || continue
    ((now - ts <= WINDOW_MS)) && kept+=("$ts")
  done <"$FILE"
fi
kept+=("$now")

if ((${#kept[@]} >= 3)); then
  : >"$FILE" # reset: the next three taps start a fresh count
  exec "$EXIT_BIN"
fi

printf '%s\n' "${kept[@]}" >"$FILE"
