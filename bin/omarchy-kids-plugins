#!/bin/bash
# omarchy:summary=Install or remove a kid-approved plugin from the marketplace
# omarchy:args=<shelf|install|remove> [args]
# The kids-plugins shelf: marketplace listings filtered to category "Kids", verified only, install/remove
# into one kid's account (SPEC.md R-APPS-7, I-3, I-6). See docs/plugins.md for the marketplace format and every env var.
set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
LIB="$DIR/lib"
[[ -f "$LIB/kids.sh" ]] || LIB=/usr/lib/omarchy-kids
# shellcheck source=lib/kids.sh
source "$LIB/kids.sh"
CONF_BIN="$(kids_bin conf "$DIR")"

ETC="${OMARCHY_KIDS_ETC:-/etc/omarchy-kids}"
SYSROOT="${OMARCHY_KIDS_ROOT:-}"
INDEX="${OMARCHY_KIDS_PLUGIN_INDEX:-$SYSROOT/var/lib/omarchy-kids/plugin-marketplace/index.json}"

DRY_RUN="${DRY_RUN:-1}"

die() {
  echo "omarchy-kids-plugins: $1" >&2
  exit "${2:-2}"
}

usage() {
  cat <<'EOF'
Usage: omarchy-kids-plugins shelf [--band BAND] [--all] [--json]
       omarchy-kids-plugins install <plugin> --kid <kid> [--apply]
       omarchy-kids-plugins remove <plugin> --kid <kid> [--apply]
       omarchy-kids-plugins --help

shelf     Marketplace listings, category "Kids", verified only by
          default. --band keeps only entries at or below that band's
          age floor (an entry with no floor recorded is always kept).
          --all also lists unverified Kids listings, with a warning
          (parent-only by convention; install still refuses them).
          --json prints a JSON array (id/name/description/age/verified)
          instead of a table -- for share/plugins/shell.qml's kid-side
          overlay; suppresses the --all warning line.

install   Root. Installs a verified Kids-shelf plugin into <kid>'s own
          account (Omarchy's own `omarchy-plugin-add`, run as that
          kid), then adds it to that kid's apps.extra.

remove    Root. The reverse: `omarchy-plugin-remove` as that kid, then
          drops it from apps.extra.

DRY_RUN=1 is the default for install/remove (AGENTS.md rule 8): they
only print the plan. Pass --apply, or set DRY_RUN=0, to make it real.

  -h, --help  Show this help and exit.
EOF
}

# band_rank BAND -> its 0-based index in VALID_BANDS, or empty (and a
# non-zero exit) for an unknown band.
band_rank() {
  local b="$1" i=0
  for v in "${VALID_BANDS[@]}"; do
    [[ "$v" == "$b" ]] && {
      printf '%s\n' "$i"
      return 0
    }
    i=$((i + 1))
  done
  return 1
}

require_jq() { command -v jq >/dev/null 2>&1 || die "needs jq (not found on PATH)"; }

# --- the index -------------------------------------------------------------

# index_rows FILTER_EXTRA — jq rows (id, name, description, age,
# verificationStatus, repo), US-separated (ASCII 0x1f), for every
# .plugins[] entry matching category=="Kids", installAvailable==true,
# and FILTER_EXTRA (a jq boolean expression string, evaluated against
# each entry as `.`). Not tab-separated: bash's `read` collapses runs of
# an IFS-whitespace delimiter, so an entry with no `age` (an empty
# field) would shift every field after it. 0x1f is not IFS whitespace,
# so empty fields survive; it is stripped from values so it cannot
# forge one. Missing or unreadable index -> no rows, never an error
# (R-APPS-8's own "offline" framing: not-synced-yet is not a failure).
index_rows() {
  local filter_extra="$1"
  [[ -r "$INDEX" ]] || return 0
  jq -r --arg extra "$filter_extra" '
        (.plugins // [])
        | map(select(.category == "Kids" and (.installAvailable // false)))
        | map(select(($extra == "verified") as $needverified
              | if $needverified then (.verificationStatus == "verified") else true end))
        | sort_by(.name // .id)
        | .[]
        | [ (.id // ""), (.name // .id // ""), (.description // ""),
            (.age // ""), (.verificationStatus // "unverified"), (.repo // "") ]
        | map(tostring | gsub("\u001f"; " ") | gsub("\n"; " ") | gsub("\r"; " "))
        | join("\u001f")
    ' "$INDEX" 2>/dev/null || true
}

# index_entry_field ID FIELD -> that field of the one .plugins[] entry
# with this id (category Kids only), or nothing (empty, non-zero exit)
# if there is no such entry.
index_entry_field() {
  local id="$1" field="$2"
  [[ -r "$INDEX" ]] || return 1
  jq -r --arg id "$id" --arg field "$field" '
        (.plugins // []) | map(select(.id == $id and .category == "Kids"))[0]
        | if . == null then empty else (.[$field] // "") end
    ' "$INDEX" 2>/dev/null
}

# require_verified_kids_plugin ID -> dies unless ID is a verified,
# installable, category-Kids listing on the index — the one gate
# `install` never skips, no matter what `shelf` was asked to show.
require_verified_kids_plugin() {
  local id="$1" status avail repo
  [[ -r "$INDEX" ]] || die "no marketplace index at $INDEX yet (not synced) — nothing to install"
  status="$(index_entry_field "$id" verificationStatus || true)"
  [[ -n "$status" ]] || die "'$id' is not on the Kids shelf (unknown plugin id)"
  avail="$(index_entry_field "$id" installAvailable || true)"
  [[ "$avail" == "true" ]] || die "'$id' has no install command in the marketplace index"
  [[ "$status" == "verified" ]] || die "'$id' is not verified (status: $status) — install refuses unverified plugins (R-APPS-7)"
  repo="$(index_entry_field "$id" repo || true)"
  [[ -n "$repo" ]] || die "'$id' has no repository URL in the marketplace index"
  printf '%s\n' "$repo"
}

# --- shelf -------------------------------------------------------------

cmd_shelf() {
  local band="" all=0 json=0
  while (($#)); do
    case "$1" in
      --band)
        band="${2:?--band needs a value}"
        shift 2
        ;;
      --all)
        all=1
        shift
        ;;
      --json)
        json=1
        shift
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      *) die "shelf: unknown argument '$1'" ;;
    esac
  done
  if [[ -n "$band" ]]; then
    is_valid_band "$band" || die "shelf: unknown band '$band' (must be one of ${VALID_BANDS[*]})"
  fi
  require_jq

  if ((all)) && ((! json)); then
    echo "omarchy-kids-plugins: --all: showing unverified Kids listings too — install still refuses anything not verified"
  fi

  local filter_extra="verified"
  ((all)) && filter_extra="all"

  local rows
  rows="$(index_rows "$filter_extra")"

  local want_rank=""
  [[ -n "$band" ]] && want_rank="$(band_rank "$band")"

  # Band filtering happens here, once, for both output shapes: an
  # entry with no recorded age floor is always kept (I-6: an unknown
  # floor is not the same claim as "too old for this band").
  local id name desc age status repo row_rank
  local -a kept=()
  while IFS=$'\x1f' read -r id name desc age status repo; do
    [[ -n "$id" ]] || continue
    if [[ -n "$want_rank" && -n "$age" ]]; then
      row_rank="$(band_rank "$age" || true)"
      if [[ -n "$row_rank" ]] && ((row_rank > want_rank)); then continue; fi
    fi
    kept+=("$id"$'\x1f'"$name"$'\x1f'"$desc"$'\x1f'"$age"$'\x1f'"$status")
  done <<<"$rows"

  if ((json)); then
    if ((${#kept[@]} == 0)); then
      printf '[]\n'
      return 0
    fi
    printf '%s\n' "${kept[@]}" | jq -R -s '
            split("\n") | map(select(length > 0) | split("\u001f")) |
            map({id: .[0], name: .[1], description: .[2], age: .[3], verified: (.[4] == "verified")})
        '
    return 0
  fi

  if [[ -z "$rows" ]]; then
    echo "omarchy-kids-plugins: nothing on the shelf yet (index missing, not synced, or nothing matches)"
    return 0
  fi
  if ((${#kept[@]} == 0)); then
    printf '%-24s %-24s %-6s %-10s %s\n' ID NAME AGE VERIFIED DESCRIPTION
    echo "omarchy-kids-plugins: nothing on the shelf for band '$band'"
    return 0
  fi

  printf '%-24s %-24s %-6s %-10s %s\n' ID NAME AGE VERIFIED DESCRIPTION
  local line
  for line in "${kept[@]}"; do
    IFS=$'\x1f' read -r id name desc age status <<<"$line"
    printf '%-24s %-24s %-6s %-10s %s\n' "$id" "$name" "$age" "$status" "$desc"
  done
}

# --- install / remove ----------------------------------------------------

parse_kid_plugin_args() { # sets PLUGIN, KID; args: "$@" (after the verb)
  PLUGIN=""
  KID=""
  while (($#)); do
    case "$1" in
      --kid)
        KID="${2:?--kid needs a value}"
        shift 2
        ;;
      --apply)
        DRY_RUN=0
        shift
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      -*) die "unknown option '$1'" ;;
      *)
        if [[ -z "$PLUGIN" ]]; then PLUGIN="$1"; else die "unexpected argument '$1'"; fi
        shift
        ;;
    esac
  done
  [[ -n "$PLUGIN" ]] || die "needs a plugin id"
  [[ -n "$KID" ]] || die "needs --kid <kid>"
  [[ -f "$ETC/kids/$KID.conf" ]] || die "'$KID' is not a provisioned kid"
}

# edit_apps_extra KID ACTION(add|remove) ID — the same idempotent
# apps.extra edit bin/omarchy-kids-ask's apply_apps_extra makes, through
# omarchy-kids-conf (docs/conf.md: nothing else touches a kid's .conf
# directly) -- omarchy-kids-apps itself has no extra-editing verb to
# call instead. See docs/plugins.md's "Judgment calls".
edit_apps_extra() {
  local kid="$1" action="$2" id="$3" extra
  extra="$("$CONF_BIN" get "$kid" apps.extra 2>/dev/null || true)"
  local -a arr=() out=()
  IFS=',' read -ra arr <<<"$extra"
  local x
  for x in "${arr[@]+"${arr[@]}"}"; do
    [[ -n "$x" && "$x" != "$id" ]] && out+=("$x")
  done
  [[ "$action" == add ]] && out+=("$id")
  local IFS_SAVE="$IFS" joined
  IFS=,
  joined="${out[*]+"${out[*]}"}"
  IFS="$IFS_SAVE"
  run "$CONF_BIN" set "$kid" apps.extra "$joined"
}

cmd_install() {
  require_jq
  local PLUGIN KID
  parse_kid_plugin_args "$@"

  local repo
  repo="$(require_verified_kids_plugin "$PLUGIN")"
  [[ "$repo" == *.git ]] || repo="$repo.git"

  echo "omarchy-kids-plugins: installing '$PLUGIN' into $KID's own account"
  run runuser -l "$KID" -c "omarchy-plugin-add $(printf '%q' "$repo") --enable --yes"
  edit_apps_extra "$KID" add "$PLUGIN"
}

cmd_remove() {
  local PLUGIN KID
  parse_kid_plugin_args "$@"

  echo "omarchy-kids-plugins: removing '$PLUGIN' from $KID's own account"
  run runuser -l "$KID" -c "omarchy-plugin-remove $(printf '%q' "$PLUGIN") --yes"
  edit_apps_extra "$KID" remove "$PLUGIN"
}

# --- main --------------------------------------------------------------

main() {
  [[ $# -ge 1 ]] || {
    usage >&2
    exit 2
  }
  local cmd="$1"
  shift

  case "$cmd" in
    -h | --help)
      usage
      exit 0
      ;;
    shelf) cmd_shelf "$@" ;;
    install) cmd_install "$@" ;;
    remove) cmd_remove "$@" ;;
    *) die "unknown command: '$cmd' (see --help)" ;;
  esac
}

main "$@"
