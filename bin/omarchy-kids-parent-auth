#!/bin/bash
# omarchy:summary=Verify a candidate parent password against omarchy-kids-authd
# omarchy:hidden=true
# Thin pam_exec client for omarchy-kids-authd (R-SEC-2). Reads nothing from
# its own environment -- runs inside the kid's session (review S4). docs/authd.md.
set -euo pipefail

DIR="$(cd "$(/usr/bin/dirname "$(/usr/bin/readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
LIB="$DIR/lib"
[[ -f "$LIB/sock.sh" ]] || LIB=/usr/lib/omarchy-kids
# shellcheck source=lib/sock.sh
source "$LIB/sock.sh"

DEFAULT_SOCK="/run/omarchy-kids/auth.sock"

# Build-time only, empty in every shipped copy (docs/authd.md).
TEST_SOCKET_ROOT=""

if [[ -n "${PAM_TYPE:-}" && "$PAM_TYPE" != "auth" ]]; then
  exit 1
fi

# Its own check, not lib/kids.sh's: a PAM helper wants the smallest
# possible surface, so it sources only sock.sh.
is_root() { [[ "$(/usr/bin/id -u)" == "0" ]]; }

# socket_allowed PATH -- root may point anywhere; else only under the
# (normally-empty) test root. docs/authd.md.
socket_allowed() {
  is_root && return 0
  [[ "$1" == "$DEFAULT_SOCK" || -n "$TEST_SOCKET_ROOT" && "$1" == "$TEST_SOCKET_ROOT"/* ]]
}

SOCK="$DEFAULT_SOCK"
BOOTSTRAP=0

while (($#)); do
  case "$1" in
    --bootstrap) BOOTSTRAP=1 ;;
    --socket)
      shift
      [[ $# -gt 0 ]] || {
        echo "omarchy-kids-parent-auth: --socket needs a path" >&2
        exit 1
      }
      socket_allowed "$1" || {
        echo "omarchy-kids-parent-auth: --socket is root-only" >&2
        exit 1
      }
      SOCK="$1"
      ;;
    -h | --help)
      /bin/cat <<EOF
Usage: omarchy-kids-parent-auth [--bootstrap] [--socket PATH]

Reads one candidate password from stdin and asks omarchy-kids-authd
whether it is the parent's. Exit 0 means yes. --bootstrap asks authd to
verify the caller's own eligible parent account for the wizard's first run.

--socket is honoured for root only, and no environment variable is read
at all: this command runs inside a session whose environment and PATH
the kid owns (AGENTS.md, "The trust boundary").
EOF
      exit 0
      ;;
    *)
      echo "omarchy-kids-parent-auth: unknown argument '$1'" >&2
      exit 1
      ;;
  esac
  shift
done

# One line, not "until EOF" -- a caller that keeps stdin open would hang
# otherwise (seen live). docs/authd.md.
IFS= read -r candidate || true

if ((BOOTSTRAP)); then
  payload=$'BOOTSTRAP\n'"$candidate"$'\n'
else
  payload=$'VERIFY\n'"$candidate"$'\n'
fi
reply="$(kids_sock_request "$SOCK" "$payload")" || exit 2
candidate=""

[[ -n "$reply" ]] || exit 2
[[ "$reply" == ok* ]] && exit 0
exit 1
