#!/bin/bash
# omarchy:summary=Desktop notification for each new "Ask a parent" request (N-9)
# omarchy:hidden=true
# The parent's side, run by systemd --user (systemd/omarchy-kids-notify-watch.user.service):
# it reads the queue the parent's omarchy-parents group can read and posts one
# libnotify notification per open request, with Approve/Decline actions that run
# omarchy-kids-bar. It never decides anything and holds no privilege. The logic
# is lib/notify_watch.py; see docs/notify.md.
set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
LIB="$DIR/lib"
[[ -f "$LIB/kids.sh" ]] || LIB=/usr/lib/omarchy-kids
# shellcheck source=lib/kids.sh
source "$LIB/kids.sh"

SYSROOT=""
QUEUE_DIR="$SYSROOT/var/lib/omarchy-kids/queue"
STATE_FILE=""
BAR_BIN="$(kids_bin bar "$DIR")"

if [[ -z "$STATE_FILE" ]]; then
  STATE_FILE="${XDG_RUNTIME_DIR:-/tmp}/omarchy-kids-notify-watch.state"
fi

exec "$KIDS_PY" "$LIB/notify_watch.py" \
  --queue "$QUEUE_DIR" --state "$STATE_FILE" --bar "$BAR_BIN" "$@"
