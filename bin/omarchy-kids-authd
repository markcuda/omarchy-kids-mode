#!/usr/bin/env python3
# omarchy:summary=Verify a parent password and apply an approved "ask" request, over a root-only socket
# omarchy:hidden=true
"""omarchy-kids-authd -- the parent-password verifier (R-SEC-1, R-SEC-2).

A root, socket-activated oracle. Five request shapes, one per connection:

    VERIFY\n<password>\n               -> "ok" / "no"   (verify, R-SEC-2)
    BOOTSTRAP\n<password>\n           -> "ok" / "no"   (wizard bootstrap)
    GRANT <json-request>\n<password>\n -> "ok" / "no <reason>"
    DECIDE <json-frame>\n              -> "ok" / "no <reason>"  (a paired device, R-NOTIFY-4)
    PAIR <json-frame>\n                -> "ok" / "no <reason>"  (pair a device, R-NOTIFY-5)

The second is the *only* way an "Ask a grown-up" request is ever granted
on the spot (review S1): root verifies the parent's password here, checks
the connecting peer's uid against the request's own `kid` field
(SO_PEERCRED -- never what the client claims to be), runs it through
lib/ask.py's strict allowlist, and only then applies it as root. Nothing
a kid writes into a file is ever applied by anything. See docs/authd.md.

Stdlib only. Python 3.13+ dropped the `crypt` module, so this calls
libxcrypt directly through ctypes, which also gets us yescrypt support
for free (whatever crypt(3) on the box understands).
"""

from __future__ import annotations

import argparse
import ctypes
import grp
import hmac
import importlib.util
import json
import os
import pwd
import signal
import socket
import struct
import subprocess
import sys
import threading
import time

MAX_LINE = 512  # bytes; anything longer (or missing a newline) is "no"
CLIENT_TIMEOUT = 5.0  # seconds, per connection
LOCK_AFTER_3 = 30  # seconds
LOCK_AFTER_10 = 300  # seconds
DECAY_AFTER = 300  # seconds of quiet before a peer's miss count is forgiven
MAX_INFLIGHT = 16  # concurrent client threads; see accept loop (review §2.5)

DEFAULT_SOCKET = "/run/omarchy-kids/auth.sock"
DEFAULT_SHADOW = "/etc/shadow"
DEFAULT_MACHINE_CONF = "/etc/omarchy-kids/machine.conf"
DEFAULT_ETC = "/etc/omarchy-kids"
DEFAULT_LIB = "/usr/lib/omarchy-kids"
DEFAULT_ASK_BIN = "/usr/bin/omarchy-kids-ask"

GRANT_PREFIX = "GRANT "
BOOTSTRAP_PREFIX = "BOOTSTRAP"
VERIFY_PREFIX = "VERIFY"
# A device's signed decision (R-NOTIFY-4). One line: DECIDE <json>\n, where the
# json is {"record": {...}, "signature": "b64"}. Only the relay account may send
# it, and only root verifies and applies it. The decision always needs the
# "decide" scope; the scope is never taken from the (unsigned) frame.
DECIDE_PREFIX = "DECIDE "
# A parent pairs a device (R-NOTIFY-5). One line: PAIR <json>\n, where the json
# is {id, name, platform, sign_pub, box_pub, proof}. Only the relay may send it;
# root verifies the single-use pairing proof and registers the device.
PAIR_PREFIX = "PAIR "
MAX_DECIDE_LINE = 2048  # a max-shape decision with an escaped reply still fits
RELAY_USER = "omarchy-kids-relay"
DEFAULT_NONCE_LEDGER = "/var/lib/omarchy-kids/devices/nonces.json"
DEFAULT_DEVICES_BIN = "/usr/bin/omarchy-kids-devices"
DEFAULT_PAIRING_DIR = "/run/omarchy-kids/pairing"

_LIBCRYPT = None


def _libcrypt():
    """Load libxcrypt lazily, so --help and argument parsing work even where
    it is not present (e.g. developing on macOS)."""
    global _LIBCRYPT
    if _LIBCRYPT is None:
        lib = None
        for name in ("libcrypt.so.2", "libcrypt.so.1", "libcrypt.so"):
            try:
                lib = ctypes.CDLL(name)
                break
            except OSError:
                continue
        if lib is None:
            raise OSError("no libcrypt shared library found")
        lib.crypt.restype = ctypes.c_char_p
        lib.crypt.argtypes = [ctypes.c_char_p, ctypes.c_char_p]
        _LIBCRYPT = lib
    return _LIBCRYPT


def crypt_compare(candidate: bytes, hashed: bytes) -> bool:
    """True iff crypt(candidate, hashed) == hashed, compared in constant time."""
    result = _libcrypt().crypt(candidate, hashed)
    if result is None:
        return False
    return hmac.compare_digest(result, hashed)


def read_machine_conf_parent(path: str):
    """Read key=value lines and return the `parent` value, or None."""
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, _, value = line.partition("=")
                if key.strip() == "parent":
                    value = value.strip()
                    return value or None
    except OSError:
        return None
    return None


def read_shadow_hash(parent: str, shadow_path: str) -> "str | None":
    """Read the parent's hash fresh every time -- never cached (R-SEC-1)."""
    try:
        with open(shadow_path, "r", encoding="utf-8", errors="replace") as f:
            for line in f:
                fields = line.rstrip("\n").split(":")
                if len(fields) >= 2 and fields[0] == parent:
                    return fields[1]
    except OSError:
        return None
    return None


def check_password(candidate: bytes, parent: "str | None", shadow_path: str) -> bool:
    if not parent:
        return False
    hashed = read_shadow_hash(parent, shadow_path)
    if not hashed or hashed[0] in ("!", "*"):
        return False  # no hash, locked, or disabled account -- never matches
    try:
        return crypt_compare(candidate, hashed.encode("utf-8", errors="replace"))
    except OSError:
        return False  # libcrypt missing/broken -- fail closed, never crash the daemon


class RateLimiter:
    """Three misses -> 30s, ten -> 5min (R-SEC-1), counted *per peer uid*
    and decayed, not globally and forever.

    Global-and-permanent was review S7: the socket is world-connectable,
    so a kid looping wrong guesses locked the parent out of their own exit
    modal indefinitely. A kid can now only lock out their own uid, and the
    count decays once a lock window has passed with no further misses."""

    def __init__(self):
        self._by_uid = {}
        self._lock = threading.Lock()

    def _entry(self, uid: int):
        return self._by_uid.setdefault(uid, {"wrong": 0, "until": 0.0, "last": 0.0})

    def locked(self, uid: int) -> bool:
        with self._lock:
            return time.monotonic() < self._entry(uid)["until"]

    def record_wrong(self, uid: int):
        with self._lock:
            e = self._entry(uid)
            now = time.monotonic()
            # Decay: a quiet DECAY_AFTER window forgives the earlier misses,
            # so a lockout is always temporary even under a sustained attempt.
            if e["last"] and now - e["last"] > DECAY_AFTER:
                e["wrong"] = 0
            e["last"] = now
            e["wrong"] += 1
            if e["wrong"] >= 10:
                e["until"] = now + LOCK_AFTER_10
            elif e["wrong"] >= 3:
                e["until"] = now + LOCK_AFTER_3

    def record_correct(self, uid: int):
        with self._lock:
            self._by_uid.pop(uid, None)


def verify(candidate: bytes, parent: "str | None", shadow_path: str, limiter: RateLimiter, uid: int = -1) -> bool:
    if limiter.locked(uid):
        return False  # refuse outright; do not even look at the password
    ok = check_password(candidate, parent, shadow_path)
    if ok:
        limiter.record_correct(uid)
    else:
        limiter.record_wrong(uid)
    return ok


# --- who is asking (SO_PEERCRED), same shape as bin/omarchy-kids-wifid ------


def peer_uid(conn: socket.socket) -> int:
    """The connecting process's real uid, from the kernel -- never
    anything the client claims about itself. -1 where SO_PEERCRED does
    not exist (macOS dev boxes); a GRANT is refused outright there."""
    if not hasattr(socket, "SO_PEERCRED"):
        return -1
    try:
        creds = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
    except OSError:
        return -1
    _pid, uid, _gid = struct.unpack("3i", creds)
    return uid


def account_for_uid(uid: int) -> "str | None":
    try:
        return pwd.getpwuid(uid).pw_name
    except KeyError:
        return None


def is_eligible_parent(uid: int) -> bool:
    """True only for a non-root account in the wheel group."""
    if uid <= 0:
        return False
    account = account_for_uid(uid)
    if account is None:
        return False
    try:
        entry = pwd.getpwnam(account)
        wheel_gid = grp.getgrnam("wheel").gr_gid
        return wheel_gid in os.getgrouplist(account, entry.pw_gid)
    except (KeyError, OSError):
        return False


def verify_bootstrap(
    candidate: bytes,
    configured_parent: "str | None",
    shadow_path: str,
    limiter: RateLimiter,
    uid: int,
) -> bool:
    """Verify a wizard caller against that caller's own shadow entry."""
    account = account_for_uid(uid)
    if not is_eligible_parent(uid) or account is None:
        return False
    if configured_parent and configured_parent != account:
        return False
    return verify(candidate, account, shadow_path, limiter, uid)


# --- GRANT: the only on-the-spot approval path (review S1) ------------------


def load_ask_module(lib_dir: str):
    """lib/ask.py, by path -- the one home for the request allowlist."""
    spec = importlib.util.spec_from_file_location(
        "omarchy_kids_ask_lib", os.path.join(lib_dir, "ask.py")
    )
    if spec is None or spec.loader is None:
        raise OSError(f"no ask.py under {lib_dir}")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def load_devices_module(lib_dir: str):
    """lib/devices.py, by path -- the one home for device verification."""
    spec = importlib.util.spec_from_file_location(
        "omarchy_kids_devices_lib", os.path.join(lib_dir, "devices.py")
    )
    if spec is None or spec.loader is None:
        raise OSError(f"no devices.py under {lib_dir}")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def relay_uid(name: str = RELAY_USER) -> "int | None":
    """The uid of the relay account, or None where it is not set up.

    Fail closed: an unresolved relay account means no DECIDE is ever accepted.
    """
    try:
        return pwd.getpwnam(name).pw_uid
    except KeyError:
        return None


def check_grant(request: dict, uid: int, etc_dir: str, lib_dir: str):
    """None if root may apply this request, else a one-line reason.

    Order matters: everything that does not need the password is checked
    first, so a malformed or unauthorized request is refused without ever
    consulting the shadow file or spending a crypt(3)."""
    kid = request.get("kid")
    kind = request.get("kind")
    what = request.get("what")
    minutes = request.get("minutes")

    try:
        ask = load_ask_module(lib_dir)
    except OSError as exc:
        return f"cannot load the request allowlist: {exc}"

    reason = ask.validate_grant(kid, kind, what, minutes)
    if reason is not None:
        return reason

    if uid < 0:
        return "no peer credentials on this platform"
    account = account_for_uid(uid)
    if account is None:
        return f"no account for uid {uid}"
    if account != kid:
        # The whole of review S2: a kid may only ever grant themselves.
        return f"uid {uid} is '{account}', not '{kid}'"

    profile = os.path.join(etc_dir, "kids", f"{kid}.conf")
    if not os.path.isfile(profile):
        return f"'{kid}' is not a provisioned kid account"
    return None


def apply_grant(request: dict, ask_bin: str) -> "str | None":
    """Hand the validated request to omarchy-kids-ask's own root-side
    apply path -- the same apply_record `collect` and the panel use, so
    there is exactly one implementation of "do the thing"."""
    argv = [
        ask_bin, "apply-grant",
        "--kid", request["kid"],
        "--kind", request["kind"],
        "--what", request["what"],
    ]
    if request["kind"] == "time":
        argv += ["--minutes", str(int(request["minutes"]))]
    argv.append("--apply")
    try:
        result = subprocess.run(argv, capture_output=True, text=True, timeout=30, check=False)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return f"could not run {os.path.basename(ask_bin)}: {exc}"
    if result.returncode != 0:
        return (result.stderr.strip().splitlines() or ["apply failed"])[-1]
    return None


def handle_grant(header: str, password: bytes, conn: socket.socket, cfg, limiter: RateLimiter) -> bytes:
    uid = peer_uid(conn)
    try:
        request = json.loads(header[len(GRANT_PREFIX):])
    except ValueError:
        return b"no malformed request\n"
    if not isinstance(request, dict):
        return b"no malformed request\n"

    reason = check_grant(request, uid, cfg.etc, cfg.lib)
    if reason is not None:
        return f"no {reason}\n".encode("utf-8", errors="replace")

    if not verify(password, cfg.parent, cfg.shadow, limiter, uid):
        return b"no wrong password\n"

    reason = apply_grant(request, cfg.ask_bin)
    if reason is not None:
        return f"no {reason}\n".encode("utf-8", errors="replace")
    return b"ok\n"


def handle_bootstrap(password: bytes, conn: socket.socket, cfg, limiter: RateLimiter) -> bytes:
    uid = peer_uid(conn)
    if verify_bootstrap(password, cfg.parent, cfg.shadow, limiter, uid):
        return b"ok\n"
    return b"no\n"


def handle_verify(password: bytes, conn: socket.socket, cfg, limiter: RateLimiter) -> bytes:
    if verify(password, cfg.parent, cfg.shadow, limiter, peer_uid(conn)):
        return b"ok\n"
    return b"no\n"


def handle_pair(header: str, conn: socket.socket, cfg) -> bytes:
    """A parent pairs a device (R-NOTIFY-5): the relay presents the frame, root
    verifies the single-use proof against the pairing record, and registers the
    device through omarchy-kids-devices. A missing record, an expired one, a
    wrong proof or a non-relay caller is refused."""
    if cfg.devices is None:
        return b"no devices unavailable\n"
    if cfg.relay_uid is None or peer_uid(conn) != cfg.relay_uid:
        return b"no not the relay\n"
    try:
        frame = json.loads(header[len(PAIR_PREFIX):])
        pair_id = frame["id"]
        name = frame["name"]
        platform = frame["platform"]
        sign_pub = frame["sign_pub"]
        box_pub = frame["box_pub"]
        proof = frame["proof"]
    except (ValueError, KeyError, TypeError):
        return b"no malformed\n"
    values = (pair_id, name, platform, sign_pub, box_pub, proof)
    if not all(isinstance(value, str) for value in values):
        return b"no malformed\n"
    now = int(time.time())
    # Read, register and consume under one lock: the record is burned only once
    # the device is really registered (review -- a failure at add must not eat
    # the parent's pairing window), and a second connection cannot slip in.
    with cfg.devices.pairing_lock(cfg.pairing_dir):
        record, reason = cfg.devices.read_pairing(cfg.pairing_dir, pair_id, now)
        if record is None:
            return b"no " + reason.encode("utf-8", "replace") + b"\n"
        if not cfg.devices.check_pairing_proof(record, proof, name, sign_pub, box_pub):
            return b"no bad-proof\n"
        scopes = record.get("scopes")
        if not isinstance(scopes, str) or not scopes:
            scopes = "decide,act"
        argv = [
            cfg.devices_bin,
            "add",
            "--id",
            pair_id,
            "--name",
            name,
            "--platform",
            platform,
            "--sign-pub",
            sign_pub,
            "--box-pub",
            box_pub,
            "--scopes",
            scopes,
            "--by",
            "pair",
            "--apply",
        ]
        try:
            proc = subprocess.run(argv, capture_output=True, timeout=30)
        except (OSError, subprocess.TimeoutExpired):
            return b"no apply failed\n"
        if proc.returncode != 0:
            return b"no apply failed\n"
        cfg.devices.consume_pairing(cfg.pairing_dir, pair_id)
    return b"ok\n"


def handle_decide(header: str, conn: socket.socket, cfg) -> bytes:
    """A paired device's signed decision, verified and applied as root.

    R-NOTIFY-4: only the relay account may present it, the signature is
    verified against the root-owned device key, and the decision is then
    applied through omarchy-kids-ask (which itself refuses an already-decided
    record). The relay never decides (R-NOTIFY-2).
    """
    if cfg.devices is None or cfg.ledger is None:
        return b"no devices unavailable\n"
    if cfg.relay_uid is None or peer_uid(conn) != cfg.relay_uid:
        return b"no not the relay\n"
    try:
        frame = json.loads(header[len(DECIDE_PREFIX):])
        record = frame["record"]
        signature = frame["signature"]
    except (ValueError, KeyError, TypeError):
        return b"no malformed\n"
    # A DECIDE always needs the "decide" scope. It is not read from the frame:
    # an unsigned scope would let a decide-less device pick its own check.
    ok, reason = cfg.devices.verify_decision(
        cfg.etc, cfg.ledger, record, signature, int(time.time()), "decide"
    )
    if not ok:
        return b"no " + reason.encode("utf-8", "replace") + b"\n"
    action = "approve" if record.get("decision") == "approve" else "decline"
    argv = [
        cfg.ask_bin,
        action,
        str(record.get("request_id", "")),
        "--by",
        f"device:{record.get('device_id', '')}",
        "--apply",
    ]
    try:
        proc = subprocess.run(argv, capture_output=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return b"no apply failed\n"
    if proc.returncode != 0:
        return b"no apply failed\n"
    return b"ok\n"


def read_candidate_line(
    conn: socket.socket, buf: bytearray, max_line: int = MAX_LINE
) -> "tuple[bytes | None, bool]":
    """Read one line and flag malformed frames separately from missing lines."""
    while b"\n" not in buf:
        try:
            chunk = conn.recv(4096)
        except (socket.timeout, OSError):
            return None, False
        if not chunk:
            return None, len(buf) > max_line  # closed before sending a full line
        buf += chunk
        if len(buf) > max_line * 2:
            return None, True
    line, _, rest = bytes(buf).partition(b"\n")
    buf[:] = rest
    if len(line) > max_line:
        return None, True
    return line, False


def handle_client(conn: socket.socket, cfg, limiter: RateLimiter, slot=None):
    conn.settimeout(CLIENT_TIMEOUT)
    buf = bytearray()
    try:
        first, _first_malformed = read_candidate_line(conn, buf, MAX_DECIDE_LINE)
        if first is None:
            reply = b"no\n"
        else:
            header = first.decode("utf-8", errors="replace")
            if header.startswith(GRANT_PREFIX):
                # Two-line form: the request, then the parent's password.
                # Only read a second line for a GRANT, so the plain verify
                # path still answers the instant its one line arrives.
                password, malformed = read_candidate_line(conn, buf)
                if password is None:
                    reply = b"no\n" if malformed else b"no missing password\n"
                else:
                    reply = handle_grant(header, password, conn, cfg, limiter)
            elif header in (BOOTSTRAP_PREFIX, VERIFY_PREFIX):
                password, malformed = read_candidate_line(conn, buf)
                if password is None:
                    reply = b"no\n" if malformed else b"no missing password\n"
                elif header == BOOTSTRAP_PREFIX:
                    reply = handle_bootstrap(password, conn, cfg, limiter)
                else:
                    reply = handle_verify(password, conn, cfg, limiter)
            elif header.startswith(DECIDE_PREFIX):
                # One line: the signed decision carries its own signature.
                reply = handle_decide(header, conn, cfg)
            elif header.startswith(PAIR_PREFIX):
                # One line: the pairing proof carries its own secret.
                reply = handle_pair(header, conn, cfg)
            else:
                reply = b"no\n"
        try:
            conn.sendall(reply)
        except OSError:
            pass
    except Exception:  # noqa: BLE001 -- never let a bad client kill the daemon
        pass
    finally:
        try:
            conn.close()
        except OSError:
            pass
        if slot is not None:
            slot.release()


def get_systemd_socket() -> "socket.socket | None":
    """sd_listen_fds(3), the minimum viable version: fd 3 is ours if
    LISTEN_PID matches us and LISTEN_FDS is at least 1."""
    listen_pid = os.environ.get("LISTEN_PID")
    listen_fds = os.environ.get("LISTEN_FDS")
    os.environ.pop("LISTEN_PID", None)
    os.environ.pop("LISTEN_FDS", None)
    os.environ.pop("LISTEN_FDNAMES", None)
    if not listen_pid or not listen_fds:
        return None
    try:
        if int(listen_pid) != os.getpid() or int(listen_fds) < 1:
            return None
    except ValueError:
        return None
    return socket.socket(socket.AF_UNIX, socket.SOCK_STREAM, fileno=3)


def bind_unix_socket(path: str) -> socket.socket:
    directory = os.path.dirname(path)
    if directory and not os.path.isdir(directory):
        os.makedirs(directory, mode=0o755, exist_ok=True)
    if os.path.exists(path):
        os.unlink(path)
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.bind(path)
    os.chmod(path, 0o666)  # matches the .socket unit's SocketMode
    return sock


def parse_args(argv):
    parser = argparse.ArgumentParser(
        prog="omarchy-kids-authd",
        description="Root verifier for the parent's password (R-SEC-1).",
    )
    parser.add_argument("--socket", default=DEFAULT_SOCKET, help="Unix socket path to listen on")
    parser.add_argument("--parent", default=None, help="Parent login name (overrides machine.conf)")
    parser.add_argument("--shadow", default=DEFAULT_SHADOW, help="Path to the shadow file")
    parser.add_argument(
        "--machine-conf",
        default=DEFAULT_MACHINE_CONF,
        help="Path to machine.conf (key=value; reads 'parent=')",
    )
    parser.add_argument("--etc", default=DEFAULT_ETC, help="Path to /etc/omarchy-kids (GRANT: the kid registry)")
    parser.add_argument("--lib", default=DEFAULT_LIB, help="Directory holding ask.py (GRANT: the request allowlist)")
    parser.add_argument("--ask-bin", default=DEFAULT_ASK_BIN, help="Path to omarchy-kids-ask (GRANT: applies the request)")
    parser.add_argument(
        "--devices-bin",
        default=DEFAULT_DEVICES_BIN,
        help="Path to omarchy-kids-devices (PAIR: registers the device)",
    )
    parser.add_argument(
        "--pairing-dir",
        default=DEFAULT_PAIRING_DIR,
        help="Path to the single-use pairing records (PAIR)",
    )
    parser.add_argument(
        "--nonce-ledger",
        default=DEFAULT_NONCE_LEDGER,
        help="Path to the device-decision nonce ledger (DECIDE: replay refusal)",
    )
    parser.add_argument(
        "--relay-user",
        default=RELAY_USER,
        help="Account whose uid may present a DECIDE frame (the LAN relay)",
    )
    return parser.parse_args(argv)


class Config:
    """Everything a client handler needs, with parent read per request."""

    def __init__(self, args):
        self.parent_override = args.parent
        self.machine_conf = args.machine_conf
        self.shadow = args.shadow
        self.etc = args.etc
        self.lib = args.lib
        self.ask_bin = args.ask_bin
        self.devices_bin = args.devices_bin
        self.pairing_dir = args.pairing_dir
        self.nonce_ledger = args.nonce_ledger
        # Filled in by main() for the DECIDE path; None means fail closed.
        self.devices = None
        self.ledger = None
        self.relay_uid = None

    @property
    def parent(self):
        # Apply may write parent= after socket activation starts this daemon.
        return self.parent_override or read_machine_conf_parent(self.machine_conf)


def main(argv=None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)
    cfg = Config(args)
    limiter = RateLimiter()

    # The DECIDE path needs lib/devices.py and a shared nonce ledger. A missing
    # module or ledger leaves cfg.devices None, so every DECIDE fails closed.
    try:
        cfg.devices = load_devices_module(cfg.lib)
        cfg.ledger = cfg.devices.NonceLedger(cfg.nonce_ledger)
    except OSError:
        cfg.devices = None
        cfg.ledger = None
    cfg.relay_uid = relay_uid(args.relay_user)

    sock = get_systemd_socket()
    owns_socket_file = False
    socket_path = args.socket
    if sock is None:
        sock = bind_unix_socket(args.socket)
        owns_socket_file = True
    sock.listen(5)
    inflight = threading.Semaphore(MAX_INFLIGHT)

    def _terminate(signum, frame):  # noqa: ARG001
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, _terminate)
    signal.signal(signal.SIGINT, _terminate)

    try:
        while True:
            try:
                conn, _addr = sock.accept()
            except OSError:
                break
            # One thread per client (review S7): a peer that holds a
            # connection open no longer serializes everyone else's
            # verification behind it. The limiter is the only shared
            # state and takes its own lock.
            #
            # Capped, though (review §2.5): the socket is 0666, so a kid
            # looping `socat - UNIX-CONNECT:...` without sending a line
            # would otherwise spawn root threads until Python refuses to
            # make another and the unit dies -- taking the exit modal and
            # every GRANT with it. Over the cap, the connection is
            # answered "busy" and closed on this thread instead.
            if not inflight.acquire(blocking=False):
                try:
                    conn.sendall(b"no busy\n")
                except OSError:
                    pass
                finally:
                    conn.close()
                continue
            threading.Thread(
                target=handle_client, args=(conn, cfg, limiter, inflight), daemon=True
            ).start()
    finally:
        sock.close()
        if owns_socket_file:
            try:
                os.unlink(socket_path)
            except OSError:
                pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
