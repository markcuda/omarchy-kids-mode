#!/bin/bash
# omarchy:summary=Walk a parent through provisioning the first kid
# omarchy:args=[--dry-run] [--apply]
# The parent wizard's Easy path: one screen at a time, Appendix A, ending in Apply (SPEC.md R-WIZ-1..9).
# See docs/wizard.md for the full screen list, the answers-file format tests drive it with, and every env var.
set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
LIB="$DIR/lib"
[[ -f "$LIB/conf.sh" ]] || LIB=/usr/lib/omarchy-kids
# shellcheck source=lib/sock.sh
source "$LIB/sock.sh"
# shellcheck source=lib/conf.sh
source "$LIB/conf.sh"
# shellcheck source=lib/tui.sh
source "$LIB/tui.sh"
# theme_current_name/theme_list_installed (issue #53).
# shellcheck source=lib/theme.sh
source "$LIB/theme.sh"
# shellcheck source=lib/wizard-advanced.sh
source "$LIB/wizard-advanced.sh"
# shellcheck source=lib/kids.sh
source "$LIB/kids.sh"

SHARE="${OMARCHY_KIDS_SHARE:-/usr/share/omarchy-kids}"

CONF_BIN="$(kids_bin conf "$DIR")"
PARENT_AUTH_BIN="$(kids_bin parent-auth "$DIR")"
PROVISION_BIN="$(kids_bin provision "$DIR")"
WEB_BIN="$(kids_bin web "$DIR")"
ASSERT_BIN="$(kids_bin assert "$DIR")"
SESSION_BIN="$(kids_bin session "$DIR")"
APPS_BIN="$(kids_bin apps "$DIR")"
PYHELPER="$LIB/conf.py"

# The verifier socket is a constant: a kid may not point a password
# check anywhere (AGENTS.md, "The trust boundary").
AUTH_SOCK=/run/omarchy-kids/auth.sock
SETUP_LOG="${OMARCHY_KIDS_SETUP_LOG:-/var/log/omarchy-kids/setup.log}"
# The parent's own login name, written into machine.conf's parent= by
# Apply's first step (issue #46) -- docs/wizard.md.
INVOKING_USER="$(id -un)"

# Interactive: a human's own button press is the confirmation, so the
# default is a real run (review §1.5, docs/wizard.md).
if launched_by_a_human; then
  DRY_RUN="${DRY_RUN:-0}"
else
  DRY_RUN="${DRY_RUN:-1}"
fi

TOTAL_STEPS=15

die() {
  echo "omarchy-kids-wizard: $1" >&2
  exit "${2:-2}"
}

usage() {
  cat <<EOF
Usage: omarchy-kids-wizard [--dry-run] [--help]

Walks a parent through adding one kid, screen by screen (SPEC.md
Appendix A): parent password, name, face, age band, Simple or Advanced,
web, screen time, apps, Wi-Fi, desktop level, the kid's password, a
plain-words summary, then Apply with a progress dashboard and a safety
check. Run it directly, or as 'omarchy-kids wizard'. See docs/wizard.md.

  --dry-run   Print every command Apply would run instead of running it.
              Walked by a human (a terminal, or the Kids Mode app entry)
              Apply is real -- pressing Apply is the confirmation. Without
              a terminal (a test, a script, CI) the default is a preview.
  --apply     Make Apply real (same as DRY_RUN=0).
  -h, --help  Show this help and exit.
EOF
}

for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=1 ;;
    --apply) DRY_RUN=0 ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: '$arg' (see --help)"
      ;;
  esac
done

# --- small helpers -----------------------------------------------------

# band_field BAND KEY — lib/kids.sh's kids_band_field, this command's own
# error message (review §2.7).
band_field() {
  kids_band_field "$CONF_BIN" "$@" || die "could not read band '$1' defaults from $CONF_BIN"
}

# pack_field BAND KEY — every value of a `key = "value"` line in that
# band's pack TOML, one per line (AGENTS.md Appendix C).
pack_field() {
  local band="$1" key="$2"
  local pack="$SHARE/packs/$band.toml"
  [[ -f "$pack" ]] || return 0
  sed -n "s/^${key} = \"\\(.*\\)\"\$/\\1/p" "$pack"
}

# app_label_for BAND ID — one app's label via lib/conf.py's pack-app;
# falls back to the raw id.
app_label_for() {
  local band="$1" id="$2" out
  out="$("$KIDS_PY" "$PYHELPER" pack-app "$SHARE/packs/$band.toml" "$id" 2>/dev/null)" || {
    printf '%s\n' "$id"
    return
  }
  printf '%s\n' "${out%%$'\t'*}"
}

# repo_and_aur_pkgs BAND [COMMA_IDS] — sets REPO_PKGS=()/AUR_PKGS=() (the
# "aur:" prefix stripped). No COMMA_IDS: the whole band pack (R-WIZ-4,
# docs/wizard.md). With COMMA_IDS: only those ids' packages.
REPO_PKGS=()
AUR_PKGS=()
repo_and_aur_pkgs() {
  REPO_PKGS=()
  AUR_PKGS=()
  local band="$1" filter="${2:-}"
  _bucket_pkg() {
    case "$1" in
      aur:*) AUR_PKGS+=("${1#aur:}") ;;
      *) REPO_PKGS+=("$1") ;;
    esac
  }
  if [[ -z "$filter" ]]; then
    local p
    while IFS= read -r p; do
      [[ -z "$p" ]] && continue
      _bucket_pkg "$p"
    done < <(pack_field "$band" pkg)
  else
    local id out pkg oldifs="$IFS"
    IFS=,
    for id in $filter; do
      IFS="$oldifs"
      [[ -z "$id" ]] && continue
      out="$("$KIDS_PY" "$PYHELPER" pack-app "$SHARE/packs/$band.toml" "$id" 2>/dev/null)" || continue
      pkg="$(printf '%s\n' "$out" | cut -f2)"
      [[ -n "$pkg" ]] && _bucket_pkg "$pkg"
    done
    IFS="$oldifs"
  fi
}

# run_priv CMD... — print (DRY_RUN=1) or run under sudo. docs/wizard.md.
run_priv() {
  if [[ "$DRY_RUN" == "1" ]]; then
    printf '  [dry-run] sudo'
    printf ' %q' "$@"
    printf '\n'
  else
    sudo -n "$@"
  fi
}

# run_priv_stdin CMD... — like run_priv, forwarding stdin (a password);
# DRY_RUN drains and discards it, never echoes (AGENTS.md).
run_priv_stdin() {
  if [[ "$DRY_RUN" == "1" ]]; then
    printf '  [dry-run] sudo'
    printf ' %q' "$@"
    printf '\n'
    cat >/dev/null
  else
    sudo -n "$@"
  fi
}

# run_priv_as USER CMD... — run_priv, but as USER.
run_priv_as() {
  local user="$1"
  shift
  if [[ "$DRY_RUN" == "1" ]]; then
    printf '  [dry-run] sudo -u %q' "$user"
    printf ' %q' "$@"
    printf '\n'
  else
    sudo -n -u "$user" "$@"
  fi
}

# --- prefetch (R-WIZ-4): starts on the age screen, never blocks. Only
# works with a cached sudo credential (from A2); otherwise skips and says
# so -- Apply's install step works either way. docs/wizard.md "Prefetch".
PREFETCH_PID=""
SUDO_KEEPER_PID=""
start_prefetch() {
  local band="$1"
  repo_and_aur_pkgs "$band"
  ((${#REPO_PKGS[@]})) || return 0
  if [[ "$DRY_RUN" == "1" ]]; then
    printf '  [dry-run] sudo -n pacman -Sw --noconfirm'
    printf ' %q' "${REPO_PKGS[@]}"
    printf ' (background, started now, never blocks)\n'
    return 0
  fi
  if sudo -n true 2>/dev/null; then
    sudo -n pacman -Sw --noconfirm "${REPO_PKGS[@]}" </dev/null >/dev/null 2>&1 &
    PREFETCH_PID=$!
  else
    echo "  (starter-pack download will start at Apply instead of now — see docs/wizard.md)" >&2
  fi
}
stop_prefetch() {
  if [[ -n "$PREFETCH_PID" ]]; then
    kill "$PREFETCH_PID" >/dev/null 2>&1 || true
  fi
  PREFETCH_PID=""
}
stop_sudo_keeper() {
  if [[ -n "$SUDO_KEEPER_PID" ]]; then
    kill "$SUDO_KEEPER_PID" >/dev/null 2>&1 || true
    wait "$SUDO_KEEPER_PID" >/dev/null 2>&1 || true
  fi
  SUDO_KEEPER_PID=""
}
# shellcheck disable=SC2329 # invoked by the EXIT trap
cleanup() {
  stop_prefetch
  stop_sudo_keeper
  PARENT_PASSWORD=""
}
trap cleanup EXIT

# --- validators ----------------------------------------------------------

# validate_kid_name CANDIDATE — letters, spaces, and hyphens, 1-24 chars
# (issue #19's brief); printed on failure, redraws the screen (lib/tui.sh's
# VALIDATOR contract).
validate_kid_name() {
  local name="$1"
  if [[ -z "$name" ]]; then
    echo "Type a name — a first name or nickname is fine."
    return 1
  fi
  if ((${#name} > 24)); then
    echo "Keep it to 24 characters or fewer."
    return 1
  fi
  if [[ ! "$name" =~ ^[A-Za-z][A-Za-z\ -]*$ ]]; then
    echo "Letters, spaces, and hyphens only, please."
    return 1
  fi
  return 0
}

PASSWORD_MIN=4
validate_kid_password() {
  local pw="$1"
  if ((${#pw} < PASSWORD_MIN)); then
    echo "That needs to be at least $PASSWORD_MIN characters."
    return 1
  fi
  return 0
}

# establish_privilege CANDIDATE — warm sudo only after authd accepted it.
establish_privilege() {
  local candidate="$1"
  printf '%s\n' "$candidate" | sudo -S -p '' -v >/dev/null 2>&1
  sudo -n -v >/dev/null 2>&1
}

# Keep the A2 ticket alive while the wizard is open. A failed refresh is
# checked again before each privileged Apply step and sends the parent back to A2.
start_sudo_keeper() {
  [[ "$DRY_RUN" == "1" ]] && return 0
  stop_sudo_keeper
  (
    while sleep 60; do
      sudo -n -v >/dev/null 2>&1 || exit 1
    done
  ) </dev/null >/dev/null 2>&1 &
  SUDO_KEEPER_PID=$!
}

# verify_parent_password CANDIDATE — authd decides identity; sudo only
# receives the accepted candidate to establish a noninteractive ticket.
verify_parent_password() {
  local candidate="$1"
  PARENT_AUTH_ERROR=wrong
  if ! printf '%s\n' "$candidate" | "$PARENT_AUTH_BIN" --bootstrap --socket "$AUTH_SOCK"; then
    local rc=${PIPESTATUS[1]}
    if ((rc == 2)); then
      PARENT_AUTH_ERROR=unavailable
    fi
    return 1
  fi
  if ! establish_privilege "$candidate"; then
    PARENT_AUTH_ERROR=privilege
    return 1
  fi
  start_sudo_keeper
  return 0
}

friendly_wifi_mode() {
  case "$1" in
    parent) echo "Ask me first" ;;
    helper) echo "On their own, safely" ;;
    *) echo "$1" ;;
  esac
}

# maybe_override KEY VALUE BAND_DEFAULT — writes only when it differs (R-BAND-2).
maybe_override() {
  local key="$1" value="$2" band_default="$3"
  [[ "$value" == "$band_default" ]] && return 0
  run_priv "$CONF_BIN" set "$ACCOUNT" "$key" "$value"
}

# apps_pick_walk STEP TOTAL — yes/no per app, one at a time; sets
# $TUI_REPLY to the comma-joined yes ids. Shared by A9 and the Advanced
# checklist's apps row (docs/wizard.md).
apps_pick_walk() {
  local step="$1" total="$2" id raw_id label chosen=() body ids rc
  local -a ids_array=()
  ids="$(pack_field "$BAND" id)" || return 2
  while IFS= read -r raw_id; do
    [[ -z "$raw_id" ]] && continue
    [[ "$raw_id" =~ ^[a-z0-9][a-z0-9-]*$ ]] || return 2
    ids_array+=("$raw_id")
  done <<<"$ids"
  # Iterate the validated capture so each interactive confirm retains the
  # caller's terminal stdin.
  for id in "${ids_array[@]}"; do
    label="$(app_label_for "$BAND" "$id")"
    # shellcheck disable=SC2034 # read by tui_screen_confirm via nameref-by-name
    body=("Include $label in $DISPLAY_NAME's starter apps?")
    tui_screen_confirm "$label" "$step" "$total" 0 "" body "Yes" "No"
    rc=$?
    ((rc == 130)) && return 130
    ((rc > 1)) && return "$rc"
    [[ "$TUI_REPLY" == yes ]] && chosen+=("$id")
  done
  local IFS=,
  TUI_REPLY="${chosen[*]}"
  return 0
}

# --- thin dispatch: one lib/wizard-<area>.sh per screen group ---------------

# shellcheck source=lib/wizard-screens.sh
source "$LIB/wizard-screens.sh"
# shellcheck source=lib/wizard-apply.sh
source "$LIB/wizard-apply.sh"

# --- driver: step forward, Esc back, Ctrl+C leave (nothing changed) ----

DISPLAY_NAME=""
ACCOUNT=""
AVATAR="fox"
BAND=""
MODE="simple"
WEB_MODE=""
BUDGET_MIN=""
BUDGET_MIN_WEEKEND=""
LIGHTS_OUT=""
LIGHTS_OUT_WEEKEND=""
APPS_MODE="pack"
ALLOWLIST_IDS=""
WIFI_MODE=""
LEVEL=""
# The four Advanced-only cells Simple never shows a screen for (issue #20).
DNS_MODE=""
SITES=""
MENU_MODE=""
HISTORY_VISIBLE=""
NO_PASSWORD=0
KID_PASSWORD=""
PARENT_PASSWORD=""
APPLY_OK=1
FAILED_STEP=""
APPLY_AUTH_EXPIRED=0

tui_init || exit $?

STEP=1
while ((STEP <= TOTAL_STEPS)); do
  rc=0
  # 1=Esc back, 130=Ctrl+C leave is data for the case below, not a failure.
  set +e
  case "$STEP" in
    1) screen_welcome ;;
    2) screen_parent_password ;;
    3) screen_name ;;
    4) screen_face ;;
    5) screen_band ;;
    6) screen_mode ;;
    7)
      # Advanced's checklist stands in for A7-A11 at once (issue #20).
      if [[ "$MODE" == advanced ]]; then
        screen_advanced_checklist 7 "$TOTAL_STEPS"
      else
        screen_web
      fi
      ;;
    8) screen_time ;;
    9) screen_apps ;;
    10) screen_wifi ;;
    11) screen_level ;;
    12) screen_password ;;
    13) screen_summary ;;
    14) screen_apply ;;
    15) screen_done ;;
  esac
  rc=$?
  set -e
  case "$rc" in
    0)
      if ((STEP == 7)) && [[ "$MODE" == advanced ]]; then
        STEP=12 # "Done customizing": skip Simple's A7-A11 entirely
      else
        STEP=$((STEP + 1))
      fi
      ;;
    1)
      if ((STEP == 14 && APPLY_AUTH_EXPIRED)); then
        stop_sudo_keeper
        PARENT_PASSWORD=""
        APPLY_AUTH_EXPIRED=0
        STEP=2
      elif ((STEP == 1)); then
        echo "Nothing to go back to — leaving, nothing changed." >&2
        exit 1
      else
        if ((STEP == 7)) && [[ "$MODE" == advanced ]]; then
          STEP=6 # Esc out of the checklist's own row list: back to A6
        else
          STEP=$((STEP - 1))
        fi
      fi
      ;;
    130)
      stop_prefetch
      echo "Left setup. Nothing changed." >&2
      exit 130
      ;;
    *)
      die "screen at step $STEP failed unexpectedly" 2
      ;;
  esac
done

exit 0
