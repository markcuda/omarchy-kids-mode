#!/bin/bash
# omarchy:summary=Start the kid session surfaces from its validated manifest
# omarchy:hidden=true
# omarchy:args=[--help]
# Runs once per kid Hyprland session (exec-once/hl.on); the validated manifest is the only session input.
set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
LIB="$DIR/lib"
[[ -f "$LIB/kids.sh" ]] || LIB=/usr/lib/omarchy-kids
# shellcheck source=lib/kids.sh
source "$LIB/kids.sh"
TIME_BIN="$(kids_bin time "$DIR")"
SESSION_BIN="$DIR/bin/omarchy-kids-session"

# Build-time constants: a kid may edit neither the manifest path nor the launcher code.
SHARE=/usr/share/omarchy-kids
RUN="/run/user/$(id -u)/omarchy-kids"
QUICKSHELL_BIN=/usr/bin/quickshell
JQ_BIN=/usr/bin/jq

# Appends to the same per-session log omarchy-kids-session writes to, so the
# R-DESK-2 preflight and this file's tile-building share one timeline.
LOG_FILE="$RUN/session-$(id -u).log"
log() { printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*" >>"$LOG_FILE" 2>/dev/null || true; }

usage() {
  cat <<EOF
Usage: omarchy-kids-session-start

Run from a Kids Mode Hyprland level config's exec-once (share/hyprland/
L1.lua, L2.lua, L3.lua). Reads the caller-bound validated session manifest,
then starts the Kids App grid (Level 1) or Omarchy's shell, menu-trimmed
(the Desktop mode, Level 3). A retired level = 2 profile still starts the old
simplified desktop.

  -h, --help  Show this help and exit.
EOF
}

for arg in "$@"; do
  case "$arg" in
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "omarchy-kids-session-start: unknown argument: '$arg'" >&2
      exit 2
      ;;
  esac
done

mkdir -p "$RUN" 2>/dev/null || true

# The caller-bound command validates the root-owned document before this parse.
if ! MANIFEST_JSON="$($SESSION_BIN --manifest 2>/dev/null)" || [[ -z "$MANIFEST_JSON" ]]; then
  echo "omarchy-kids-session-start: validated manifest unavailable" >&2
  exit 1
fi

# US (0x1f) separated, not tab: `.theme` is empty for a kid with no theme
# override (docs/theming.md), and tab is IFS whitespace, so bash `read`
# would collapse that empty field and shift every one after it. Read the
# trailing allowlist too, so it cannot be absorbed into the last field.
if ! MANIFEST_FIELDS="$($JQ_BIN -r '
  [.account, .band, (.level | tostring), .theme, .web,
   (.budget_min | tostring), (.budget_min_weekend | tostring),
   .lights_out, .lights_out_weekend, (.allowlist | join(","))]
  | map(tostring | gsub("\u001f"; " ") | gsub("\n"; " ") | gsub("\r"; " "))
  | join("\u001f")
' <<<"$MANIFEST_JSON")"; then
  echo "omarchy-kids-session-start: validated manifest unavailable" >&2
  exit 1
fi
IFS=$'\x1f' read -r ACCOUNT BAND LEVEL THEME WEB BUDGET_MIN BUDGET_MIN_WEEKEND \
  LIGHTS_OUT LIGHTS_OUT_WEEKEND _ALLOWLIST <<<"$MANIFEST_FIELDS"
# `.theme` may be empty (docs/theming.md: the kid follows the parent's); every
# other field must be present or the manifest is unusable.
[[ -n "$ACCOUNT" && -n "$BAND" && -n "$LEVEL" && -n "$WEB" &&
  -n "$BUDGET_MIN" && -n "$BUDGET_MIN_WEEKEND" && -n "$LIGHTS_OUT" &&
  -n "$LIGHTS_OUT_WEEKEND" ]] || {
  echo "omarchy-kids-session-start: validated manifest unavailable" >&2
  exit 1
}

log "manifest loaded for '$ACCOUNT': level=$LEVEL theme=$THEME web=$WEB budget=$BUDGET_MIN/$BUDGET_MIN_WEEKEND"
: >"$RUN/launcher-control" # the launcher polls this file; create it before the QML surface starts
export OMARCHY_KIDS_ACCOUNT="$ACCOUNT" OMARCHY_KIDS_LEVEL="$LEVEL" OMARCHY_KIDS_BAND="$BAND" \
  OMARCHY_KIDS_THEME="$THEME" OMARCHY_KIDS_WEB="$WEB" \
  OMARCHY_KIDS_BUDGET_MIN="$BUDGET_MIN" OMARCHY_KIDS_BUDGET_MIN_WEEKEND="$BUDGET_MIN_WEEKEND" \
  OMARCHY_KIDS_LIGHTS_OUT="$LIGHTS_OUT" OMARCHY_KIDS_LIGHTS_OUT_WEEKEND="$LIGHTS_OUT_WEEKEND" \
  OMARCHY_KIDS_LAUNCHER_CONTROL="$RUN/launcher-control"

case "$LEVEL" in
  1 | 2)
    EXEC_LINE=("$QUICKSHELL_BIN" -p "$SHARE/launcher/shell.qml")
    ;;
  3)
    # The exact command Omarchy's own default.hypr.autostart uses.
    EXEC_LINE=(/usr/bin/omarchy-launch-shell)
    ;;
  *)
    echo "omarchy-kids-session-start: unknown level '$LEVEL' for '$ACCOUNT'" >&2
    exit 1
    ;;
esac

if [[ "${OMARCHY_KIDS_SESSION_START_NO_EXEC:-0}" == "1" ]]; then
  printf '%s\n' "${EXEC_LINE[*]}"
  exit 0
fi

# Screen-time daemon (SPEC.md R-TIME-1..5), detached; never fatal. docs/time.md.
log "starting omarchy-kids-time daemon for '$ACCOUNT'"
"$TIME_BIN" daemon >/dev/null 2>&1 &
disown 2>/dev/null || true

exec "${EXEC_LINE[@]}"
