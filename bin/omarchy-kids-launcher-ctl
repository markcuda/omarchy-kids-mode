#!/bin/bash
# omarchy:summary=Tell the big-tile launcher to open or close from a Hyprland bind
# omarchy:hidden=true
# omarchy:args=<show|activate|log ID>
# Where the Level 1/2 Hyprland binds (share/hyprland/L1.lua, L2.lua) reach the big-tile launcher, so the
# Lua files never guess a socket path. See docs/launcher-ctl.md for the show/activate/log protocol.
set -euo pipefail

CONTROL="/run/user/$(id -u)/omarchy-kids/launcher-control"
LAUNCHES_LOG="/run/user/$(id -u)/omarchy-kids/launches.log"
TITLE="Omarchy Kids Launcher"

usage() {
  cat <<EOF
Usage: omarchy-kids-launcher-ctl <show|activate|log ID>

  show      Show the allowed-app launcher (Super+Home, Super+Space).
  activate  Tell the launcher to open its currently highlighted tile
            (Super+Enter).
  log ID    Record one Level 1 tile launch (R-DATA-1's "app launches").
            Appends "<timestamp> <id>" to this account's own runtime
            launches log; never touches the root-owned one directly.

Env:
  OMARCHY_KIDS_NOW               "YYYY-MM-DD HH:MM:SS" clock override for log (tests)

  -h, --help  Show this help and exit.
EOF
}

cmd_show() {
  mkdir -p "$(dirname "$CONTROL")"
  printf 'show %s-%s\n' "$$" "$RANDOM" >"$CONTROL"
  if command -v hyprctl >/dev/null 2>&1; then
    hyprctl dispatch "hl.dsp.focus({window=\"title:^${TITLE}\$\"})" >/dev/null 2>&1 || true
  fi
}

cmd_activate() {
  mkdir -p "$(dirname "$CONTROL")"
  # shell.qml diffs this file's full text against the last value it saw,
  # so the same word twice needs to look different -- hence the nonce.
  printf 'activate %s\n' "$(date +%s%N 2>/dev/null || date +%s)" >"$CONTROL"
}

cmd_log() {
  local id="${1:-}"
  [[ -n "$id" ]] || {
    echo "omarchy-kids-launcher-ctl: log needs an app id" >&2
    exit 2
  }
  local now
  # Naive local "YYYY-MM-DDTHH:MM:SS", one token -- docs/data.md.
  now="${OMARCHY_KIDS_NOW:-$(date '+%Y-%m-%d %H:%M:%S')}"
  now="${now/ /T}"
  mkdir -p "$(dirname "$LAUNCHES_LOG")" 2>/dev/null || true
  printf '%s %s\n' "$now" "$id" >>"$LAUNCHES_LOG" 2>/dev/null || true
}

[[ $# -ge 1 ]] || {
  usage >&2
  exit 2
}
case "$1" in
  -h | --help)
    usage
    exit 0
    ;;
  show) cmd_show ;;
  activate) cmd_activate ;;
  log)
    shift
    cmd_log "${1:-}"
    ;;
  *)
    echo "omarchy-kids-launcher-ctl: unknown command: '$1' (see --help)" >&2
    exit 2
    ;;
esac
