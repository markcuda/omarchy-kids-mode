#!/bin/bash
# omarchy:summary=Add a minute to today's screen-time ledger for every active kid
# omarchy:hidden=true
# omarchy:args=tick
# The ONLY thing that ever writes a kid's screen-time usage (SPEC.md R-TIME-1..2, Appendix F); root, run every 30 seconds.
# See lib/time.sh's header for the trust boundary this enforces, and docs/time.md for every env var.
set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
LIB="$DIR/lib"
[[ -f "$LIB/time.sh" ]] || LIB=/usr/lib/omarchy-kids
# shellcheck source=lib/kids.sh
source "$LIB/kids.sh"
# shellcheck source=lib/time.sh
source "$LIB/time.sh"
# shellcheck source=lib/data.sh
source "$LIB/data.sh"

ETC=/etc/omarchy-kids
SYSROOT=""
KIDS_DIR="$ETC/kids"
RUN_DIR="$SYSROOT/run/omarchy-kids"
STATUS_JSON="$RUN_DIR/status.json"
TIME_SYSROOT="$SYSROOT"
TIME_VARLIB="$SYSROOT/var/lib/omarchy-kids"
TIME_NOW_FILE="$SYSROOT/run/omarchy-kids/time/now"
TIME_CLOCK_FILE="$SYSROOT/run/omarchy-kids/time/monotonic"
EXIT_BIN="$(kids_bin exit "$DIR")"
# The notification relay exists only while a kid is live or a request is open
# (R-NOTIFY-1, N-7): this tick starts it, and the relay exits on its own.
RELAY_UNIT=omarchy-kids-relayd.service
RELAY_CERT="$ETC/relay/cert.pem"
RELAY_KEY="$ETC/relay/key.pem"
QUEUE_DIR="$SYSROOT/var/lib/omarchy-kids/queue"
PAIRING_DIR="$SYSROOT/run/omarchy-kids/pairing"
ASK_PY="$LIB/ask.py"

# How long a lock request gets to appear as LockedHint=yes before this tick
# records it failed. Tests substitute both (test/shell.d/tree.sh).
LOCK_VERIFY_TRIES=25
LOCK_VERIFY_INTERVAL=0.2

die() {
  echo "omarchy-kids-time-ledger: $1" >&2
  exit "${2:-2}"
}

usage() {
  cat <<'EOF'
Usage: omarchy-kids-time-ledger tick

Adds one minute to today's ledger for every kid whose session is
currently active, unlocked, and not paused (SPEC.md R-TIME-1..2), then
folds any new app-launch lines into every known kid's launches.log
(R-DATA-1; lib/data.sh). Root only. Meant to be run every 30 seconds by
systemd/omarchy-kids-time.timer, not by hand.

  -h, --help  Show this help and exit.
EOF
}

# session_prop ID PROP — one `loginctl show-session` property's value.
# Filters for "PROP=" rather than trusting single-line output, so a test
# stub printing every property regardless of -p still works.
session_prop() {
  local id="$1" prop="$2" out
  out="$(loginctl show-session "$id" -p "$prop" 2>/dev/null)" || return 1
  first_field "$prop" "$out"
}

# session_is_lockable ID — "yes" only for the account's own graphical
# session (Class=user, Type=wayland|x11). logind's Class=manager session is
# not a lock target and is not active time. A missing property or read
# failure is unknown, so it returns 1 and callers fail closed.
session_is_lockable() {
  local id="$1" class type
  class="$(session_prop "$id" Class)" || return 1
  [[ -n "$class" ]] || return 1
  [[ "$class" == user ]] || {
    printf 'no\n'
    return 0
  }
  type="$(session_prop "$id" Type)" || return 1
  [[ -n "$type" ]] || return 1
  case "$type" in
    wayland | x11) printf 'yes\n' ;;
    *) printf 'no\n' ;;
  esac
}

# active_kid_sessions — one account per line, deduplicated, for every kid
# with a session Active=yes/LockedHint=no right now.
active_kid_sessions() {
  local sessions line id user active locked kind seen=$'\n'
  sessions="$(loginctl list-sessions --no-legend 2>/dev/null)" || return 1
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    # loginctl list-sessions --no-legend: "SESSION UID USER SEAT [TTY]".
    id="$(awk '{print $1}' <<<"$line")"
    user="$(awk '{print $3}' <<<"$line")"
    [[ -n "$id" && -n "$user" ]] || continue
    is_known_kid "$KIDS_DIR" "$user" || continue
    [[ "$seen" == *$'\n'"$user"$'\n'* ]] && continue
    kind="$(session_is_lockable "$id")" || return 1
    [[ "$kind" == yes ]] || continue
    active="$(session_prop "$id" Active)" || return 1
    locked="$(session_prop "$id" LockedHint)" || return 1
    [[ "$active" == yes && "$locked" == no ]] || continue
    seen+="$user"$'\n'
    printf '%s\n' "$user"
  done <<<"$sessions"
}

# kid_session_ids ACCOUNT — active, unlocked, lockable sessions for ACCOUNT.
kid_session_ids() {
  local wanted="$1" sessions line id user active locked kind
  sessions="$(loginctl list-sessions --no-legend 2>/dev/null)" || return 1
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    id="$(awk '{print $1}' <<<"$line")"
    user="$(awk '{print $3}' <<<"$line")"
    [[ "$user" == "$wanted" ]] || continue
    kind="$(session_is_lockable "$id")" || return 1
    [[ "$kind" == yes ]] || continue
    active="$(session_prop "$id" Active)" || return 1
    locked="$(session_prop "$id" LockedHint)" || return 1
    [[ "$active" == yes && "$locked" == no ]] || continue
    printf '%s\n' "$id"
  done <<<"$sessions"
}

# kid_all_session_ids ACCOUNT — every logind session for ACCOUNT, including
# inactive or locked sessions. Finish terminates the account, so this is the
# matching existence check for re-entry after a successful finish.
kid_all_session_ids() {
  local wanted="$1" sessions line id user
  sessions="$(loginctl list-sessions --no-legend 2>/dev/null)" || return 1
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    id="$(awk '{print $1}' <<<"$line")"
    user="$(awk '{print $3}' <<<"$line")"
    [[ -n "$id" && "$user" == "$wanted" ]] || continue
    printf '%s\n' "$id"
  done <<<"$sessions"
}

# lock_kid_sessions SESSION_IDS — ask logind to lock each target and prove
# the lock engaged: loginctl exit 0 only means the request was delivered.
# Verified LockedHint=yes is the success signal; the grace deadline runs
# regardless (SPEC.md R-TIME-4, docs/specs/02-root-screen-time.md R-TIMEAUTH-4).
lock_kid_sessions() {
  local ids="$1" session_id status=0 try engaged
  while IFS= read -r session_id; do
    [[ -n "$session_id" ]] || continue
    if ! loginctl lock-session "$session_id" >/dev/null 2>&1; then
      status=1
      continue
    fi
    engaged=no
    for ((try = 0; try < LOCK_VERIFY_TRIES; try++)); do
      if [[ "$(session_prop "$session_id" LockedHint)" == yes ]]; then
        engaged=yes
        break
      fi
      sleep "$LOCK_VERIFY_INTERVAL"
    done
    if [[ "$engaged" == no ]]; then
      printf 'omarchy-kids-time-ledger: session %s did not report a lock\n' "$session_id" >&2
      status=1
    fi
  done <<<"$ids"
  return "$status"
}

# write_status_json — R-BAR-3, best-effort: never fails the tick.
write_status_json() {
  local now day weekend hm kid remaining paused live rows tmp active
  tmp=
  now="$(time_root_now)"
  hm="$(time_hm "$now")"
  IFS=$'\t' read -r day weekend <<<"$(time_logical_day "$now")" || return 0
  command -v jq >/dev/null 2>&1 || return 0
  install -d -m 0755 "$RUN_DIR" 2>/dev/null || return 0
  # One loginctl scan for every kid below, not one per kid.
  # Leave the last status intact when liveness is uncertain; writing every kid
  # as inactive would turn an observation failure into false parent guidance.
  active="$(active_kid_sessions)" || return 0
  rows="$(mktemp "$RUN_DIR/.status-rows.XXXXXX")" || return 0
  while IFS= read -r kid; do
    [[ -n "$kid" ]] || continue
    remaining="$(time_remaining_minutes "$kid" "$day" "$weekend" 2>/dev/null || echo 0)"
    paused="false"
    time_is_paused "$kid" && paused="true"
    live="false"
    while IFS= read -r live_kid; do
      [[ "$live_kid" == "$kid" ]] && live="true"
    done <<<"$active"
    if ! jq -n --arg kid "$kid" --argjson minutes_left "$remaining" \
      --argjson paused "$paused" --argjson live "$live" \
      '{kid: $kid, minutes_left: $minutes_left, paused: $paused, live: $live}' \
      >>"$rows"; then
      rm -f "$rows" "$tmp"
      return 0
    fi
  done < <(kids_list "$KIDS_DIR")
  tmp="$(mktemp "$RUN_DIR/status.json.XXXXXX")" || {
    rm -f "$rows"
    return 0
  }
  if ! jq -s '{generated_at: (now | todate), kids: .}' "$rows" >"$tmp" 2>/dev/null ||
    ! getent group omarchy-parents >/dev/null 2>&1 ||
    ! chown root "$tmp" 2>/dev/null ||
    ! chgrp omarchy-parents "$tmp" 2>/dev/null ||
    ! chmod 0640 "$tmp" 2>/dev/null ||
    ! mv -fT "$tmp" "$STATUS_JSON"; then
    rm -f "$rows" "$tmp"
    return 0
  fi
  rm -f "$rows" "$tmp"
}

cmd_tick() {
  if ! is_root; then
    die "tick must run as root (it is meant to be run by systemd/omarchy-kids-time.timer)" 1
  fi
  local now day weekend monotonic kid is_active kid_status tick_status=0
  now="$(time_root_now)"
  IFS=$'\t' read -r day weekend <<<"$(time_logical_day "$now")" || die "could not compute today's logical day"
  monotonic="$(time_monotonic)" || die "could not read the monotonic clock"
  while IFS= read -r kid; do
    [[ -n "$kid" ]] || continue
    if ! is_active="$(kid_active_state "$kid")"; then
      is_active=unknown
    fi
    [[ "$is_active" == unknown ]] || { time_is_paused "$kid" && is_active=no; }
    set +e
    (
      set -e
      tick_kid "$kid" "$day" "$weekend" "$now" "$monotonic" "$is_active"
    )
    kid_status=$?
    set -e
    if [[ "$kid_status" -ne 0 ]]; then tick_status=1; fi
  done < <(kids_list "$KIDS_DIR")
  write_status_json
  fold_all_launches
  nudge_relay
  return "$tick_status"
}

# relay_enabled — notifications are on: the parent has minted the certificate
# (omarchy-kids-notify enable). No certificate, no relay to start.
relay_enabled() { [[ -f "$RELAY_CERT" && -f "$RELAY_KEY" ]]; }

# pairing_pending — an unexpired pairing record exists: a phone is pairing right
# now, so the relay is needed even with no kid live and no request open
# (R-NOTIFY-5).
pairing_pending() {
  local dir="$PAIRING_DIR" f exp now
  [[ -d "$dir" ]] || return 1
  now="$(date +%s)"
  for f in "$dir"/*; do
    [[ -f "$f" ]] || continue
    exp="$(jq -r '.expires_at // 0' "$f" 2>/dev/null || echo 0)"
    [[ "$exp" =~ ^[0-9]+$ ]] && ((exp > now)) && return 0
  done
  return 1
}

# nudge_relay — start the relay on demand. It runs only while a kid is live, a
# request is open, or a pairing window is open, and exits on its own once none
# holds (R-NOTIFY-1, N-7), so root starts it and never keeps it alive. Best
# effort: a missing unit or a disabled certificate is not a tick failure, and a
# start that races the relay's own idle exit is harmless -- the next tick starts
# it again if it is still needed.
nudge_relay() {
  relay_enabled || return 0
  local active="" open=0
  active="$(active_kid_sessions 2>/dev/null)" || active=""
  open="$("$KIDS_PY" "$ASK_PY" list-open "$QUEUE_DIR" 2>/dev/null | grep -c . || true)"
  [[ -n "$active" || "${open:-0}" -gt 0 ]] || pairing_pending || return 0
  systemctl start --no-block "$RELAY_UNIT" >/dev/null 2>&1 || return 0
  echo "omarchy-kids-time-ledger: asked $RELAY_UNIT to start (a kid is live, a request is open, or a device is pairing)"
}

# kid_active_state ACCOUNT — yes/no when the account's sessions are known;
# failure means the account's liveness is unknown and must not advance usage.
kid_active_state() {
  local wanted="$1" sessions line id user active locked kind
  sessions="$(loginctl list-sessions --no-legend 2>/dev/null)" || return 1
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    id="$(awk '{print $1}' <<<"$line")"
    user="$(awk '{print $3}' <<<"$line")"
    [[ "$user" == "$wanted" ]] || continue
    kind="$(session_is_lockable "$id")" || return 1
    [[ "$kind" == yes ]] || continue
    active="$(session_prop "$id" Active)" || return 1
    locked="$(session_prop "$id" LockedHint)" || return 1
    [[ "$active" == yes && "$locked" == no ]] && printf 'yes\n' && return 0
  done <<<"$sessions"
  printf 'no\n'
}

# tick_kid ACCOUNT DAY WEEKEND NOW MONOTONIC ACTIVE — update one root state
# and its integer ledger without making the kid process part of enforcement.
tick_kid() {
  local kid="$1" day="$2" weekend="$3" now="$4" monotonic="$5" active="$6"
  local file state_json state=allowed reason=none logical_day last last_wall remainder grace
  local previous_remaining="" fired="" elapsed accumulated minutes base_remaining remaining lo decision
  local split old_elapsed new_elapsed old_accum old_minutes new_minutes
  local enforcement_action=none enforcement_reason=none enforcement_result=none enforcement_at=""
  local session_ids query_failed=0

  if state_json="$(time_state_file "$kid")" && time_state_read "$state_json"; then
    logical_day="$(jq -r '.logical_day' "$state_json")"
    state="$(jq -r '.state' "$state_json")"
    reason="$(jq -r '.reason' "$state_json")"
    last="$(jq -r '.last_tick' "$state_json")"
    last_wall="$(jq -r '.last_wall' "$state_json")"
    remainder="$(jq -r '.active_seconds_remainder' "$state_json")"
    grace="$(jq -r '.grace_deadline' "$state_json")"
    previous_remaining="$(jq -r '.remaining_seconds' "$state_json")"
    fired="$(jq -r '.warnings_fired | map(tostring) | join(" ")' "$state_json")"
    enforcement_action="$(jq -r '.enforcement.action // "none"' "$state_json")"
    enforcement_reason="$(jq -r '.enforcement.reason // "none"' "$state_json")"
    enforcement_result="$(jq -r '.enforcement.result // "none"' "$state_json")"
    enforcement_at="$(jq -r '.enforcement.at // ""' "$state_json")"
  else
    logical_day=""
    last="$monotonic"
    last_wall="$now"
    remainder=0
    grace=0
    enforcement_action=none
    enforcement_reason=none
    enforcement_result=none
    enforcement_at=""
  fi

  if [[ "$active" == unknown ]]; then
    return 1
  fi

  # A changed logical day starts from that day's integer ledgers, not from
  # an old day's remainder or a fabricated interval.
  if [[ "$logical_day" != "$day" ]]; then
    if [[ "$logical_day" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ && "$active" == yes &&
      "$state" != grace && "$state" != finishing && "$last" =~ ^[0-9]+$ &&
      "$last_wall" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}\ [0-9]{2}:[0-9]{2}:[0-9]{2}$ ]]; then
      elapsed=$((monotonic - last))
      ((elapsed < 0)) && elapsed=0
      split="$(time_split_elapsed "$last_wall" "$now" "$elapsed")"
      old_elapsed="$(sed -n '1p' <<<"$split")"
      new_elapsed="$(sed -n '2p' <<<"$split")"
      old_accum=$((remainder + old_elapsed))
      old_minutes=$((old_accum / 60))
      ((old_minutes > 0)) && time_ledger_add "$kid" "$logical_day" "$old_minutes"
      new_minutes=$((new_elapsed / 60))
      ((new_minutes > 0)) && time_ledger_add "$kid" "$day" "$new_minutes"
      remainder=$((new_elapsed % 60))
    else
      remainder=0
    fi
    state=allowed
    reason=none
    last="$monotonic"
    grace=0
    previous_remaining=""
    fired=""
    enforcement_action=none
    enforcement_reason=none
    enforcement_result=none
    enforcement_at=""
  elif [[ "$state" != grace && "$state" != finishing && "$active" == yes ]] &&
    [[ "$last" =~ ^[0-9]+$ && "$monotonic" =~ ^[0-9]+$ ]]; then
    elapsed=$((monotonic - last))
    ((elapsed < 0)) && elapsed=0
    accumulated=$((remainder + elapsed))
    minutes=$((accumulated / 60))
    remainder=$((accumulated % 60))
    ((minutes > 0)) && time_ledger_add "$kid" "$day" "$minutes"
  fi
  last="$monotonic"

  base_remaining=$((($(time_remaining_minutes "$kid" "$day" "$weekend")) * 60))
  remaining=$((base_remaining - remainder))
  ((remaining < 0)) && remaining=0
  decision="$(time_warning_thresholds "$previous_remaining" "$remaining" "$fired")"
  fired="$(sed -n '2p' <<<"$decision")"
  lo="$(time_is_lights_out "$kid" "$weekend" "$(time_hm "$now")")"

  if [[ "$state" == grace || "$state" == finishing ]]; then
    if [[ "$lo" != yes && "$remaining" -gt 0 ]]; then
      if ((remaining <= 600)); then state=warning; else state=allowed; fi
      reason=budget
      grace=0
      enforcement_action=none
      enforcement_reason=none
      enforcement_result=none
      enforcement_at=""
    elif [[ "$state" == grace && "$monotonic" -lt "$grace" ]]; then
      reason="${reason:-budget}"
    else
      state=finishing
      reason="${reason:-budget}"
    fi
  elif [[ "$remaining" -le 0 || "$lo" == yes ]]; then
    state=grace
    if [[ "$lo" == yes ]]; then reason=lights-out; else reason=budget; fi
    grace=$((monotonic + 60))
  elif ((remaining <= 600)); then
    state=warning
    reason=budget
    grace=0
  else
    state=allowed
    reason=none
    grace=0
  fi

  if [[ "$state" == grace ]]; then
    if ! session_ids="$(kid_session_ids "$kid")"; then
      enforcement_action=lock
      enforcement_reason="$reason"
      enforcement_result=failed
      enforcement_at="$now"
      query_failed=1
    elif [[ "$enforcement_action" != lock || "$enforcement_reason" != "$reason" ||
      "$enforcement_result" == failed ||
      -n "$session_ids" ]]; then
      enforcement_action=lock
      enforcement_reason="$reason"
      enforcement_at="$now"
      if [[ -n "$session_ids" ]]; then
        if lock_kid_sessions "$session_ids"; then
          enforcement_result=success
        else
          enforcement_result=failed
        fi
      else
        enforcement_result=not-needed
      fi
    fi
  elif [[ "$state" == finishing ]]; then
    if ! session_ids="$(kid_all_session_ids "$kid")"; then
      enforcement_action=finish
      enforcement_reason="$reason"
      enforcement_result=failed
      enforcement_at="$now"
      query_failed=1
    elif [[ "$enforcement_action" != finish || "$enforcement_reason" != "$reason" ||
      "$enforcement_result" == failed ||
      -n "$session_ids" ]]; then
      enforcement_action=finish
      enforcement_reason="$reason"
      enforcement_at="$now"
      if "$EXIT_BIN" --finish --kid "$kid" >/dev/null 2>&1; then
        enforcement_result=success
      else
        enforcement_result=failed
      fi
    fi
  fi

  time_state_write "$kid" "$day" "$state" "$reason" "$remaining" "$grace" \
    "$last" "$remainder" "$fired" "$now" "$enforcement_action" \
    "$enforcement_reason" "$enforcement_result" "$enforcement_at"
  if ((query_failed)); then
    return 1
  fi
}

# fold_all_launches — R-DATA-1, every known kid, best-effort.
fold_all_launches() {
  while IFS= read -r kid; do
    [[ -n "$kid" ]] || continue
    data_fold_launches "$kid" 2>/dev/null || true
  done < <(kids_list "$KIDS_DIR")
}

[[ $# -ge 1 ]] || {
  usage >&2
  exit 2
}
case "$1" in
  -h | --help)
    usage
    exit 0
    ;;
  tick) cmd_tick ;;
  *) die "unknown command '$1' (see --help)" ;;
esac
