#!/bin/bash
# omarchy:summary=The parent panel: per-kid time, web, apps, desktop, password, remove
# omarchy:args=[--dry-run] [--apply]
# Everything after the first run: per-kid time, web, apps, data, desktop
# (level, theme — issue #53), password, remove (SPEC.md R-WIZ-7/8,
# Appendix A's P1-P5). See docs/panel.md for the full screen list and
# every env var.
set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
LIB="$DIR/lib"
[[ -f "$LIB/ask.py" ]] || LIB=/usr/lib/omarchy-kids
# shellcheck source=lib/tui.sh
source "$LIB/tui.sh"
# shellcheck source=lib/kids.sh
source "$LIB/kids.sh"
# theme_list_installed (issue #53): screen_kid_theme's own picker.
# shellcheck source=lib/theme.sh
source "$LIB/theme.sh"
ASK_PY="$LIB/ask.py"

CONF_BIN="$(kids_bin conf "$DIR")"
TIME_BIN="$(kids_bin time "$DIR")"
ASK_BIN="$(kids_bin ask "$DIR")"
APPS_BIN="$(kids_bin apps "$DIR")"
PLUGINS_BIN="$(kids_bin plugins "$DIR")"
WEB_BIN="$(kids_bin web "$DIR")"
PROVISION_BIN="$(kids_bin provision "$DIR")"
WIZARD_BIN="$(kids_bin wizard "$DIR")"
DATA_BIN="$(kids_bin data "$DIR")"
REMOVE_BIN="$(kids_bin remove "$DIR")"

ETC="${OMARCHY_KIDS_ETC:-/etc/omarchy-kids}"
SYSROOT="${OMARCHY_KIDS_ROOT:-}"
QUEUE_DIR="$SYSROOT/var/lib/omarchy-kids/queue"

# Interactive: a human's button press is the confirmation, so the default
# is a real run (review §1.5, docs/panel.md; AGENTS.md rule 8 still holds
# for every non-interactive caller).
if launched_by_a_human; then
  DRY_RUN="${DRY_RUN:-0}"
else
  DRY_RUN="${DRY_RUN:-1}"
fi

die() {
  echo "omarchy-kids-panel: $1" >&2
  exit "${2:-2}"
}

usage() {
  cat <<'EOF'
Usage: omarchy-kids-panel [--dry-run] [--apply] [--help]

Everything after the first kid (SPEC.md R-WIZ-7, R-WIZ-8): Home lists every
kid with today's minutes and open requests; per kid, screen time, web,
apps, desktop level, password, and remove; a Requests screen to approve or
decline what a kid has asked for.

Keyboard only: Esc (or "Quit"/"Back") leaves a screen, Ctrl+C leaves the
whole panel with nothing further changed.

This panel runs as the parent, never itself elevated. Every write goes
through sudo, warmed once (one password prompt, explained on screen) the
first time something is actually written.

Run by a human -- from a terminal, or from the Kids Mode app entry -- this
panel is real: the screen you confirm is the confirmation. Run without a
terminal (a test, a script, CI) it previews instead. --dry-run always
previews; --apply always writes.

  --dry-run   Print every command instead of running it.
  --apply     Make writes real (same as DRY_RUN=0).
  -h, --help  Show this help and exit.
EOF
}

for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=1 ;;
    --apply) DRY_RUN=0 ;;
    -h | --help)
      usage
      exit 0
      ;;
    *) die "unknown argument '$arg' (see --help)" ;;
  esac
done

# --- root, once, on first write ------------------------------------------

SUDO_WARMED=0
warm_sudo() {
  ((SUDO_WARMED)) && return 0
  SUDO_WARMED=1
  if [[ "$DRY_RUN" == "1" ]]; then
    printf '  [dry-run] sudo -v   # one password prompt, warmed here, before the first real write\n'
    return 0
  fi
  echo "Kids Mode needs your password once, to make this change."
  sudo -v
}

# run_priv CMD... — print (DRY_RUN=1) or run under sudo. docs/panel.md.
# The result lands in PANEL_NOTICE so the next card can show it: the card
# clears, so a write's output would otherwise vanish with the screen.
PANEL_NOTICE=""
run_priv() {
  warm_sudo || return 1
  local rc=0 output first
  if [[ "$DRY_RUN" == "1" ]]; then
    output="$(printf '  [dry-run] sudo'; printf ' %q' "$@"; printf '\n')"
    printf '%s\n' "$output"
    first="${output%%$'\n'*}"
    PANEL_NOTICE="Preview only — nothing was changed: $first"
    return 0
  fi
  output="$(sudo "$@" 2>&1)" || rc=$?
  first="${output%%$'\n'*}"
  if [[ -n "$output" ]]; then printf '%s\n' "$output"; fi
  if ((rc != 0)); then
    PANEL_NOTICE="That change failed${first:+: $first}"
  else
    PANEL_NOTICE="Change applied${first:+: $first}"
  fi
  return "$rc"
}

# panel_notice_lines ARRAYNAME — append the last write result to a card
# body, then clear it, so a screen picks it up on its next draw.
panel_notice_lines() {
  local arrname="$1"
  [[ -n "$PANEL_NOTICE" ]] || return 0
  eval "$arrname+=(\"\" \"\$PANEL_NOTICE\")"
  PANEL_NOTICE=""
}

# read_priv CMD... — root-only read (issue #27's Data screen); always
# runs for real, no DRY_RUN preview. docs/panel.md. warm_sudo_read is
# split out so a screen that captures a read's output can spend the one
# prompt in its own shell first, the way the Web screen warms warm_sudo.
SUDO_READ_WARMED=0
warm_sudo_read() {
  ((SUDO_READ_WARMED)) && return 0
  SUDO_READ_WARMED=1
  echo "Kids Mode needs your password once, to read this."
  sudo -v
}

read_priv() {
  warm_sudo_read || return 1
  sudo "$@"
}

# write_root_file FILE — stdin -> FILE as root (sudo tee), dir created
# first. Web screen's allow-list editor only (docs/conf.md).
write_root_file() {
  local file="$1" content
  content="$(cat)"
  warm_sudo || return 1
  if [[ "$DRY_RUN" == "1" ]]; then
    printf '  [dry-run] sudo install -d -m 0755 %q\n' "$(dirname "$file")"
    printf '  [dry-run] sudo tee %q\n' "$file"
  else
    sudo install -d -m 0755 "$(dirname "$file")" &&
      printf '%s' "$content" | sudo tee "$file" >/dev/null
  fi
}

# --- small helpers ---------------------------------------------------------

is_in_csv() { # NEEDLE CSV
  local needle="$1" csv="$2" x
  local IFS=,
  for x in $csv; do [[ "$x" == "$needle" ]] && return 0; done
  return 1
}

human_age() { # SECONDS -> "just now" / "Nm ago" / "Nh ago" / "Nd ago"
  local s="$1"
  ((s < 0)) && s=0
  if ((s < 60)); then
    echo "just now"
  elif ((s < 3600)); then
    echo "$((s / 60))m ago"
  elif ((s < 86400)); then
    echo "$((s / 3600))h ago"
  else
    echo "$((s / 86400))d ago"
  fi
}

validate_positive_minutes() {
  [[ "$1" =~ ^[0-9]+$ ]] && ((10#$1 >= 1)) && return 0
  echo "A whole number of minutes, at least 1."
  return 1
}

validate_hostname() {
  [[ -n "$1" ]] || {
    echo "Type a hostname, like example.com."
    return 1
  }
  [[ "$1" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]] || {
    echo "Letters, digits, dots, and hyphens only."
    return 1
  }
  return 0
}

kid_conf_get() { "$CONF_BIN" get "$1" "$2" 2>/dev/null; }

# count_open_requests [KID] — how many open requests, all kids or one.
count_open_requests() {
  local -a args=(list-open "$QUEUE_DIR")
  [[ -n "${1:-}" ]] && args+=(--kid "$1")
  local rows
  rows="$("$KIDS_PY" "$ASK_PY" "${args[@]}" 2>/dev/null)"
  [[ -z "$rows" ]] && {
    echo 0
    return 0
  }
  printf '%s\n' "$rows" | grep -c '.'
}

ask_field() { "$KIDS_PY" "$ASK_PY" show "$1" --field "$2" 2>/dev/null; } # PATH FIELD

# kid_home_line NAME BAND STATUS_OUT NREQ — one Home-screen line. docs/panel.md.
kid_home_line() {
  local name="$1" band="$2" status_out="$3" nreq="$4"
  local used left line paused=0
  used="$(grep -oE '[0-9]+ min used' <<<"$status_out" | grep -oE '^[0-9]+')"
  left="$(grep -oE '[0-9]+ min left' <<<"$status_out" | grep -oE '^[0-9]+')"
  grep -q '^paused:' <<<"$status_out" && paused=1
  line="$name · $band"
  ((paused)) && line+=" · paused"
  [[ -n "$used" && -n "$left" ]] && line+=" · ${used}m used / ${left}m left today"
  ((nreq > 0)) && line+=" · $nreq request$([[ $nreq == 1 ]] || echo s)"
  printf '%s' "$line"
}

# --- thin dispatch: one lib/panel-<screen>.sh per Appendix A group ---------

# shellcheck source=lib/panel-requests.sh
source "$LIB/panel-requests.sh"
# shellcheck source=lib/panel-kid.sh
source "$LIB/panel-kid.sh"
# shellcheck source=lib/panel-home.sh
source "$LIB/panel-home.sh"

# --- main --------------------------------------------------------------------

tui_init || exit $?

# 1 (Esc) / 130 (Ctrl+C) is data for the case below, not an error --
# same fix as bin/omarchy-kids-wizard's step loop.
set +e
screen_home
rc=$?
set -e
case "$rc" in
  130)
    echo "Left Kids Mode." >&2
    exit 130
    ;;
  *)
    echo "Left Kids Mode."
    exit 0
    ;;
esac
