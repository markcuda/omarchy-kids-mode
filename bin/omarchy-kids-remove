#!/bin/bash
# omarchy:summary=Remove Kids Mode: reverse every lock and account it created
# omarchy:args=[--yes] [--dry-run] [--delete-homes] [--no-snapshot] [--keep-parent-group] [--luks-device DEV]
# "Remove Kids Mode": the parent's undo button -- reverses every lock, keeps every kid's files
# (SPEC.md R-TRUST-1, R-TRUST-4, R-FND-6). See docs/remove.md for the exact order and what's deliberately left behind.
set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
LIB="$DIR/lib"
[[ -f "$LIB/conf.sh" ]] || LIB=/usr/lib/omarchy-kids
# shellcheck source=lib/conf.sh
source "$LIB/conf.sh"
# shellcheck source=lib/posture.sh
source "$LIB/posture.sh"
# shellcheck source=lib/kids.sh
source "$LIB/kids.sh"
# shellcheck source=lib/tui.sh
source "$LIB/tui.sh"
# shellcheck source=lib/boot-mode.sh
source "$LIB/boot-mode.sh"

# Device selection is an explicit option or local detection, never ambient state.
unset OMARCHY_KIDS_LUKS_DEVICE

ETC="${OMARCHY_KIDS_ETC:-/etc/omarchy-kids}"
KIDS_DIR="$ETC/kids"
SLOTS_FILE="$ETC/luks-slots"

YES=0
REAL_DRY_RUN=0
DELETE_HOMES=0
NO_SNAPSHOT=0
PARENT_PW_STDIN=0
PARENT_PASSWORD=""
KEEP_PARENT_GROUP=0
LUKS_DEVICE=""
BOOT_MODE=""
DRY_RUN=0
ANY_FAIL=0
FAILED_STEPS=()

die() {
  echo "omarchy-kids-remove: $1" >&2
  exit "${2:-2}"
}

usage() {
  cat <<'EOF'
Usage: omarchy-kids-remove [--yes] [--dry-run] [--delete-homes]
                            [--parent-password-stdin] [--no-snapshot]
                            [--keep-parent-group] [--luks-device DEV]
       omarchy-kids-remove --help

Remove Kids Mode (SPEC.md R-TRUST-4): reverses every lock, removes every
kid account and its LUKS slot, and keeps every kid's files -- each kid's
home moves to "<parent home>/Kids Mode/<name>/" (same convention
`omarchy-kids-provision remove` already uses) unless --delete-homes, in
which case "userdel -r" deletes it instead. Offers a Snapper snapshot first (skip
with --no-snapshot). Always prints the plan; --dry-run stops there and
writes nothing. Without --yes, asks for confirmation before doing
anything for real. Ends by printing the "pacman -R" command that removes
the package itself -- this command never runs it.

  --yes                     Skip the "type yes" confirmation.
  --dry-run                 Print the plan; change nothing.
  --delete-homes            Delete each kid's home (userdel -r) instead
                            of keeping it.
  --parent-password-stdin   Read the parent's password, one line, from
                            stdin, before any other input this run reads.
                            Passed to cryptsetup as each kid's LUKS slot
                            is killed, for an authenticated deletion; not
                            required (root can kill a slot without one,
                            same as omarchy-kids-provision remove -- see
                            docs/remove.md).
  --luks-device DEV         LUKS root when disk-mode auto-detection is
                            unavailable. Rejected in portal mode, which also
                            refuses any kid that still has a recorded slot.
  --no-snapshot             Skip the Snapper snapshot offer outright.
  --keep-parent-group       Leave the parent in omarchy-parents instead of
                            removing them at the end of the run.
  -h, --help                Show this help and exit.
EOF
}

for arg in "$@"; do
  case "$arg" in
    -h | --help)
      usage
      exit 0
      ;;
  esac
done

while (($#)); do
  case "$1" in
    --yes) YES=1 ;;
    --dry-run) REAL_DRY_RUN=1 ;;
    --delete-homes) DELETE_HOMES=1 ;;
    --parent-password-stdin) PARENT_PW_STDIN=1 ;;
    --no-snapshot) NO_SNAPSHOT=1 ;;
    --keep-parent-group) KEEP_PARENT_GROUP=1 ;;
    --luks-device)
      [[ $# -ge 2 ]] || die "--luks-device needs a value"
      LUKS_DEVICE="$2"
      shift
      ;;
    *)
      echo "omarchy-kids-remove: unknown argument '$1'" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

# --- small helpers -----------------------------------------------------

# report STATUS DESC -- one line per step.
report() { printf '%-12s %s\n' "$1" "$2"; }

# plan_one DESC CHECK_FN FIX_FN [ARGS...] -- assert_one's check/fix shape,
# inverted for removal; never stops the rest on FAILED (docs/remove.md).
plan_one() {
  local desc="$1" check="$2" fix="$3"
  shift 3
  if ! "$check" "$@"; then
    report skipped "$desc"
    return 0
  fi
  if [[ "$DRY_RUN" -eq 1 ]]; then
    report would-remove "$desc"
    return 0
  fi
  if "$fix" "$@"; then
    report removed "$desc"
  else
    report FAILED "$desc"
    ANY_FAIL=1
    FAILED_STEPS+=("$desc")
  fi
  return 0
}

# kid_step returns its own result so only this kid's safe-to-delete decision
# depends on it. The full-run summary remains global.
kid_step() {
  local desc="$1" check="$2" fix="$3"
  shift 3
  if ! "$check" "$@"; then
    report skipped "$desc"
    return 0
  fi
  if [[ "$DRY_RUN" -eq 1 ]]; then
    report would-remove "$desc"
    return 0
  fi
  if "$fix" "$@"; then
    report removed "$desc"
    return 0
  fi
  report FAILED "$desc"
  ANY_FAIL=1
  FAILED_STEPS+=("$desc")
  return 1
}

file_present() { [[ -e "$1" ]]; }
file_remove() { rm -f "$1"; }

# luks-slots parsing/writing (luks_slots_parent_line, luks_slots_kid_entries,
# luks_slot_for_account, posture_write_luks_slots) is lib/kids.sh's now --
# it used to be duplicated here and in bin/omarchy-kids-provision.

# --- per-kid steps -------------------------------------------------------

mount_present() {
  local home
  home="$(home_dir_for "$1")"
  findmnt -no OPTIONS "$home" >/dev/null 2>&1
}
mount_remove() {
  local account="$1" home unit
  home="$(home_dir_for "$account")"
  # Transient mount unit if any (best-effort) -- docs/remove.md.
  if command -v systemd-escape >/dev/null 2>&1; then
    unit="$(systemd-escape --path --suffix=mount "$home" 2>/dev/null || true)"
    [[ -n "$unit" ]] && systemctl stop "$unit" >/dev/null 2>&1
  fi
  umount "$home"
}

fstab_present() { grep -qxF "$(posture_fstab_line "$1")" "$(posture_fstab)" 2>/dev/null; }
fstab_remove() { posture_remove_fstab_line "$1"; }

luks_present() {
  [[ -n "$(luks_slot_for_account "$SLOTS_FILE" "$1" || true)" ]] ||
    [[ -n "$(luks_removal_intent_for_account "$SLOTS_FILE" "$1" 2>/dev/null || true)" ]]
}
luks_remove() {
  local account="$1" slot device
  slot="$(luks_slot_for_account "$SLOTS_FILE" "$account" || true)"
  [[ -n "$slot" ]] || slot="$(luks_removal_intent_for_account "$SLOTS_FILE" "$account" 2>/dev/null || true)"
  if ! device="$(detect_luks_device "$LUKS_DEVICE")"; then
    echo "omarchy-kids-remove: disk mode cannot find the LUKS root for slot $slot" >&2
    return 1
  fi
  if [[ -n "$PARENT_PASSWORD" ]]; then
    luks_remove_account_slot "$SLOTS_FILE" "$account" "$device" 3 \
      3< <(printf '%s' "$PARENT_PASSWORD")
  else
    luks_remove_account_slot "$SLOTS_FILE" "$account" "$device"
  fi
}

namespace_present() {
  local file account="$1"
  file="$(posture_namespace_conf)"
  [[ -f "$file" ]] || return 1
  grep -qxF "$(posture_namespace_line_tmp "$account")" "$file" ||
    grep -qxF "$(posture_namespace_line_shm "$account")" "$file" ||
    grep -qxF "$(posture_namespace_legacy_line_tmp "$account")" "$file" ||
    grep -qxF "$(posture_namespace_legacy_line_shm "$account")" "$file"
}
namespace_remove() { posture_remove_namespace_lines "$1"; }

accountsservice_present() { [[ -f "$(posture_accountsservice_dir)/$1" ]]; }
accountsservice_remove() { posture_remove_accountsservice "$1"; }

# face (issue #39): the SDDM face-icon file, distinct from AccountsService's
# Icon= above -- docs/portal.md's "Avatars" has why both exist.
face_present() { [[ -f "$(posture_sddm_faces_dir)/$1.face.icon" ]]; }
face_remove() { posture_remove_face_icon "$1"; }

account_present() { id "$1" >/dev/null 2>&1; }
account_remove() {
  if [[ "$DELETE_HOMES" -eq 1 ]]; then
    userdel -r "$1"
  else
    userdel "$1"
  fi
}

profile_present() { [[ -e "$KIDS_DIR/$1.conf" ]]; }
profile_remove() { rm -f "$KIDS_DIR/$1.conf"; }

# home: only reached without --delete-homes. Moved to "<parent home>/Kids
# Mode/<name>/", 0700, chowned parent:parent -- group too (issue #45 item 2, docs/remove.md).
home_present() { [[ -e "$(home_dir_for "$1")" ]]; }
home_remove() {
  local account="$1" display_name="$2" home parent_home dest parent
  home="$(home_dir_for "$account")"
  parent_home="$(parent_home_dir "$ETC/machine.conf")" || return 1
  parent="$(conf_get "$ETC/machine.conf" parent 2>/dev/null || true)"
  dest="$parent_home/Kids Mode/$display_name"
  install -d -m 0700 "$parent_home/Kids Mode" || return 1
  mv "$home" "$dest" || return 1
  [[ -n "$parent" ]] && chown -R "$parent:$parent" "$dest" >/dev/null 2>&1
  return 0
}

remove_kid() {
  local account="$1" display_name kid_failed=0 slot
  display_name="$(conf_get "$KIDS_DIR/$account.conf" name 2>/dev/null || true)"
  [[ -n "$display_name" ]] || display_name="$account"
  if [[ "$BOOT_MODE" == disk ]]; then
    kid_step "luks:$account" luks_present luks_remove "$account" || return 0
  else
    slot="$(luks_slot_for_account "$SLOTS_FILE" "$account" || true)"
    [[ -n "$slot" ]] || slot="$(luks_removal_intent_for_account "$SLOTS_FILE" "$account" 2>/dev/null || true)"
    if [[ -n "$slot" ]]; then
      if [[ "$DRY_RUN" -eq 1 ]]; then
        report blocked "luks:$account"
      else
        echo "omarchy-kids-remove: portal mode cannot verify recorded LUKS slot $slot for $account; remove the slot in disk mode first" >&2
        report FAILED "luks:$account"
        ANY_FAIL=1
        FAILED_STEPS+=("luks:$account")
      fi
      ANY_FAIL=1
      return 0
    fi
  fi
  kid_step "mount:$account" mount_present mount_remove "$account" || kid_failed=1
  kid_step "fstab:$account" fstab_present fstab_remove "$account" || kid_failed=1
  kid_step "namespace:$account" namespace_present namespace_remove "$account" || kid_failed=1
  kid_step "accountsservice:$account" accountsservice_present accountsservice_remove "$account" || kid_failed=1
  kid_step "face:$account" face_present face_remove "$account" || kid_failed=1
  ((kid_failed == 0)) || return 0
  kid_step "account:$account" account_present account_remove "$account" || return 0
  kid_step "home:$account" home_present home_remove "$account" "$display_name" || return 0
  kid_step "profile:$account" profile_present profile_remove "$account" || return 0
}

# --- machine-level steps -------------------------------------------------

polkit_admin_present() { [[ -f "$(posture_polkit_dir)/40-omarchy-kids.rules" ]]; }
polkit_admin_remove() { rm -f "$(posture_polkit_dir)/40-omarchy-kids.rules"; }

polkit_deny_present() { [[ -f "$(posture_polkit_dir)/41-omarchy-kids-deny.rules" ]]; }
polkit_deny_remove() { rm -f "$(posture_polkit_dir)/41-omarchy-kids-deny.rules"; }

getty_unit_path() { printf '%s/etc/systemd/system/getty@tty%s.service' "$(posture_root)" "$1"; }
getty_present() {
  local link
  link="$(getty_unit_path "$1")"
  [[ -L "$link" ]] && [[ "$(readlink "$link")" == "/dev/null" ]]
}
getty_remove() {
  local root_args=()
  [[ -n "$(posture_root)" ]] && root_args=(--root="$(posture_root)")
  systemctl "${root_args[@]}" unmask "getty@tty$1.service"
}

sddm_theme_present() { [[ -f "$(posture_sddm_conf_dir)/zz-omarchy-kids-theme.conf" ]]; }
sddm_theme_remove() { posture_remove_sddm_theme_dropin; }

# portal-conf (issue #39): theme.conf.user, rebuilt from whatever's left
# under $KIDS_DIR now (docs/remove.md). No EXCLUDE needed here: the account it would
# have excluded is already gone from $KIDS_DIR by the time this runs.
portal_conf_expected() {
  local parent entries=() line
  parent="$(conf_get "$ETC/machine.conf" parent 2>/dev/null || true)"
  [[ -n "$parent" ]] || return 1
  while IFS= read -r line; do [[ -n "$line" ]] && entries+=("$line"); done < <(portal_conf_entries "$KIDS_DIR")
  posture_portal_conf_text "$parent" "${entries[@]+"${entries[@]}"}"
}
portal_conf_present() {
  local expected file
  expected="$(portal_conf_expected)" || return 1
  file="$(posture_sddm_theme_dir)/theme.conf.user"
  [[ -f "$file" ]] && [[ "$(cat "$file")" != "$expected" ]]
}
portal_conf_remove() {
  local parent entries=() line
  parent="$(conf_get "$ETC/machine.conf" parent 2>/dev/null || true)"
  [[ -n "$parent" ]] || return 1
  while IFS= read -r line; do [[ -n "$line" ]] && entries+=("$line"); done < <(portal_conf_entries "$KIDS_DIR")
  posture_write_portal_conf "$parent" "${entries[@]+"${entries[@]}"}"
}

parent_unlock_present() {
  local file
  file="$(posture_pam_dir)/$1"
  [[ -f "$file" ]] && grep -qxF "$(posture_parent_unlock_marker)" "$file"
}
parent_unlock_remove() { posture_remove_parent_unlock_line "$1"; }

chromium_dir() { printf '%s/etc/chromium/policies/managed' "$(posture_root)"; }

# limine snapshot-hiding restore (V6, issue #38): the mirror image of
# bin/omarchy-kids-assert's limine_snapshots_fix "show" branch --
# duplicated rather than shared for the same reason as group_for_band
# (docs/assert.md); see docs/remove.md's Judgment calls. Unlike assert,
# this always restores, regardless of machine.conf's boot.snapshot_entries
# -- Remove Kids Mode is retiring the whole feature, so the parent's
# choice there no longer applies.
LIMINE_SNAPSHOTS_MARKER='# omarchy-kids: was MAX_SNAPSHOT_ENTRIES='
limine_default() { printf '%s/etc/default/limine' "$(posture_root)"; }
limine_snapshots_present() {
  local f
  f="$(limine_default)"
  [[ -f "$f" ]] || return 1
  grep -qF "$LIMINE_SNAPSHOTS_MARKER" "$f" || grep -qxF 'MAX_SNAPSHOT_ENTRIES=0' "$f"
}
limine_snapshots_remove() {
  local f old tmp backup mode owner group
  f="$(limine_default)"
  old="$(grep -F "$LIMINE_SNAPSHOTS_MARKER" "$f" 2>/dev/null | tail -n1 || true)"
  old="${old#"$LIMINE_SNAPSHOTS_MARKER"}"
  mode="$(file_stat a "$f")"
  owner="$(file_stat u "$f")"
  group="$(file_stat G "$f")"
  [[ -n "$mode" && -n "$owner" && -n "$group" ]] || return 1
  tmp="$(mktemp "$(dirname "$f")/.limine.XXXXXX")" || return 1
  backup="$(mktemp "$(dirname "$f")/.limine.backup.XXXXXX")" || {
    rm -f "$tmp"
    return 1
  }
  cp -p "$f" "$backup" || {
    rm -f "$tmp" "$backup"
    return 1
  }
  {
    grep -vE "^MAX_SNAPSHOT_ENTRIES=|^${LIMINE_SNAPSHOTS_MARKER}" "$f" || true
    [[ -n "$old" ]] && printf 'MAX_SNAPSHOT_ENTRIES=%s\n' "$old"
    true
  } >"$tmp" || {
    rm -f "$tmp" "$backup"
    return 1
  }
  if ! chmod "$mode" "$tmp" || ! chown "$owner:$group" "$tmp" || ! mv -f "$tmp" "$f"; then
    rm -f "$tmp" "$backup"
    return 1
  fi
  if [[ -z "$(posture_root)" ]] && command -v limine-snapper-sync >/dev/null 2>&1; then
    if ! limine-snapper-sync; then
      mv -f "$backup" "$f" || return 1
      return 1
    fi
  fi
  rm -f "$backup"
  return 0
}

# editor_enabled is left as-is on purpose (the parent chose it); only our
# own MAX_SNAPSHOT_ENTRIES line/comment above is ours to restore.

mkinitcpio_dropin() { printf '%s/etc/mkinitcpio.conf.d/omarchy_kids.conf' "$(posture_root)"; }
mkinitcpio_dropin_present() { [[ "$BOOT_MODE" == disk ]]; }
mkinitcpio_dropin_remove() {
  local file backup=""
  file="$(mkinitcpio_dropin)"
  if [[ -f "$file" ]]; then
    backup="$(mktemp "$(dirname "$file")/.omarchy_kids.conf.XXXXXX")" || return 1
    cp -p "$file" "$backup" || {
      rm -f "$backup"
      return 1
    }
    rm -f "$file" || {
      rm -f "$backup"
      return 1
    }
  fi
  if ! mkinitcpio -P; then
    [[ -n "$backup" ]] && mv -f "$backup" "$file"
    return 1
  fi
  [[ -z "$backup" ]] || rm -f "$backup"
}

autologin_dropin() { printf '%s/zz-omarchy-kids-autologin.conf' "$(posture_sddm_conf_dir)"; }
autologin_present() { [[ -f "$(autologin_dropin)" ]]; }
autologin_remove() { rm -f "$(autologin_dropin)"; }

# KIDS_UNITS/KIDS_SOCKETS/KIDS_TIMERS come from lib/kids.sh (issue #45's
# item 5), the same list bin/omarchy-kids-assert's own "units" lock and
# bin/omarchy-kids-wizard's Apply step use -- so a unit added there
# (omarchy-kids-wifid.socket, omarchy-kids-ask-collect.timer) is disabled
# and stopped here too, with nothing to keep in sync by hand. KIDS_EXTRA_UNITS
# are activated-by-the-above units with no [Install] section of their own
# (no .wants symlink to check), so they're only ever stopped, never
# checked for "is this enabled".
KIDS_EXTRA_UNITS=(omarchy-kids-authd.service omarchy-kids-wifid.service omarchy-kids-time-ledger.service omarchy-kids-ask-collect.service)
unit_link() { printf '%s/etc/systemd/system/%s.wants/%s' "$(posture_root)" "$1" "$2"; }
units_present() {
  local u
  for u in "${KIDS_UNITS[@]}"; do [[ -L "$(unit_link multi-user.target "$u")" ]] && return 0; done
  for u in "${KIDS_SOCKETS[@]}"; do [[ -L "$(unit_link sockets.target "$u")" ]] && return 0; done
  for u in "${KIDS_TIMERS[@]}"; do [[ -L "$(unit_link timers.target "$u")" ]] && return 0; done
  return 1
}
units_remove() {
  local root_args=() now_args=()
  if [[ -n "$(posture_root)" ]]; then
    root_args=(--root="$(posture_root)")
  else
    now_args=(--now)
  fi
  systemctl "${root_args[@]}" disable "${now_args[@]+"${now_args[@]}"}" \
    "${KIDS_UNITS[@]}" "${KIDS_SOCKETS[@]}" "${KIDS_TIMERS[@]}" "${KIDS_EXTRA_UNITS[@]}"
}

# parent-group (issue #45 item 3): the parent stays a member of
# omarchy-parents by default once every kid-level lock is gone, unless
# --keep-parent-group is given. current_groups/has_group are duplicated
# from lib/assert-locks.sh's own parent-group lock (R-BAR-3, issue #37)
# for the same reason docs/assert.md's "Judgment calls" already gives for
# group_for_band: two files with their own main "$@"/dispatch, not a
# shared library. Reads machine.conf's "parent=" the same way every other
# machine-level step here does, so this has to run before "etc-and-varlib"
# deletes $ETC.
current_groups() { id -nG "$1" 2>/dev/null || true; }
has_group() { [[ " $1 " == *" $2 "* ]]; }
parent_group_present() {
  ((KEEP_PARENT_GROUP)) && return 1
  local parent
  parent="$(conf_get "$ETC/machine.conf" parent 2>/dev/null || true)"
  [[ -n "$parent" ]] || return 1
  has_group "$(current_groups "$parent")" omarchy-parents
}
parent_group_remove() {
  local parent
  parent="$(conf_get "$ETC/machine.conf" parent 2>/dev/null || true)"
  [[ -n "$parent" ]] || return 1
  gpasswd -d "$parent" omarchy-parents >/dev/null 2>&1
}

varlib_dir() { printf '%s/var/lib/omarchy-kids' "$(posture_root)"; }
purge_present() {
  ((ANY_FAIL == 0)) || return 1
  [[ -d "$ETC" ]] || [[ -d "$(varlib_dir)" ]]
}
purge_remove() {
  local base varlib stamp tar_dir tarball paths=()
  base="$(posture_root)"
  [[ -n "$base" ]] || base="/"
  varlib="$(varlib_dir)"
  stamp="$(date +%Y%m%d-%H%M%S)"
  tar_dir="$base/root"
  install -d -m 0700 "$tar_dir" || return 1
  tarball="$tar_dir/omarchy-kids-removed-$stamp.tar.gz"
  [[ -d "$ETC" ]] && paths+=("$ETC")
  [[ -d "$varlib" ]] && paths+=("$varlib")
  if [[ ${#paths[@]} -gt 0 ]]; then
    tar czf "$tarball" "${paths[@]}" || return 1
  fi
  rm -rf "$varlib" || return 1
  rm -rf "$ETC" || return 1
}

print_uninstall_hint() {
  echo
  echo "Kids Mode itself is not removed yet. When ready:"
  echo "  sudo pacman -R omarchy-kids"
}

# validate_yes_word CANDIDATE — the card's own validator: only the whole
# word continues (the same token the piped path expects).
validate_yes_word() { # CANDIDATE
  [[ "$1" == "yes" ]] || {
    echo 'Type "yes" (the whole word) to continue.'
    return 1
  }
}

# confirm_or_abort — the plan is already on screen. A human at a terminal
# gets the shared card and may type the word; a script piping stdin keeps
# the plain one-line prompt (test/shell.d/remove-test.sh drives that).
confirm_or_abort() {
  local reply=""
  if [[ -t 0 ]]; then
    tui_init || true
    local rc=0
    tui_screen_input "Remove Kids Mode?" 1 1 0 "" text \
      'Type "yes" to continue; anything else cancels.' validate_yes_word || rc=$?
    if ((rc != 0)); then
      echo "omarchy-kids-remove: cancelled, nothing changed" >&2
      exit $((rc == 130 ? 130 : 1))
    fi
    reply="$TUI_REPLY"
  else
    printf 'Type "yes" to continue, anything else cancels: '
    IFS= read -r reply || true
  fi
  if [[ "$reply" != "yes" ]]; then
    echo "omarchy-kids-remove: cancelled, nothing changed" >&2
    exit 1
  fi
}

snapshot_present() { [[ "$NO_SNAPSHOT" -eq 0 ]] && command -v snapper >/dev/null 2>&1; }
# --print-number (issue #45's "print the snapshot number it created"): the
# number is the one thing a parent needs to find this snapshot again later
# (`snapper -c root undochange <number>..0`, or the Snapper GUI); everything
# else about the call is unchanged.
snapshot_take() {
  local num
  num="$(snapper -c root create --print-number -d "before Remove Kids Mode")" || return 1
  [[ -n "$num" ]] && echo "Snapper snapshot: #$num"
  return 0
}

# --- one full pass, at whichever $DRY_RUN is currently set to -----------

run_body() {
  local kids=() k line account intents="" slot=""
  while IFS= read -r k; do
    [[ -n "$k" ]] && kids+=("$k")
  done < <(kids_list "$KIDS_DIR")

  # The map and journal are also retry records. A missing profile must not
  # make a live key disappear from the removal roster.
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    account="${line#*=}"
    account="${account%%:*}"
    if [[ ! "$account" =~ ^kid-[a-z0-9-]+$ ]]; then
      report FAILED "luks-state"
      ANY_FAIL=1
      FAILED_STEPS+=("luks-state")
      return 0
    fi
    is_in "$account" "${kids[@]+"${kids[@]}"}" || kids+=("$account")
  done < <(luks_slots_kid_entries "$SLOTS_FILE")
  if ! intents="$(luks_removal_intents "$SLOTS_FILE")"; then
    report FAILED "luks-state"
    ANY_FAIL=1
    FAILED_STEPS+=("luks-state")
    return 0
  fi
  while read -r slot account; do
    [[ -n "$account" ]] || continue
    is_in "$account" "${kids[@]+"${kids[@]}"}" || kids+=("$account")
  done <<<"$intents"

  plan_one "snapshot" snapshot_present snapshot_take

  for account in "${kids[@]+"${kids[@]}"}"; do
    remove_kid "$account"
  done
  ((ANY_FAIL == 0)) || return 0

  plan_one "polkit-admin" polkit_admin_present polkit_admin_remove
  plan_one "polkit-deny" polkit_deny_present polkit_deny_remove

  local n
  for n in 2 3 4 5 6; do
    plan_one "getty:tty$n" getty_present getty_remove "$n"
  done

  plan_one "sddm-theme" sddm_theme_present sddm_theme_remove
  plan_one "portal-conf" portal_conf_present portal_conf_remove

  local lock_stack
  lock_stack="$(posture_parent_unlock_lock_stack)"
  plan_one "parent-unlock:sddm" parent_unlock_present parent_unlock_remove sddm
  plan_one "parent-unlock:$lock_stack" parent_unlock_present parent_unlock_remove "$lock_stack"

  local dir f band_token
  dir="$(chromium_dir)"
  if [[ -d "$dir" ]]; then
    for f in "$dir"/omarchy-kids-*.json; do
      [[ -e "$f" ]] || continue
      band_token="$(basename "$f")"
      band_token="${band_token#omarchy-kids-}"
      band_token="${band_token%.json}"
      plan_one "chromium-policy:$band_token" file_present file_remove "$f"
    done
  fi

  if [[ "$BOOT_MODE" == disk ]]; then
    plan_one "limine-snapshots" limine_snapshots_present limine_snapshots_remove
    plan_one "mkinitcpio-hook" mkinitcpio_dropin_present mkinitcpio_dropin_remove
  fi
  plan_one "sddm-autologin" autologin_present autologin_remove
  plan_one "units" units_present units_remove
  plan_one "parent-group" parent_group_present parent_group_remove
  plan_one "etc-and-varlib" purge_present purge_remove
}

# --- main --------------------------------------------------------------

main() {
  BOOT_MODE="$(boot_mode_get 2>/dev/null)" ||
    die "invalid or missing boot mode in machine.conf; set boot=disk or boot=portal" 1
  if [[ "$BOOT_MODE" == portal ]] && ((PARENT_PW_STDIN || ${#LUKS_DEVICE})); then
    die "LUKS options are not available in portal mode"
  fi

  if ((PARENT_PW_STDIN)) && ((!REAL_DRY_RUN)); then
    IFS= read -r PARENT_PASSWORD || die "--parent-password-stdin needs a line on stdin"
  fi

  echo "Plan:"
  DRY_RUN=1
  run_body

  if ((REAL_DRY_RUN)); then
    print_uninstall_hint
    exit 0
  fi

  ((YES)) || confirm_or_abort

  echo
  echo "Removing:"
  DRY_RUN=0
  ANY_FAIL=0
  FAILED_STEPS=()
  run_body

  echo
  if ((ANY_FAIL)); then
    echo "Summary: ${#FAILED_STEPS[@]} step(s) FAILED: ${FAILED_STEPS[*]}"
  else
    echo "Summary: every step removed or skipped, nothing failed."
  fi

  print_uninstall_hint
  ((ANY_FAIL == 0)) || exit 1
  exit 0
}

main
