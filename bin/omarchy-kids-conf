#!/bin/bash
# omarchy:summary=Read and write a kid's settings and a band's defaults
# omarchy:args=<command> [args]
# The one way to read and write every kid setting (SPEC.md R-BAND-1,
# R-BAND-2, R-BUILD-5, Appendix B/C): kid override, else band default,
# else global default. See docs/conf.md for the precedence, the
# extension keys, every env var, and why `set <kid> theme` has a real side effect.
set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
LIB="$DIR/lib"
[[ -f "$LIB/conf.sh" ]] || LIB=/usr/lib/omarchy-kids
source "$LIB/conf.sh"
# shellcheck source=lib/kids.sh
source "$LIB/kids.sh"
# shellcheck source=lib/boot-mode.sh
source "$LIB/boot-mode.sh"
# theme_apply_for/theme_reload_if_live (issue #53, docs/theming.md).
# shellcheck source=lib/theme.sh
source "$LIB/theme.sh"
# A profile change makes the kid's session manifest stale until it is rebuilt (docs/session.md).
CONF_BIN="$(readlink -f "${BASH_SOURCE[0]}")"
# shellcheck source=lib/launcher-map.sh
source "$LIB/launcher-map.sh"
# shellcheck source=lib/session-manifest.sh
source "$LIB/session-manifest.sh"

ETC="${OMARCHY_KIDS_ETC:-/etc/omarchy-kids}"
SHARE="${OMARCHY_KIDS_SHARE:-/usr/share/omarchy-kids}"
KIDS_DIR="$ETC/kids"
MACHINE_CONF="$ETC/machine.conf"
SLOTS_FILE="$ETC/luks-slots"
BANDS_TOML="$SHARE/bands/bands.toml"
PACKS_DIR="$SHARE/packs"
PYHELPER="$LIB/conf.py"

# Build rewrites this checkout-relative constant to the installed package path.
SCHEMA="$DIR/share/config/schema.toml"
SCHEMA_DATA="$("$KIDS_PY" "$PYHELPER" schema-dump "$SCHEMA")"
SCHEMA_KEYS=()
while IFS='|' read -r key _; do
  [[ -n "$key" ]] && SCHEMA_KEYS+=("$key")
done <<<"$SCHEMA_DATA"

# global_default KEY — the Appendix B global default, or exit 1.
global_default() {
  case "$1" in
    password) echo set ;;
    onboarded) echo no ;;
    apps.extra) echo "" ;;
    apps.hidden) echo "" ;;
    apps.show_missing) echo no ;;
    *) return 1 ;;
  esac
}

schema_row() { # KEY -> the validated schema row, or exit 1
  local want="$1" row key
  while IFS= read -r row; do
    key="${row%%|*}"
    [[ "$key" == "$want" ]] && {
      printf '%s\n' "$row"
      return 0
    }
  done <<<"$SCHEMA_DATA"
  return 1
}

usage() {
  cat <<EOF
Usage: $(basename "$0") <command> [args]

  get <kid> <key>          effective value: override, else band, else default
  source <kid> <key>       print override, band, or default
  set <kid> <key> <value>  write an override
  unset <kid> <key>        clear one override and inherit its default
  show <kid>                every key, its value, and where it came from
  export <kid>              every effective setting as key=value (read-only)
  import <kid> <file>       apply key=value settings, validated all-or-nothing
  reset <kid>                clear overrides except band/name/avatar/theme/password/onboarded
  bands                      list bands with their label and blurb
  band <band>                print one band's defaults
  slug <display name>        the kid- account-name slug for a display name
  machine get boot           print the trusted boot mode
  machine set boot <mode>    write the trusted boot mode (disk or portal)
  machine migrate boot       migrate package-owned legacy boot state
  machine set parent <name>  write machine.conf's parent= (issue #46: the
                              wizard's Apply step, so omarchy-kids-authd and
                              omarchy-kids-provision both have a parent to
                              check against; needs root, same as any other
                              write under /etc/omarchy-kids)
  --help                     this text

Env:
  OMARCHY_KIDS_ETC    default /etc/omarchy-kids
  OMARCHY_KIDS_SHARE  default /usr/share/omarchy-kids
EOF
}

die() {
  echo "omarchy-kids-conf: $1" >&2
  exit "${2:-2}"
}

is_valid_key() {
  schema_row "$1" >/dev/null
}

profile_file() { echo "$KIDS_DIR/$1.conf"; }

# validate_value KEY VALUE — the schema selects a fixed validator id.
validate_value() {
  local key="$1" value="$2" row type required source group label editor validator enum min max reset
  local enum_values=()
  row="$(schema_row "$key")" || die "no schema entry for '$key' (this is a bug)"
  IFS='|' read -r key type required source group label editor validator enum min max reset <<<"$row"
  IFS=',' read -r -a enum_values <<<"$enum"
  case "$validator" in
    nonempty-single-line)
      [[ -n "$value" && "$value" != *$'\n'* ]] || die "invalid value for 'name': must be non-empty, single-line text"
      ;;
    avatar-id)
      [[ "$value" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "invalid value for 'avatar': lowercase id, e.g. 'fox'"
      if [[ -d "$SHARE/avatars" ]] && compgen -G "$SHARE/avatars/*.svg" >/dev/null 2>&1; then
        [[ -f "$SHARE/avatars/$value.svg" ]] || die "invalid value for 'avatar': no such avatar '$value'"
      fi
      ;;
    band)
      is_in "$value" "${enum_values[@]}" || die "invalid value for 'band': must be one of ${enum//,/ }"
      ;;
    level)
      is_in "$value" "${enum_values[@]}" || die "invalid value for 'level': must be 1, 2, or 3"
      ;;
    web)
      is_in "$value" "${enum_values[@]}" || die "invalid value for 'web': must be garden, filtered, or none"
      ;;
    dns)
      case "$value" in
        cloudflare-family | cleanbrowsing-family) ;;
        custom:?*) ;;
        *) die "invalid value for 'dns': cloudflare-family, cleanbrowsing-family, or custom:<url>" ;;
      esac
      ;;
    minutes)
      [[ "$value" =~ ^[0-9]+$ && "$value" -ge "$min" && "$value" -le "$max" ]] || die "invalid value for '$key': integer minutes, $min-$max"
      ;;
    time)
      [[ "$value" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || die "invalid value for '$key': HH:MM, 24-hour"
      ;;
    wifi)
      is_in "$value" "${enum_values[@]}" || die "invalid value for 'wifi': must be parent or helper"
      ;;
    yes-no)
      is_in "$value" "${enum_values[@]}" || die "invalid value for '$key': must be yes or no"
      ;;
    menu)
      is_in "$value" "${enum_values[@]}" || die "invalid value for 'menu': must be trimmed or full"
      ;;
    theme-id)
      [[ "$value" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "invalid value for 'theme': lowercase id, e.g. 'tokyo-night'"
      local omarchy="${OMARCHY_PATH:-/usr/share/omarchy}" # unset under sudo (theme.sh supplies its own default)
      if [[ -d "$omarchy/themes" ]]; then
        [[ -d "$omarchy/themes/$value" ]] || die "invalid value for 'theme': no such theme '$value' under $omarchy/themes"
      fi
      ;;
    launcher-ids)
      [[ "$value" =~ ^[a-z0-9_-]+(,[a-z0-9_-]+)*$ || -z "$value" ]] || die "invalid value for '$key': comma-separated launcher ids"
      ;;
    hostnames)
      [[ "$value" =~ ^[a-z0-9.-]+(,[a-z0-9.-]+)*$ || -z "$value" ]] || die "invalid value for 'sites': comma-separated hostnames"
      ;;
    password-mode)
      is_in "$value" "${enum_values[@]}" || die "invalid value for 'password': must be set or none"
      ;;
    *)
      die "no validator for '$key' (this is a bug)"
      ;;
  esac
}

band_dump_pairs() { # BAND -> "key=value" lines, or exit 2
  "$KIDS_PY" "$PYHELPER" band-dump "$BANDS_TOML" "$1"
}

band_get() { # BAND KEY -> value, or exit 2
  "$KIDS_PY" "$PYHELPER" band-get "$BANDS_TOML" "$1" "$2"
}

pack_file() { echo "$PACKS_DIR/$1.toml"; }

pack_value() { # BAND KEY(allowlist|sites) -> comma list, or exit 2
  local band="$1" key="$2" pack
  pack="$(pack_file "$band")"
  [[ -f "$pack" ]] || die "no pack for band '$band' ($pack)"
  case "$key" in
    allowlist) "$KIDS_PY" "$PYHELPER" pack-ids "$pack" ;;
    sites) "$KIDS_PY" "$PYHELPER" pack-sites "$pack" ;;
  esac
}

# resolve KID KEY -> prints "value\tsource" (source: override|band|default),
# or exits 2 if there is truly nothing to resolve to.
resolve() {
  local kid="$1" key="$2" profile band value row type required source group label editor validator enum min max reset
  profile="$(profile_file "$kid")"
  row="$(schema_row "$key")" || die "no schema entry for '$key' (this is a bug)"
  IFS='|' read -r key type required source group label editor validator enum min max reset <<<"$row"

  if value="$(conf_get "$profile" "$key")"; then
    printf '%s\toverride\n' "$value"
    return 0
  fi

  if [[ "$required" == yes ]]; then
    die "kid '$kid' has no '$key' set and it has no default (see docs/conf.md)"
  fi

  if ! band="$(conf_get "$profile" band)"; then
    die "kid '$kid' has no band set; cannot resolve '$key'"
  fi

  case "$source" in
    band)
      value="$(band_get "$band" "$key")"
      printf '%s\tband\n' "$value"
      ;;
    pack)
      value="$(pack_value "$band" "$key")"
      printf '%s\tband\n' "$value"
      ;;
    global)
      value="$(global_default "$key")" || die "no default for '$key' (this is a bug)"
      printf '%s\tdefault\n' "$value"
      ;;
    parent-theme)
      value="$(theme_current_name)"
      [[ -n "$value" ]] || die "no default for '$key' (this is a bug)"
      printf '%s\tdefault\n' "$value"
      ;;
    *)
      die "no default for '$key' (this is a bug)"
      ;;
  esac
}

cmd_get() {
  local kid="${1:?omarchy-kids-conf get <kid> <key>}" key="${2:?omarchy-kids-conf get <kid> <key>}"
  is_valid_key "$key" || die "unknown key: '$key' (see docs/conf.md)"
  local out value
  out="$(resolve "$kid" "$key")"
  value="${out%%$'\t'*}"
  printf '%s\n' "$value"
}

cmd_source() {
  local kid="${1:?omarchy-kids-conf source <kid> <key>}" key="${2:?omarchy-kids-conf source <kid> <key>}"
  local profile row type required source group label editor validator enum min max reset
  is_valid_key "$key" || die "unknown key: '$key' (see docs/conf.md)"
  profile="$(profile_file "$kid")"
  if conf_get "$profile" "$key" >/dev/null; then
    echo override
    return 0
  fi
  row="$(schema_row "$key")"
  IFS='|' read -r key type required source group label editor validator enum min max reset <<<"$row"
  case "$source" in
    band | pack) echo band ;;
    global | parent-theme) echo default ;;
    *) die "kid '$kid' has no '$key' override or inherited value" ;;
  esac
}

cmd_set() {
  local kid="${1:?omarchy-kids-conf set <kid> <key> <value>}" key="${2:?omarchy-kids-conf set <kid> <key> <value>}"
  shift 2 || true
  local value="$*"
  is_valid_key "$key" || die "unknown key: '$key' (see docs/conf.md)"
  validate_value "$key" "$value"
  conf_set "$(profile_file "$kid")" "$key" "$value"
  # theme is the one key with a real side effect: applies to $kid's
  # $HOME as root, best-effort -- omarchy-kids-assert retries on failure
  # (issue #53, docs/theming.md).
  if [[ "$key" == theme ]]; then
    if theme_apply_for "$kid" "$value"; then
      theme_reload_if_live "$kid"
    else
      echo "omarchy-kids-conf: wrote the 'theme' override for '$kid' but could not apply it to disk yet (see stderr above) -- omarchy-kids-assert will retry" >&2
    fi
  fi
  manifest_follow_profile "$kid"
  echo "$kid: $key=$value"
}

cmd_unset() {
  local kid="${1:?omarchy-kids-conf unset <kid> <key>}" key="${2:?omarchy-kids-conf unset <kid> <key>}"
  local profile row type required source group label editor validator enum min max reset
  local parent_home inherited_theme
  is_valid_key "$key" || die "unknown key: '$key' (see docs/conf.md)"
  profile="$(profile_file "$kid")"
  [[ -e "$profile" ]] || die "kid '$kid' has no profile ($profile)"
  row="$(schema_row "$key")"
  IFS='|' read -r key type required source group label editor validator enum min max reset <<<"$row"
  [[ "$source" != none ]] || die "cannot unset required key '$key': it has no inherited value"

  if [[ "$key" == theme ]]; then
    parent_home="$(parent_home_dir "$MACHINE_CONF")" || die "cannot unset theme: no parent is recorded"
    inherited_theme="$(THEME_KIDS_HOME="$parent_home" theme_current_name)"
    [[ -n "$inherited_theme" ]] || die "cannot unset theme: the parent has no current theme"
    validate_value theme "$inherited_theme"
    theme_apply_for "$kid" "$inherited_theme" || die "could not apply inherited theme '$inherited_theme' for '$kid'"
  fi

  conf_del "$profile" "$key"
  [[ "$key" != theme ]] || theme_reload_if_live "$kid"
  manifest_follow_profile "$kid"
  echo "$kid: $key inherits its default"
}

# manifest_follow_profile KID -- on a provisioned box the manifest must match the profile, or the
# kid's next login fails closed (R-MANIFEST-4). Best-effort: assert rebuilds it too.
manifest_follow_profile() {
  [[ -d "$(session_manifest_dir)" ]] || return 0
  session_manifest_build "$1" ||
    echo "omarchy-kids-conf: could not rebuild the session manifest for '$1' (see stderr above) -- omarchy-kids-assert will" >&2
}

cmd_show() {
  local kid="${1:?omarchy-kids-conf show <kid>}" key out value source
  printf '%-20s %-30s %s\n' KEY VALUE SOURCE
  for key in "${SCHEMA_KEYS[@]}"; do
    out="$(resolve "$kid" "$key")"
    value="${out%%$'\t'*}"
    source="${out##*$'\t'}"
    printf '%-20s %-30s %s\n' "$key" "$value" "$source"
  done
}

# cmd_export KID — the kid's own overrides, one key=value per line, plus
# inherited values as comments. A round trip therefore re-applies only what
# was overridden, instead of pinning every inherited value. Read-only: the
# password hash lives in shadow, not here.
cmd_export() {
  local kid="${1:?omarchy-kids-conf export <kid>}" key profile value out lines
  profile="$(profile_file "$kid")"
  [[ -e "$profile" ]] || die "kid '$kid' has no profile ($profile)"
  lines="# omarchy-kids-conf export for $kid"$'\n'
  for key in "${SCHEMA_KEYS[@]}"; do
    # password/onboarded are system-managed markers, not parent settings.
    case "$key" in password | onboarded) continue ;; esac
    if value="$(conf_get "$profile" "$key")"; then
      lines+="$key=$value"$'\n'
    else
      out="$(resolve "$kid" "$key")"
      value="${out%%$'\t'*}"
      lines+="# $key=$value (inherited)"$'\n'
    fi
  done
  printf '%s' "$lines"
}

# cmd_import KID FILE — apply the overrides in FILE. Every line is
# validated before anything is written, then the profile is replaced in
# one mv: a bad file, or a failure mid-write, leaves the profile untouched.
cmd_import() {
  local kid="${1:?omarchy-kids-conf import <kid> <file>}" file="${2:?omarchy-kids-conf import <kid> <file>}"
  [[ -f "$file" && ! -L "$file" ]] ||
    die "import: '$file' must be a regular file (not a symlink or a pipe)"
  local profile tmp
  profile="$(profile_file "$kid")"
  [[ -e "$profile" ]] || die "kid '$kid' has no profile ($profile)"
  local -a keys=() values=()
  local lineno=0 line key value err seen=$'\n'
  while IFS= read -r line || [[ -n "$line" ]]; do
    lineno=$((lineno + 1))
    line="${line%$'\r'}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    [[ "$line" == *=* ]] || die "import: line $lineno is not key=value"
    key="${line%%=*}"
    value="${line#*=}"
    is_valid_key "$key" || die "import: line $lineno: unknown key '$key'"
    case "$key" in
      password | onboarded) die "import: line $lineno: '$key' is system-managed" ;;
    esac
    [[ "$seen" != *$'\n'"$key"$'\n'* ]] || die "import: line $lineno: duplicate key '$key'"
    seen+="$key"$'\n'
    if ! err="$(validate_value "$key" "$value" 2>&1)"; then
      die "import: line $lineno: invalid value for '$key': ${err#omarchy-kids-conf: }"
    fi
    keys+=("$key")
    values+=("$value")
  done <"$file"
  ((${#keys[@]})) || die "import: '$file' has no settings"
  local i theme_value=""
  tmp="$(mktemp "$(dirname "$profile")/.import.XXXXXX")" || die "import: cannot create a scratch profile"
  if ! cp -p "$profile" "$tmp"; then
    rm -f "$tmp"
    die "import: cannot copy the profile (nothing changed)"
  fi
  for ((i = 0; i < ${#keys[@]}; i++)); do
    if ! conf_set "$tmp" "${keys[$i]}" "${values[$i]}"; then
      rm -f "$tmp"
      die "import: failed writing '${keys[$i]}' (nothing changed)"
    fi
    [[ "${keys[$i]}" != theme ]] || theme_value="${values[$i]}"
  done
  if ! mv -f "$tmp" "$profile"; then
    rm -f "$tmp"
    die "import: could not replace the profile (nothing changed)"
  fi
  # Side effects once, after the profile is in place; a theme apply failure
  # is reported but does not undo the import (same rule as `set`).
  if [[ -n "$theme_value" ]]; then
    theme_apply_for "$kid" "$theme_value" || echo "omarchy-kids-conf: imported the 'theme' override but could not apply it to disk yet -- omarchy-kids-assert will retry" >&2
    theme_reload_if_live "$kid"
  fi
  manifest_follow_profile "$kid"
  printf 'omarchy-kids-conf: imported %d setting(s) for %s\n' "${#keys[@]}" "$kid"
}

cmd_reset() {
  local kid="${1:?omarchy-kids-conf reset <kid>}" profile key
  profile="$(profile_file "$kid")"
  [[ -e "$profile" ]] || die "kid '$kid' has no profile ($profile)"
  for key in "${SCHEMA_KEYS[@]}"; do
    local row type required source group label editor validator enum min max reset
    row="$(schema_row "$key")"
    # shellcheck disable=SC2034 # positional fields keep the schema row aligned
    IFS='|' read -r key type required source group label editor validator enum min max reset <<<"$row"
    [[ "$reset" == keep ]] && continue
    conf_del "$profile" "$key"
  done
  manifest_follow_profile "$kid"
  echo "$kid: reset to band defaults"
}

cmd_bands() {
  "$KIDS_PY" "$PYHELPER" band-list "$BANDS_TOML" | while IFS=$'\t' read -r band label blurb; do
    printf '%-8s %-14s %s\n' "$band" "$label" "$blurb"
  done
}

cmd_band() {
  local band="${1:?omarchy-kids-conf band <band>}"
  is_in "$band" "${VALID_BANDS[@]}" || die "unknown band: '$band' (must be one of ${VALID_BANDS[*]})"
  band_dump_pairs "$band"
}

cmd_slug() {
  [[ $# -ge 1 ]] || die "omarchy-kids-conf slug <display name>"
  "$KIDS_PY" "$PYHELPER" slug "$@"
}

boot_migration_kids_dir() {
  printf '%s/kids\n' "$(dirname "$BOOT_MODE_MACHINE_CONF")"
}

boot_migration_legacy_dropin() {
  printf '%s/mkinitcpio.conf.d/omarchy_kids.conf\n' "$(dirname "$(dirname "$BOOT_MODE_MACHINE_CONF")")"
}

boot_migration_copy() {
  printf '%s/legacy-boot.conf\n' "$(dirname "$BOOT_MODE_LOCK")"
}

boot_migration_evidence() {
  local copy
  copy="$(boot_migration_copy)"
  [[ -f "$copy" && ! -L "$copy" ]] || return 1
  grep -qF 'omarchy-kids-unlock' "$copy"
}

boot_migration_has_parent() {
  awk -F= '$1 == "parent" && $2 != "" { found=1 } END { exit !found }' \
    "$BOOT_MODE_MACHINE_CONF" 2>/dev/null
}

boot_migration_has_kid() {
  find "$(boot_migration_kids_dir)" -maxdepth 1 -type f -name '*.conf' -print -quit 2>/dev/null | grep -q .
}

boot_migration_root_is_luks() {
  local root_source
  root_source="$(findmnt -no SOURCE / 2>/dev/null)" || return 1
  case "$root_source" in
    /dev/mapper/*)
      command -v cryptsetup >/dev/null 2>&1 || return 1
      cryptsetup status "${root_source#/dev/mapper/}" >/dev/null 2>&1
      ;;
    *)
      command -v lsblk >/dev/null 2>&1 || return 1
      lsblk -sno FSTYPE "$root_source" 2>/dev/null | grep -qx crypto_LUKS
      ;;
  esac
}

boot_migration_restore() {
  local copy dropin
  copy="$(boot_migration_copy)"
  dropin="$(boot_migration_legacy_dropin)"
  install -d -m 0755 "$(dirname "$dropin")" || return 1
  install -m 0644 "$copy" "$dropin" || return 1
  rm -f "$copy"
}

boot_migration_converge() {
  local mode="$1" copy
  copy="$(boot_migration_copy)"
  if [[ "$mode" == disk ]] && boot_migration_evidence; then
    boot_migration_restore
  else
    rm -f "$copy"
  fi
}

boot_migration_run() {
  local mode
  if mode="$(boot_mode_get 2>/dev/null)"; then
    boot_migration_converge "$mode"
    return
  fi

  mode=portal
  if boot_migration_has_parent && boot_migration_has_kid && boot_migration_root_is_luks &&
    boot_migration_evidence; then
    mode=disk
  fi
  boot_mode_set "$mode" || return 1
  [[ "$(boot_mode_get 2>/dev/null || true)" == "$mode" ]] || return 1
  boot_migration_converge "$mode"
}

# cmd_machine — machine.conf's trusted boot setting and parent key. The boot
# setter is separate from artifact transitions; package migration owns its
# legacy artifact convergence as one locked operation.
# Also makes sure the parent's own LUKS slot is recorded (docs/boot.md
# step 5): without a "0=<parent>" line in luks-slots, a boot unlocked with
# the parent's own disk password lands on the portal instead of their
# desktop -- true on a fresh install and every time after "Remove Kids
# Mode", since nothing else in this repo ever writes that line.
cmd_machine() {
  [[ $# -ge 1 ]] || die "usage: omarchy-kids-conf machine get|set|migrate ..."
  local sub="$1"
  shift
  case "$sub" in
    get)
      [[ $# -eq 1 && "$1" == boot ]] || die "usage: omarchy-kids-conf machine get boot"
      boot_mode_get || exit 1
      ;;
    set)
      [[ $# -ge 1 ]] || die "usage: omarchy-kids-conf machine set <key> <value>"
      local key="$1"
      shift
      local value="$*"
      case "$key" in
        boot)
          [[ $# -eq 1 ]] || die "usage: omarchy-kids-conf machine set boot <disk|portal>"
          boot_mode_valid "$value" || die "invalid value for 'boot': must be disk or portal"
          is_root || die "setting machine boot mode requires root" 1
          boot_mode_lock_acquire || die "could not acquire the boot-mode transition lock" 1
          trap boot_mode_lock_release EXIT
          boot_mode_set "$value" || exit $?
          ;;
        parent)
          [[ -n "$value" && "$value" != *$'\n'* ]] || die "invalid value for 'parent': must be non-empty, single-line text"
          conf_set "$MACHINE_CONF" "$key" "$value"
          luks_slots_record_parent "$SLOTS_FILE" "$KIDS_DIR" "$value" || die "could not record the parent's LUKS slot (see stderr above)"
          ;;
        *) die "unknown machine key: '$key' (only 'boot' and 'parent' are supported)" ;;
      esac
      echo "machine: $key=$value"
      ;;
    migrate)
      [[ $# -eq 1 && "$1" == boot ]] || die "usage: omarchy-kids-conf machine migrate boot"
      is_root || die "migrating machine boot mode requires root" 1
      boot_mode_lock_acquire || die "could not acquire the boot-mode transition lock" 1
      trap boot_mode_lock_release EXIT
      boot_migration_run || exit $?
      echo "machine: boot=$(boot_mode_get)"
      ;;
    *) die "unknown machine subcommand: '$sub' (see --help)" ;;
  esac
}

main() {
  [[ $# -ge 1 ]] || {
    usage >&2
    exit 2
  }
  local cmd="$1"
  case "$cmd" in
    -h | --help)
      usage
      exit 0
      ;;
    get)
      shift
      cmd_get "$@"
      ;;
    source)
      shift
      cmd_source "$@"
      ;;
    set)
      shift
      cmd_set "$@"
      ;;
    unset)
      shift
      cmd_unset "$@"
      ;;
    show)
      shift
      cmd_show "$@"
      ;;
    export)
      shift
      cmd_export "$@"
      ;;
    import)
      shift
      cmd_import "$@"
      ;;
    reset)
      shift
      cmd_reset "$@"
      ;;
    bands)
      shift
      cmd_bands "$@"
      ;;
    band)
      shift
      cmd_band "$@"
      ;;
    slug)
      shift
      cmd_slug "$@"
      ;;
    machine)
      shift
      cmd_machine "$@"
      ;;
    *) die "unknown command: '$cmd' (see --help)" ;;
  esac
}

main "$@"
