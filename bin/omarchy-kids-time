#!/bin/bash
# omarchy:summary=Read root-published screen-time status for this kid, or grant minutes (root)
# omarchy:args=<daemon|status|grant> ...
# The kid-side display adapter reads root state; grant remains a root-only parent action.
# See docs/time.md for the trust boundary and compatibility behavior.
set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
LIB="$DIR/lib"
[[ -f "$LIB/time.sh" ]] || LIB=/usr/lib/omarchy-kids
# shellcheck source=lib/kids.sh
source "$LIB/kids.sh"
CONF_BIN="$(kids_bin conf "$DIR")"
ETC=/etc/omarchy-kids
SHARE=/usr/share/omarchy-kids
SYSROOT=""
RUN="/run/user/$(id -u)/omarchy-kids"
QUICKSHELL_BIN=/usr/bin/quickshell
export OMARCHY_KIDS_ETC="$ETC" OMARCHY_KIDS_SHARE="$SHARE"
# shellcheck source=lib/time.sh
source "$LIB/time.sh"
TIME_SYSROOT="$SYSROOT"
TIME_VARLIB="$TIME_SYSROOT/var/lib/omarchy-kids"
TIME_NOW_FILE="$SYSROOT/run/omarchy-kids/time/now"
TOAST_QML="$SHARE/time/toast.qml"
TIMESUP_QML="$SHARE/time/timesup.qml"
TOAST_PIDFILE="$RUN/toast.pid"
TIMESUP_PIDFILE="$RUN/timesup.pid"
POLL_INTERVAL="${OMARCHY_KIDS_TIME_POLL_INTERVAL:-30}"

die() {
  echo "omarchy-kids-time: $1" >&2
  exit "${2:-2}"
}

usage() {
  cat <<'EOF'
Usage: omarchy-kids-time daemon
       omarchy-kids-time status [<kid>]
       omarchy-kids-time grant <kid> <minutes>

daemon        Run this session's screen-time warnings/enforcement loop
              until the session ends (SPEC.md R-TIME-3, R-TIME-4).
              Started once, detached, by omarchy-kids-session-start.
status        Print <kid>'s minutes used, minutes left, and next
              boundary today (default <kid>: this account).
grant         Add <minutes> to <kid>'s budget for today only. Root only.

  -h, --help  Show this help and exit.
EOF
}

mkdir -p "$RUN" 2>/dev/null || true
LOG_FILE="$RUN/session-$(id -u).log"
log() { printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*" >>"$LOG_FILE" 2>/dev/null || true; }

# --- status ----------------------------------------------------------------

cmd_status() {
  local kid="${1:-$(id -un)}" file now hm day weekend used granted budget remaining kind at
  now="$(time_root_now)"
  hm="$(time_hm "$now")"
  IFS=$'\t' read -r day weekend <<<"$(time_logical_day "$now")" || die "could not compute today's logical day"
  used="$(time_used_minutes "$kid" "$day")"
  granted="$(time_granted_minutes "$kid" "$day")"
  budget="$(time_budget_minutes "$kid" "$weekend")" || die "no budget configured for '$kid'"
  file="$(time_state_file "$kid")"
  if time_state_read "$file" && [[ "$(jq -r '.logical_day' "$file")" == "$day" ]]; then
    remaining="$(jq -r '.remaining_seconds / 60 | floor' "$file")"
    read -r kind at <<<"$(time_state_boundary "$file")"
  else
    remaining="$(time_remaining_minutes "$kid" "$day" "$weekend")"
    read -r kind at <<<"$(time_next_boundary "$kid" "$day" "$weekend" "$hm")"
  fi
  printf '%s: %d min used, %d min left today (budget %d' "$kid" "$used" "$remaining" "$budget"
  ((granted > 0)) && printf ' + %d granted' "$granted"
  printf ')\n'
  if [[ "$kind" == lights-out ]]; then
    printf 'lights-out at %s\n' "$at"
  else
    printf 'budget runs out at %s\n' "$at"
  fi
  if time_is_paused "$kid"; then
    printf 'paused: time is not counting for %s right now\n' "$kid"
  fi
}

# --- grant -------------------------------------------------------------

cmd_grant() {
  local kid="${1:-}" minutes="${2:-}" now day weekend
  [[ -n "$kid" && -n "$minutes" ]] || die "grant: needs <kid> <minutes> (see --help)"
  [[ "$minutes" =~ ^[0-9]+$ && "$minutes" -gt 0 ]] || die "grant: <minutes> must be a positive integer, got '$minutes'"
  if ! is_root; then
    die "grant: must run as root (a parent action, R-TIME-4 -- see docs/time.md)" 1
  fi
  now="$(time_root_now)"
  IFS=$'\t' read -r day weekend <<<"$(time_logical_day "$now")" || die "could not compute today's logical day"
  time_grant_add "$kid" "$day" "$minutes"
  printf '%s: granted %d more minute(s) for today (now %d granted today)\n' \
    "$kid" "$minutes" "$(time_granted_minutes "$kid" "$day")"
}

# --- daemon ----------------------------------------------------------------

# The overlays are tracked by lib/kids.sh's pidfile pair, not `pgrep -f`.
show_toast() {
  local text="$1"
  modal_already_open "$TOAST_PIDFILE" && return 0
  install -d -m 0700 "$RUN"
  OMARCHY_KIDS_TOAST_TEXT="$text" "$QUICKSHELL_BIN" -p "$TOAST_QML" >/dev/null 2>&1 &
  modal_write_pid "$TOAST_PIDFILE" "$!"
  disown 2>/dev/null || true
  log "toast: $text"
}

show_timesup() {
  modal_already_open "$TIMESUP_PIDFILE" && return 0
  local kid name avatar_id
  kid="$(id -un)"
  name="$("$CONF_BIN" get "$kid" name 2>/dev/null || echo "$kid")"
  avatar_id="$("$CONF_BIN" get "$kid" avatar 2>/dev/null || echo owl)" # the owl when a kid has none (docs/parent-card.md)
  install -d -m 0700 "$RUN"
  OMARCHY_KIDS_ACCOUNT="$kid" OMARCHY_KIDS_NAME="$name" \
    OMARCHY_KIDS_AVATAR="$SHARE/avatars/$avatar_id.svg" \
    "$QUICKSHELL_BIN" -p "$TIMESUP_QML" >/dev/null 2>&1 &
  modal_write_pid "$TIMESUP_PIDFILE" "$!"
  disown 2>/dev/null || true
  log "time's up shown for '$kid'"
}

dismiss_timesup() {
  modal_already_open "$TIMESUP_PIDFILE" || return 0
  modal_close "$TIMESUP_PIDFILE"
  log "time's up dismissed (more time granted)"
}

# warning_label THRESHOLD — text for a root-published warning threshold.
warning_label() {
  local t="$1"
  if [[ "$t" == 1 ]]; then printf '1 minute left\n'; else printf '%s minutes left\n' "$t"; fi
}

cmd_daemon() {
  local kid state_file state fired="" last_fired="" warning
  kid="$(id -un)"

  while true; do
    state_file="$(time_state_file "$kid")"
    if time_state_read "$state_file"; then
      state="$(jq -r '.state' "$state_file")"
      fired="$(jq -r '.warnings_fired | map(tostring) | join(" ")' "$state_file")"
      case "$state" in
        warning)
          dismiss_timesup
          if [[ "$fired" != "$last_fired" && -n "$fired" ]]; then
            warning="${fired##* }"
            show_toast "$(warning_label "$warning")"
          fi
          last_fired="$fired"
          ;;
        grace | finishing)
          show_timesup
          last_fired="$fired"
          ;;
        allowed)
          dismiss_timesup
          last_fired="$fired"
          ;;
      esac
    else
      last_fired=""
    fi

    if [[ "${OMARCHY_KIDS_TIME_DAEMON_ONESHOT:-0}" == "1" ]]; then
      return 0
    fi
    sleep "$POLL_INTERVAL"
  done
}

# --- dispatch ----------------------------------------------------------

[[ $# -ge 1 ]] || {
  usage >&2
  exit 2
}
case "$1" in
  -h | --help)
    usage
    exit 0
    ;;
  daemon)
    shift
    cmd_daemon "$@"
    ;;
  status)
    shift
    cmd_status "$@"
    ;;
  grant)
    shift
    cmd_grant "$@"
    ;;
  *) die "unknown command '$1' (see --help)" ;;
esac
