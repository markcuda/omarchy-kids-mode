#!/bin/bash
# omarchy:summary=Show the fail-closed "Ask a grown-up" screen before a kid's desktop starts
# omarchy:hidden=true
# Shown by omarchy-kids-session (SPEC.md R-DESK-2) when a fail-closed
# check fails -- a tty message, not a modal, since Hyprland hasn't
# started yet. See docs/session.md for why this is a placeholder.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: omarchy-kids-blocked "<check name>"

Prints a full-screen "Ask a grown-up" message naming the failed check
(SPEC.md R-DESK-2), then holds it on screen for a while and exits.
Placeholder for the real graphical modal -- see docs/session.md.

  -h, --help  Show this help and exit.

Env:
  OMARCHY_KIDS_BLOCKED_SLEEP  seconds to hold the message (default 15)
EOF
}

for arg in "$@"; do
  case "$arg" in
    -h | --help)
      usage
      exit 0
      ;;
  esac
done

CHECK_NAME="${1:-a check}"
SLEEP_SECS="${OMARCHY_KIDS_BLOCKED_SLEEP:-15}"

MESSAGE="Ask a grown-up

Something isn't set up right yet, so this desktop can't start safely.

Check that failed: $CHECK_NAME

Find a grown-up. They can run 'omarchy-kids-check' to see what's wrong."

# Actually attempt the write rather than `[[ -w /dev/tty ]]` first -- the
# permission-bit check can lie (docs/session.md).
OUT=""
if { : >/dev/tty; } 2>/dev/null; then
  OUT=/dev/tty
fi

if [[ -n "$OUT" ]]; then
  if command -v gum >/dev/null 2>&1; then
    gum style \
      --border double \
      --align center \
      --width 60 \
      --margin "2 4" \
      --padding "2 4" \
      --foreground 212 --border-foreground 212 \
      "$MESSAGE" >"$OUT" 2>/dev/null || printf '%s\n' "$MESSAGE" >"$OUT"
  else
    printf '%s\n' "$MESSAGE" >"$OUT"
  fi
elif command -v gum >/dev/null 2>&1; then
  gum style \
    --border double \
    --align center \
    --width 60 \
    --margin "2 4" \
    --padding "2 4" \
    --foreground 212 --border-foreground 212 \
    "$MESSAGE"
else
  printf '%s\n' "======================================================"
  printf '%s\n' "$MESSAGE"
  printf '%s\n' "======================================================"
fi

sleep "$SLEEP_SECS"
exit 1
